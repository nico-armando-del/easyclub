---
/*
  LE GABARIT DE TOUTES LES PAGES.

  Le <head> SEO complet (title, description, canonical, Open Graph, Twitter),
  un seul bloc JSON-LD en @graph : Organization et WebSite reliés par @id, la
  WebPage, le fil d'Ariane, la FAQ et l'article quand il y en a. La FAQ du
  JSON-LD et la FAQ visible viennent de la MÊME donnée : elles ne peuvent pas
  diverger.
*/
import fs from 'node:fs'
import '../styles/global.css'
import Sprite from '../components/Sprite.astro'
import EnTete from '../components/EnTete.astro'
import PiedDePage from '../components/PiedDePage.astro'
import BoutonDemoFixe from '../components/BoutonDemoFixe.astro'
import Consentement from '../components/Consentement.astro'
import { SITE, NOM, EMAIL } from '../data/site'
import { i18n, LOCALE, OG_LOCALE } from '../i18n/ui'
import { jumelles } from '../i18n/liens'

export type Etape = { nom: string; url: string }
export type Question = { question: string; reponse: string }

interface Props {
  titre: string
  description: string
  chemin: string
  fil?: Etape[]
  faq?: Question[]
  article?: { titre: string; publie: Date; maj: Date }
  image?: string
  imageAlt?: string
  /** Obsolète : les hreflang se calculent seuls (page jumelle, et /en pour l'accueil). */
  langues?: boolean
  sansBoutonFixe?: boolean
  noindex?: boolean
  /** Fond de la page : papier (défaut) ou blanc (pages éditoriales). L'en-tête prend le même. */
  fond?: 'papier' | 'blanc'
}

const {
  titre, description, chemin, fil, faq, article,
  image: imageDonnee, imageAlt: imageAltDonne,
  sansBoutonFixe = false, noindex = false, fond = 'papier',
} = Astro.props
/*
  L'IMAGE DE PARTAGE. Chaque page a la sienne dans public/og/ (titre, photo,
  couleurs du site), dessinée par scripts/og.mjs ; sinon le logo.
*/
const imageCarte = `/og/${chemin === '/' ? 'index' : chemin.replace(/^\//, '')}.jpg`
const aSaCarte = !imageDonnee && fs.existsSync(`public${imageCarte}`)
const image = imageDonnee ?? (aSaCarte ? imageCarte : '/img/og.jpg')
const imageAlt = imageAltDonne ?? (aSaCarte ? titre : 'Le logo OnClub sur fond menthe')
const { langue, t, lien } = i18n(Astro.url)
const imageAltLangue = imageAlt === 'Le logo OnClub sur fond menthe' ? t(imageAlt) : imageAlt

/*
  LES DEUX LANGUES. Une page a une jumelle quand l'autre version existe
  (src/i18n/liens.ts) : hreflang fr, es et x-default (= le français), les
  mêmes sur les deux pages (réciprocité vérifiée par scripts/controle_seo.py).
  L'accueil garde en plus /en.
*/
const paire = jumelles(chemin)
const accueil = paire.fr === '/'
const alternes: { lang: string; href: string }[] = paire.es
  ? [
      { lang: 'fr', href: paire.fr },
      ...(accueil ? [{ lang: 'en', href: '/en' }] : []),
      { lang: 'es', href: paire.es },
      { lang: 'x-default', href: paire.fr },
    ]
  : []
const absolu = (c: string) => (c === '/' ? `${SITE}/` : `${SITE}${c}`)
const inLanguage = LOCALE[langue]

const adresse = chemin === '/' ? `${SITE}/` : `${SITE}${chemin}`
const imageAbs = image.startsWith('http') ? image : `${SITE}${image}`
const ORG = `${SITE}/#organisation`
const WEB = `${SITE}/#site`

const graphe: Record<string, unknown>[] = [
  {
    '@type': 'Organization', '@id': ORG, name: NOM, url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/img/logo-512.png`, width: 512, height: 512 },
    email: EMAIL,
    description: t('Plateforme française pour les associations qui inscrivent des adhérents : inscriptions en ligne, cotisations, relances, saisons, site et boutique.'),
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: EMAIL, availableLanguage: ['fr'] },
  },
  { '@type': 'WebSite', '@id': WEB, url: `${SITE}/`, name: NOM, inLanguage: ['fr-FR', 'es-ES', 'en'], publisher: { '@id': ORG } },
  {
    '@type': 'WebPage', '@id': `${adresse}#page`, url: adresse, name: titre, description,
    inLanguage, isPartOf: { '@id': WEB }, about: { '@id': ORG },
    ...(fil ? { breadcrumb: { '@id': `${adresse}#fil` } } : {}),
  },
]
if (fil) {
  const etapes = [{ nom: t('Accueil'), url: lien('/') }, ...fil]
  graphe.push({
    '@type': 'BreadcrumbList', '@id': `${adresse}#fil`,
    itemListElement: etapes.map((e, i) => ({
      '@type': 'ListItem', position: i + 1, name: e.nom, item: e.url === '/' ? `${SITE}/` : `${SITE}${e.url}`,
    })),
  })
}
if (faq?.length) {
  graphe.push({
    '@type': 'FAQPage', '@id': `${adresse}#faq`,
    mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })),
  })
}
if (article) {
  graphe.push({
    '@type': 'BlogPosting', '@id': `${adresse}#article`, headline: article.titre, description,
    datePublished: article.publie.toISOString().slice(0, 10), dateModified: article.maj.toISOString().slice(0, 10),
    inLanguage, image: imageAbs, mainEntityOfPage: adresse,
    author: { '@id': ORG }, publisher: { '@id': ORG },
  })
}
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graphe }).replace(/</g, '\\u003c')
---
<!doctype html>
<html lang={langue}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titre}</title>
<meta name="description" content={description}>
<link rel="canonical" href={adresse}>
{noindex && <meta name="robots" content="noindex">}
{alternes.map((a) => <link rel="alternate" hreflang={a.lang} href={absolu(a.href)}>)}
<link rel="preload" href="/polices/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/polices/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#5DE88F">
<link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/img/favicon.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:site_name" content={NOM}>
<meta property="og:locale" content={OG_LOCALE[langue]}>
{paire.es && <meta property="og:locale:alternate" content={OG_LOCALE[langue === 'fr' ? 'es' : 'fr']}>}
<meta property="og:title" content={titre}>
<meta property="og:description" content={description}>
<meta property="og:url" content={adresse}>
<meta property="og:image" content={imageAbs}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imageAltLangue}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={titre}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={imageAbs}>
<meta name="twitter:image:alt" content={imageAltLangue}>
<script type="application/ld+json" set:html={jsonld} />
<script is:inline>document.documentElement.classList.add('js')</script>
<slot name="tete" />
</head>
<body data-fond={fond}>
<Sprite />
<a class="saut" href="#contenu">{t('Aller au contenu')}</a>
<EnTete chemin={chemin} fond={fond} />
<main id="contenu">
  <slot />
</main>
<PiedDePage chemin={chemin} />
{!sansBoutonFixe && <BoutonDemoFixe />}
<Consentement />
<script is:inline src="/js/site.js" defer></script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script>
  /*
    L'OBSERVATEUR PARTAGÉ (un seul pour toute la page, sans minuterie ni écouteur de défilement) :
    - [data-vu] reçoit .vu une fois, quand 35 % de l'élément entre à l'écran (apparitions jouées une fois) ;
    - [data-champ] reçoit .hors-champ tant qu'il est hors de l'écran (pause d'une animation qu'on ne voit pas).
    Les composants ajoutés plus tard (onglets, scène) sont pris par l'événement « onclub:observer ».
  */
  const vus = new IntersectionObserver((entrees) => {
    for (const e of entrees) if (e.isIntersecting) { e.target.classList.add('vu'); vus.unobserve(e.target) }
  }, { threshold: 0.35 })
  const champ = new IntersectionObserver((entrees) => {
    for (const e of entrees) e.target.classList.toggle('hors-champ', !e.isIntersecting)
  })
  const observer = (racine: ParentNode = document) => {
    racine.querySelectorAll('[data-vu]:not(.vu)').forEach((el) => vus.observe(el))
    racine.querySelectorAll('[data-champ]').forEach((el) => champ.observe(el))
  }
  observer()
  document.addEventListener('onclub:observer', () => observer())
</script>
</body>
</html>
