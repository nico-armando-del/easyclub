---
/*
  LE GABARIT DES ACCUEILS TRADUITS (/en, /es).

  Même <head> SEO que Layout.astro (title, description, canonical, Open Graph,
  Twitter, un seul JSON-LD en @graph), mais dans la langue de la page : lang,
  og:locale (+ og:locale:alternate), inLanguage et descriptions traduits.
  Les hreflang sont EXACTEMENT ceux de l'accueil français (fr, en, es,
  x-default → /) : le contrôle SEO exige qu'ils soient réciproques.

  En-tête, pied de page, bouton de démo fixe et bandeau de consentement sont
  traduits ici ; ils gardent les classes et attributs que public/js/site.js
  attend (details.menu-tel, data-consentement*, data-demo-fixe), pour que le
  consentement, la ville et les menus fonctionnent sans autre script.
  Tout lien vers une page française porte hreflang="fr" et l'étiquette FR.
*/
import '../styles/global.css'
import Sprite from '../components/Sprite.astro'
import VersFr from '../components/langue/VersFr.astro'
import { SITE, NOM, EMAIL, lienWhatsApp } from '../data/site'
import type { Textes, Langue } from '../i18n/accueil'

interface Props { l: Textes; langue: Langue; faq: { question: string; reponse: string }[] }
const { l, langue, faq } = Astro.props

const chemin = `/${langue}`
const adresse = `${SITE}${chemin}`
const image = `${SITE}/img/og.jpg`
const ORG = `${SITE}/#organisation`
const WEB = `${SITE}/#site`

const graphe = [
  {
    '@type': 'Organization', '@id': ORG, name: NOM, url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/img/logo-512.png`, width: 512, height: 512 },
    email: EMAIL, description: l.orgDescription,
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: EMAIL, availableLanguage: ['fr'] },
  },
  { '@type': 'WebSite', '@id': WEB, url: `${SITE}/`, name: NOM, inLanguage: ['fr-FR', 'en', 'es'], publisher: { '@id': ORG } },
  {
    '@type': 'WebPage', '@id': `${adresse}#page`, url: adresse, name: l.titre, description: l.description,
    inLanguage: l.inLanguage, isPartOf: { '@id': WEB }, about: { '@id': ORG },
  },
  {
    '@type': 'FAQPage', '@id': `${adresse}#faq`, inLanguage: l.inLanguage,
    mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })),
  },
]
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graphe }).replace(/</g, '\\u003c')
const LANGUES = [
  { code: 'fr', nom: 'Français', href: '/' },
  { code: 'en', nom: 'English', href: '/en' },
  { code: 'es', nom: 'Español', href: '/es' },
]
const ancres = [
  { href: '#fonctionnalites', nom: l.nav.fonctions },
  { href: '#temps', nom: l.nav.temps },
  { href: '#offres', nom: l.nav.offres },
  { href: '#questions', nom: l.nav.faq },
]
const annee = new Date().getFullYear()
---
<!doctype html>
<html lang={l.html}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{l.titre}</title>
<meta name="description" content={l.description}>
<link rel="canonical" href={adresse}>
<link rel="alternate" hreflang="fr" href={`${SITE}/`}>
<link rel="alternate" hreflang="en" href={`${SITE}/en`}>
<link rel="alternate" hreflang="es" href={`${SITE}/es`}>
<link rel="alternate" hreflang="x-default" href={`${SITE}/`}>
<link rel="preload" href="/polices/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/polices/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#5DE88F">
<link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/img/favicon.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content={NOM}>
<meta property="og:locale" content={l.ogLocale}>
{l.ogAlternate.map((a) => <meta property="og:locale:alternate" content={a}>)}
<meta property="og:title" content={l.titre}>
<meta property="og:description" content={l.description}>
<meta property="og:url" content={adresse}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={l.imageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={l.titre}>
<meta name="twitter:description" content={l.description}>
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={l.imageAlt}>
<script type="application/ld+json" set:html={jsonld} />
<script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
<Sprite />
<a class="saut" href="#contenu">{l.saut}</a>

<header class="entete">
  <div class="enveloppe entete-barre">
    <a class="marque" href={chemin} aria-label={l.marqueAria}><svg aria-hidden="true"><use href="#boucle"/></svg>OnClub</a>
    <nav class="nav" aria-label={l.nav.aria}>
      {ancres.map((a) => <a href={a.href}>{a.nom}</a>)}
      <span class="langues" role="group" aria-label={l.nav.langues}>
        {LANGUES.map((x) => x.code === langue
          ? <span class="langue-active" lang={x.code} aria-current="page">{x.code.toUpperCase()}</span>
          : <a href={x.href} hreflang={x.code} lang={x.code} aria-label={x.nom}>{x.code.toUpperCase()}</a>)}
      </span>
      <a class="btn btn-encre nav-btn" href="/demo" hreflang="fr">{l.nav.demo}<VersFr sr={l.versFrSr} /></a>
    </nav>
    <details class="menu-tel">
      <summary>{l.nav.menu}</summary>
      <div class="menu-tel-panneau">
        <a class="btn btn-menthe" href="/demo" hreflang="fr">{l.nav.demo}<VersFr sr={l.versFrSr} /></a>
        {ancres.map((a) => <a class="menu-tel-lien" href={a.href}>{a.nom}</a>)}
        <p class="menu-tel-langues" role="group" aria-label={l.nav.langues}>
          {LANGUES.map((x) => x.code === langue
            ? <span class="langue-active" lang={x.code} aria-current="page">{x.nom}</span>
            : <a href={x.href} hreflang={x.code} lang={x.code}>{x.nom}</a>)}
        </p>
      </div>
    </details>
  </div>
</header>

<main id="contenu">
  <slot />
</main>

<footer class="pied sur-encre">
  <div class="enveloppe">
    <div class="pied-haut">
      <div class="pied-marque">
        <a class="marque" href={chemin} aria-label={l.marqueAria}><svg aria-hidden="true"><use href="#boucle"/></svg>OnClub</a>
        <p>{l.pied.phrase}</p>
        <a class="btn btn-menthe btn-petit" href="/demo" hreflang="fr">{l.pied.demo}<VersFr sr={l.versFrSr} /></a>
      </div>
      <nav class="pied-grille" aria-label={l.pied.aria}>
        <div>
          <h2>{l.pied.surPage}</h2>
          <ul>
            {ancres.map((a) => <li><a href={a.href}>{a.nom}</a></li>)}
            <li><a href="#combien">{l.calc.surtitre}</a></li>
          </ul>
        </div>
        <div>
          <h2>{l.pied.surSite}</h2>
          <ul>
            <li><a href="/fonctionnalites" hreflang="fr">{l.pied.liens.fonctions}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/tarifs" hreflang="fr">{l.pied.liens.tarifs}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/temps-gagne" hreflang="fr">{l.pied.liens.temps}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/pour-qui" hreflang="fr">{l.pied.liens.pourQui}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/ressources" hreflang="fr">{l.pied.liens.ressources}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/presentation" hreflang="fr">{l.pied.liens.presentation}<VersFr sr={l.versFrSr} /></a></li>
          </ul>
        </div>
        <div>
          <h2>{l.pied.contact}</h2>
          <ul>
            <li><a href="/demo" hreflang="fr">{l.pied.demo}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href="/recommander" hreflang="fr">{l.pied.liens.recommander}<VersFr sr={l.versFrSr} /></a></li>
            <li><a href={`mailto:${EMAIL}`}>{EMAIL.split('@')[0]}<wbr />@{EMAIL.split('@')[1]}</a></li>
            <li><a href={lienWhatsApp(l.appel.message)} rel="noopener" target="_blank">WhatsApp</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <p class="pied-note">{l.pied.note}</p>
    <div class="pied-bas">
      <span>© {annee} OnClub</span>
      <a href="/mentions-legales" hreflang="fr">{l.pied.mentions}<VersFr sr={l.versFrSr} /></a>
      <a href="/confidentialite" hreflang="fr">{l.pied.confidentialite}<VersFr sr={l.versFrSr} /></a>
      <a href="/conditions" hreflang="fr">{l.pied.conditions}<VersFr sr={l.versFrSr} /></a>
      <button type="button" class="pied-cookies" data-consentement-ouvrir>{l.pied.cookies}</button>
      {LANGUES.filter((x) => x.code !== langue).map((x) => <a href={x.href} hreflang={x.code} lang={x.code}>{x.nom}</a>)}
    </div>
  </div>
</footer>

<div class="demo-fixe" data-demo-fixe>
  <a class="btn btn-encre" href="/demo" hreflang="fr">{l.nav.demo}<VersFr sr={l.versFrSr} /></a>
</div>

<section class="consentement" data-consentement hidden aria-labelledby="consentement-titre" role="region">
  <div class="consentement-boite">
    <div class="consentement-texte">
      <h2 id="consentement-titre">{l.consentement.titre}</h2>
      <p>{l.consentement.texte} <a href="/confidentialite#localisation" hreflang="fr">{l.consentement.plus}</a></p>
    </div>
    <div class="consentement-choix">
      <button type="button" class="btn btn-blanc" data-consentement-choix="refuse">{l.consentement.refuser}</button>
      <button type="button" class="btn btn-blanc" data-consentement-choix="accepte">{l.consentement.accepter}</button>
    </div>
  </div>
</section>

<script is:inline src="/js/site.js" defer></script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script is:inline>
/* L'observateur partagé, comme dans Layout.astro : [data-vu] reçoit .vu une fois (35 %), [data-champ] .hors-champ hors de l'écran.
   Le bouton de démo fixe se cache tant que le héros ou un bloc [data-sans-bouton-fixe] est à l'écran. */
(function(){if(!('IntersectionObserver'in window))return;var v=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('vu');v.unobserve(e.target)}})},{threshold:.35});var c=new IntersectionObserver(function(es){es.forEach(function(e){e.target.classList.toggle('hors-champ',!e.isIntersecting)})});document.querySelectorAll('[data-vu]').forEach(function(x){v.observe(x)});document.querySelectorAll('[data-champ]').forEach(function(x){c.observe(x)});
var f=document.querySelector('[data-demo-fixe]'),z=[].slice.call(document.querySelectorAll('[data-heros],[data-sans-bouton-fixe],footer')),vis=new Set();if(!f||!z.length)return;var o=new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?vis.add(e.target):vis.delete(e.target)});f.classList.toggle('demo-fixe-cache',vis.size>0)});z.forEach(function(x){o.observe(x)})})()
</script>
</body>
</html>

<style>
/* En-tête : repris d'EnTete.astro, sans les menus déroulants (une seule page traduite). */
.entete{background:var(--papier);border-bottom:1px solid var(--trait);position:relative;z-index:40}
.entete-barre{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px;min-height:72px}
.marque{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font:800 1.375rem/1 var(--f-titre)}
.marque svg{width:44px;height:22px}
.nav{display:none;align-items:center;gap:2px}
.nav>a{display:inline-flex;align-items:center;min-height:46px;padding:0 14px;border-radius:999px;text-decoration:none;font-weight:600}
.nav>a:hover{background:rgba(11,15,20,.08)}
.nav .nav-btn{margin-left:10px;min-height:46px;padding:0 22px}
.nav .nav-btn:hover{background:var(--encre)}
.langues{display:inline-flex;align-items:center;margin-left:8px;padding-left:10px;border-left:2px solid rgba(11,15,20,.2)}
.langues a,.langues .langue-active{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-weight:700;font-size:.875rem;text-decoration:none}
.langues a:hover{text-decoration:underline}
.langue-active{text-decoration:underline!important;text-decoration-thickness:2px!important;text-underline-offset:5px}
.menu-tel{position:static}
.menu-tel>summary{list-style:none;cursor:pointer;display:inline-flex;align-items:center;min-height:46px;padding:0 20px;border-radius:999px;border:2px solid var(--encre);font-weight:700;background:var(--blanc)}
.menu-tel>summary::-webkit-details-marker{display:none}
.menu-tel[open]>summary{background:var(--encre);color:var(--blanc)}
.menu-tel-panneau{position:absolute;left:var(--g);right:var(--g);top:calc(100% - 4px);background:var(--encre);color:var(--blanc);border-radius:var(--r-m);padding:16px;box-shadow:var(--ombre);display:flex;flex-direction:column;gap:4px}
.menu-tel-panneau .btn{width:100%;margin-bottom:8px}
.menu-tel-lien{display:flex;align-items:center;min-height:48px;padding:0 12px;border-radius:12px;font-weight:600;text-decoration:none}
.menu-tel-langues{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:8px;padding:8px 12px 0;border-top:1px solid #2A323D}
.menu-tel-langues a,.menu-tel-langues .langue-active{display:inline-flex;align-items:center;min-height:44px;color:#D7DBE1}
.menu-tel-panneau :focus-visible{outline-color:var(--menthe)}
@media (min-width:1080px){.nav{display:flex}.menu-tel{display:none}}

/* Pied de page : repris de PiedDePage.astro. */
.pied{background:var(--encre);color:#C3C8D0;padding-block:64px 40px;font-size:.9375rem}
.pied-haut{display:grid;gap:48px}
@media (min-width:1000px){.pied-haut{grid-template-columns:1fr 3fr;gap:56px}}
.pied-marque{display:flex;flex-direction:column;align-items:flex-start;gap:18px;max-width:34ch}
.pied .marque{color:var(--blanc)}
.pied .marque svg{color:var(--menthe)}
.pied-grille{display:grid;grid-template-columns:1fr 1fr;gap:32px 24px}
@media (min-width:760px){.pied-grille{grid-template-columns:repeat(3,minmax(0,1fr))}}
.pied h2{font:700 1rem/1.3 var(--f-texte);color:var(--blanc);margin-bottom:8px;letter-spacing:0}
.pied ul{list-style:none;padding:0}
.pied ul a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;overflow-wrap:anywhere}
.pied ul a:hover{color:var(--menthe);text-decoration:underline}
.pied-note{margin-top:40px;font-size:.875rem}
@media (max-width:759px){.pied{padding-block:48px 32px}.pied-haut{gap:32px}.pied-grille{gap:16px}.pied-note{margin-top:24px}.pied-bas{column-gap:16px}}
.pied-bas{margin-top:16px;padding-top:16px;border-top:1px solid #2A323D;display:flex;flex-wrap:wrap;align-items:center;gap:0 24px}
.pied-bas a,.pied-bas span,.pied-cookies{display:inline-flex;align-items:center;min-height:44px}
.pied-bas a:hover{color:var(--menthe)}
.pied-cookies{background:none;border:0;color:inherit;font:inherit;padding:0;text-decoration:underline;cursor:pointer}

/* Bouton de démo fixe sur téléphone : repris de BoutonDemoFixe.astro. */
.demo-fixe{position:fixed;left:0;right:0;bottom:0;z-index:45;padding:10px var(--g) calc(10px + env(safe-area-inset-bottom));background:linear-gradient(to top,var(--papier) 70%,rgba(245,242,234,0))}
.demo-fixe .btn{width:100%;min-height:50px}
.demo-fixe{transition:opacity .2s,transform .2s}
.demo-fixe.demo-fixe-cache{opacity:0;transform:translateY(16px);pointer-events:none;visibility:hidden}
:global(body){padding-bottom:84px}
:global(html.consentement-ouvert) .demo-fixe{display:none}
@media (min-width:760px){.demo-fixe{display:none}:global(body){padding-bottom:0}}

/* Bandeau de consentement : repris de Consentement.astro. */
.consentement{position:fixed;left:0;right:0;bottom:0;z-index:50;padding:0 12px calc(12px + env(safe-area-inset-bottom))}
.consentement[hidden]{display:none}
.consentement-boite{max-width:980px;margin:0 auto;background:var(--encre);color:var(--blanc);border-radius:var(--r-m);padding:14px 16px;box-shadow:var(--ombre);display:grid;gap:12px}
@media (min-width:860px){.consentement-boite{grid-template-columns:1fr auto;align-items:center;gap:24px;padding:16px 20px}}
.consentement h2{font:700 1.0625rem/1.25 var(--f-titre);margin:0 0 4px}
.consentement p{color:#D7DBE1;font-size:.875rem;line-height:1.45}
.consentement a{color:var(--blanc);font-weight:600}
.consentement-choix{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.consentement-choix .btn{width:100%;min-height:44px;padding:0 22px;font-size:.9375rem}
.consentement :focus-visible{outline-color:var(--menthe)}
</style>
