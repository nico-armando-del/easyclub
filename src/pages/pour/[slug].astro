---
/* Une page par fichier de src/content/profils/. Le gabarit : components/GabaritProduit.astro (maquettes §B.3). */
import GabaritProduit from '../../components/GabaritProduit.astro'
import { liste } from '../../lib/collections'
export async function getStaticPaths() {
  const entrees = await liste('profils')
  return entrees.map((entree) => ({ params: { slug: entree.id }, props: { entree } }))
}
const { entree } = Astro.props
---
<GabaritProduit collection="profils" entree={entree} />
