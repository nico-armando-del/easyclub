---
/*
  LES TARIFS, SUR DEVIS. Aucun taux n'est publié (Nico, 4 novembre 2026) : « il
  faut nous consulter ». Ce que chaque offre ouvre vient de src/data/site.ts
  (OFFRES) ; le tableau « fonctionnalité par offre » est construit à partir du
  champ `offre` de chaque fonctionnalité.
  Ordre : héros compact, les offres (listes ouvertes), les replis (fonctionnalité
  par offre, hypothèses), la FAQ, la case vide compacte.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import Offres from '../components/Offres.astro'
import Repli from '../components/Repli.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import { NOM_OFFRE, MISE_EN_ROUTE, TARIF_PHRASE } from '../data/site'
import { HYPOTHESES, HYPOTHESES_OFFRES } from '../data/temps'
import VersFr from '../components/langue/VersFr.astro'
import { catalogue } from '../lib/collections'
import { i18n, SR_FR } from '../i18n/ui'

/* Une seule page pour les deux langues : /es/tarifs l'importe, les textes passent par t(). */
const { langue, t, lien } = i18n(Astro.url)
const fonctions = await catalogue('fonctionnalites', langue)
const RANG = { mini: 0, pro: 1, max: 2 } as const
const cles = ['mini', 'pro', 'max'] as const

const fil = [{ nom: t('Tarifs'), url: lien('/tarifs') }]
const faq = [
  { question: t('Combien coûte OnCluby ?'), reponse: t('Le tarif dépend de votre club et de l’offre choisie. Pour le connaître, il faut nous consulter : demandez une démo ou écrivez-nous, on vous répond avec le tarif de votre association.') },
  { question: t('Y a-t-il un abonnement fixe ou des frais d’installation ?'), reponse: t('Non. L’abonnement est un pourcentage des cotisations encaissées en ligne, et rien d’autre : ni frais fixe, ni frais d’installation, ni coût par adhérent, ni minimum.') },
  { question: t('Les chèques et les espèces sont-ils comptés ?'), reponse: t('Non. Ce que le bureau note lui-même, en chèque ou en espèces, ne passe pas par la commission. Seul ce qui est payé en ligne compte.') },
  { question: t('Qui paie les frais de carte bancaire ?'), reponse: t('L’association. Beaucoup les couvrent par des frais de dossier inclus dans le prix d’inscription, appliqués à toutes les familles quel que soit le moyen de paiement.') },
  { question: t('Peut-on changer d’offre en cours de saison ?'), reponse: t('Oui. Le changement vaut pour les encaissements suivants, sans effet rétroactif. En passant de Pro à Mini, l’association perd ce que Pro ouvre, Cluby compris.') },
  { question: t('Quand l’association est-elle en ligne ?'), reponse: t(MISE_EN_ROUTE) },
]
---
<Layout
  titre={t('Tarifs OnCluby : sur devis, selon votre club')}
  description={t('Les offres d’OnCluby, Mini, Pro et Pro Max IA : ce que chacune ouvre et le temps qu’elle rend. Le tarif dépend de votre club : il faut nous consulter.')}
  chemin={lien('/tarifs')}
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre={t('Tarifs')}
    titre={t('Le tarif, sur devis')}
    phrase={t(TARIF_PHRASE) + ' ' + t('Plus l’offre est complète, plus elle rend de temps.')}
    cta={{ texte: t('Demander le tarif'), href: lien('/demo') }}
    lien={{ texte: t('Ce que chaque offre ouvre'), href: '#t-offres' }}
  />

  <section class="section section-offres" aria-labelledby="t-offres">
    <div class="enveloppe">
      <h2 id="t-offres" class="sr">{t('Les trois offres')}</h2>
      <Offres mode="complet" />
      <div class="replis">
        <Repli titre={t('Ce que chaque offre ouvre, fonctionnalité par fonctionnalité')}>
          <div class="tableau-defile" data-defile-x>
            <table class="tableau-offres">
              <caption class="sr">{t('Les fonctionnalités incluses dans chaque offre')}</caption>
              <thead><tr><th scope="col">{t('Fonctionnalité')}</th>{cles.map((k) => <th scope="col">{NOM_OFFRE[k]}</th>)}</tr></thead>
              <tbody>
                {fonctions.slice().sort((x, y) => RANG[x.data.offre as keyof typeof RANG] - RANG[y.data.offre as keyof typeof RANG] || x.nom.localeCompare(y.nom, langue)).map((f) => (
                  <tr>
                    <th scope="row"><a href={f.url} hreflang={f.fr ? 'fr' : undefined}>{f.nom}{f.fr && <VersFr sr={SR_FR} />}</a><span>{f.ligne}</span></th>
                    {cles.map((k) => RANG[k] >= RANG[f.data.offre as keyof typeof RANG] ? <td class="oui"><svg aria-hidden="true"><use href="#coche"/></svg><span class="sr">{t('Incluse')}</span></td> : <td class="non"><span aria-hidden="true">—</span><span class="sr">{t('Non incluse')}</span></td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Repli>
        <Repli titre={t('Comment on compte ces heures')}>
          <p>{t(HYPOTHESES)}</p>
          <p>{t(HYPOTHESES_OFFRES)}</p>
          <p><a class="lien-fleche" href={lien('/temps-gagne')}>{t('Refaire le calcul avec vos chiffres')} <svg aria-hidden="true"><use href="#fleche"/></svg></a></p>
        </Repli>
      </div>
    </div>
  </section>


  <div class="section"><div class="enveloppe"><Faq items={faq} disposition="deux-colonnes" /></div></div>
  <CaseVide compact />
</Layout>

<style>
.replis{margin-top:var(--e-7);display:grid}
.replis :global(.repli){max-width:none}
.tableau-defile{overflow-x:auto;-webkit-overflow-scrolling:touch}
.tableau-offres{width:100%;border-collapse:collapse}
.tableau-offres thead th:not(:first-child),.tableau-offres td{width:64px;padding-inline:4px}
@media (min-width:760px){.tableau-offres thead th:not(:first-child),.tableau-offres td{width:140px}}
.tableau-offres th,.tableau-offres td{padding:14px 10px;border-bottom:1px solid var(--trait);text-align:center;vertical-align:middle}
.tableau-offres thead th{font:700 1rem/1.2 var(--f-titre);border-bottom:2px solid var(--encre)}
.tableau-offres tbody th{text-align:left;font-weight:500}
.tableau-offres tbody th a{display:inline-flex;align-items:center;min-height:44px;font:700 1.0625rem/1.25 var(--f-titre)}
.tableau-offres tbody th span{display:block;font-size:.875rem;color:var(--gris)}
.tableau-offres thead th:first-child{text-align:left}
.oui svg{width:20px;height:20px;margin:0 auto;color:var(--sapin)}
.non{color:var(--gris)}
</style>
