---
/*
  LES TARIFS. Les taux et ce que chaque offre ouvre viennent de src/data/site.ts
  (OFFRES) ; le tableau « fonctionnalité par offre » est construit à partir du
  champ `offre` de chaque fonctionnalité. L'exemple chiffré est CALCULÉ ici à
  partir des mêmes constantes (taux, frais de carte) : rien n'est tapé à la main.
  Ordre (maquettes §B.4) : héros compact, les offres (listes ouvertes), l'exemple
  chiffré en tableau à filets, les frais de carte, les replis (fonctionnalité par
  offre, hypothèses), la FAQ, la case vide compacte.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import Offres from '../components/Offres.astro'
import Repli from '../components/Repli.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import { OFFRES, FRAIS_CARTE, NOM_OFFRE, MISE_EN_ROUTE } from '../data/site'
import { HYPOTHESES, HYPOTHESES_OFFRES } from '../data/temps'
import { liste, url } from '../lib/collections'

const fonctions = await liste('fonctionnalites')
const RANG = { mini: 0, pro: 1, max: 2 } as const
const cles = ['mini', 'pro', 'max'] as const

const euros = (c: number) => (c / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'
const pro = OFFRES.find((o) => o.cle === 'pro')!
const tauxPro = parseFloat(pro.taux.replace(',', '.')) / 100
function exemple(prixCents: number) {
  const commission = Math.round(prixCents * tauxPro)
  const carte = Math.round(prixCents * FRAIS_CARTE.pourcentage) + FRAIS_CARTE.fixeCents
  return { prix: prixCents, commission, carte, recu: prixCents - commission - carte }
}
const COTISATION = 20000
const DOSSIER = 1000
const a = exemple(COTISATION)
const b = exemple(COTISATION + DOSSIER)

const fil = [{ nom: 'Tarifs', url: '/tarifs' }]
const faq = [
  { question: 'Y a-t-il un abonnement fixe ou des frais d’installation ?', reponse: 'Non. L’abonnement est un pourcentage des cotisations encaissées en ligne, et rien d’autre : ni frais fixe, ni frais d’installation, ni coût par adhérent, ni minimum.' },
  { question: 'Les chèques et les espèces sont-ils comptés ?', reponse: 'Non. Ce que le bureau note lui-même, en chèque ou en espèces, ne passe pas par la commission. Seul ce qui est payé en ligne compte.' },
  { question: 'Qui paie les frais de carte bancaire ?', reponse: 'L’association. Beaucoup les couvrent par des frais de dossier inclus dans le prix d’inscription, appliqués à toutes les familles quel que soit le moyen de paiement. L’exemple chiffré de cette page montre les deux cas.' },
  { question: 'Peut-on changer d’offre en cours de saison ?', reponse: 'Oui. Le changement vaut pour les encaissements suivants, sans effet rétroactif. En passant de Pro à Mini, l’association perd ce que Pro ouvre, Cluby compris.' },
  { question: 'Quand l’association est-elle en ligne ?', reponse: MISE_EN_ROUTE },
]
---
<Layout
  titre="Tarifs OnClub : un pourcentage, rien de fixe"
  description="Les tarifs d’OnClub : 2,90 %, 4,90 % ou 6,90 % des cotisations encaissées en ligne, rien de fixe. Ce que chaque offre ouvre, le temps rendu, un exemple chiffré."
  chemin="/tarifs"
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre="Tarifs"
    titre="Un abonnement au pourcentage. Rien de fixe"
    phrase="Un pourcentage de ce que l’association encaisse en ligne. Rien sur les chèques ni les espèces. Plus l’offre est complète, plus elle rend de temps."
    cta={{ texte: 'Demander une démo', href: '/demo' }}
    lien={{ texte: 'L’exemple chiffré', href: '#exemple' }}
  />

  <section class="section section-offres" aria-labelledby="t-offres">
    <div class="enveloppe">
      <h2 id="t-offres" class="sr">Les trois offres</h2>
      <Offres mode="complet" />
      <div class="replis">
        <Repli titre="Ce que chaque offre ouvre, fonctionnalité par fonctionnalité">
          <div class="tableau-defile" data-defile-x>
            <table class="tableau-offres">
              <caption class="sr">Les fonctionnalités incluses dans chaque offre</caption>
              <thead><tr><th scope="col">Fonctionnalité</th>{cles.map((k) => <th scope="col">{NOM_OFFRE[k]}</th>)}</tr></thead>
              <tbody>
                {fonctions.slice().sort((x, y) => RANG[x.data.offre] - RANG[y.data.offre] || x.data.nom.localeCompare(y.data.nom, 'fr')).map((f) => (
                  <tr>
                    <th scope="row"><a href={url('fonctionnalites', f.id)}>{f.data.nom}</a><span>{f.data.ligne}</span></th>
                    {cles.map((k) => RANG[k] >= RANG[f.data.offre] ? <td class="oui"><svg aria-hidden="true"><use href="#coche"/></svg><span class="sr">Incluse</span></td> : <td class="non"><span aria-hidden="true">—</span><span class="sr">Non incluse</span></td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Repli>
        <Repli titre="Comment on compte ces heures">
          <p>{HYPOTHESES}</p>
          <p>{HYPOTHESES_OFFRES}</p>
          <p><a class="lien-fleche" href="/temps-gagne">Refaire le calcul avec vos chiffres <svg aria-hidden="true"><use href="#fleche"/></svg></a></p>
        </Repli>
      </div>
    </div>
  </section>

  <section class="section fond-blanc" id="exemple" aria-labelledby="t-exemple">
    <div class="enveloppe exemple-chiffre">
      <div class="section-tete">
        <h2 id="t-exemple" class="h2-idee">Un exemple chiffré, au centime</h2>
        <p>Une cotisation de {euros(COTISATION)} payée par carte, avec OnClub Pro. Les frais de carte sont à la charge de l’association.</p>
      </div>
      <div class="tableau-defile" data-defile-x>
        <table class="tableau-exemple">
          <caption class="sr">Ce que l’association reçoit d’une cotisation de {euros(COTISATION)} payée par carte, sans puis avec des frais de dossier</caption>
          <thead><tr><td></td><th scope="col">Sans frais de dossier</th><th scope="col">Avec {euros(DOSSIER)} de frais de dossier</th></tr></thead>
          <tbody>
            <tr><th scope="row">La famille paie</th><td class="num">{euros(a.prix)}</td><td class="num">{euros(b.prix)}</td></tr>
            <tr><th scope="row">OnClub Pro, {pro.taux}</th><td class="num">− {euros(a.commission)}</td><td class="num">− {euros(b.commission)}</td></tr>
            <tr><th scope="row">Frais de carte, {FRAIS_CARTE.texte}</th><td class="num">− {euros(a.carte)}</td><td class="num">− {euros(b.carte)}</td></tr>
            <tr class="total"><th scope="row">L’association reçoit</th><td class="num">{euros(a.recu)}</td><td class="num">{euros(b.recu)}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="frais">
        <h3>Les frais de carte</h3>
        <p>Les frais de dossier sont inclus dans le prix d’inscription et appliqués à toutes les familles, quel que soit le moyen de paiement. Une famille qui paie par chèque règle aussi {euros(b.prix)}, sans commission ni frais de carte.</p>
        <p class="note">Exemple, pas un devis. Frais de carte : tarif standard de Stripe pour les cartes de l’Espace économique européen, <a href={FRAIS_CARTE.source} target="_blank" rel="noopener">grille tarifaire Stripe</a>, consultée le {FRAIS_CARTE.consulte}. Les cotisations payées en plusieurs fois suivent la même règle, échéance par échéance.</p>
      </div>
    </div>
  </section>

  <div class="section"><div class="enveloppe"><Faq items={faq} disposition="deux-colonnes" /></div></div>
  <CaseVide compact />
</Layout>

<style>
.replis{margin-top:var(--e-7);display:grid}
.replis :global(.repli){max-width:none}
.tableau-defile{overflow-x:auto;-webkit-overflow-scrolling:touch}
.tableau-offres{width:100%;border-collapse:collapse}
.tableau-offres thead th:not(:first-child),.tableau-offres td{width:64px;padding-inline:4px}
@media (min-width:760px){.tableau-offres thead th:not(:first-child),.tableau-offres td{width:140px}}
.tableau-offres th,.tableau-offres td{padding:14px 10px;border-bottom:1px solid var(--trait);text-align:center;vertical-align:middle}
.tableau-offres thead th{font:700 1rem/1.2 var(--f-titre);border-bottom:2px solid var(--encre)}
.tableau-offres tbody th{text-align:left;font-weight:500}
.tableau-offres tbody th a{display:inline-flex;align-items:center;min-height:44px;font:700 1.0625rem/1.25 var(--f-titre)}
.tableau-offres tbody th span{display:block;font-size:.875rem;color:var(--gris)}
.tableau-offres thead th:first-child{text-align:left}
.oui svg{width:20px;height:20px;margin:0 auto;color:var(--sapin)}
.non{color:var(--gris)}
.exemple-chiffre .section-tete{margin-bottom:var(--e-6)}
.tableau-exemple{width:100%;max-width:820px;border-collapse:collapse;font-size:var(--t-petit)}
.tableau-exemple th,.tableau-exemple td{padding:14px 12px;border-bottom:1px solid var(--trait);text-align:left;vertical-align:top}
.tableau-exemple thead th{font:700 1rem/1.25 var(--f-titre);border-bottom:2px solid var(--encre)}
.tableau-exemple thead td{border-bottom:2px solid var(--encre)}
.tableau-exemple tbody th{font-weight:500;color:var(--gris)}
.tableau-exemple td{font-weight:700;white-space:nowrap;text-align:right}
.tableau-exemple thead th:not(:first-child){text-align:right}
.tableau-exemple .total th{color:var(--encre);font-weight:700;border-bottom:0}
.tableau-exemple .total td{font:800 1.375rem/1 var(--f-titre);border-bottom:0;padding-top:18px}
@media (max-width:520px){.tableau-exemple th,.tableau-exemple td{padding:12px 6px}.tableau-exemple{font-size:.875rem}}
.frais{margin-top:var(--e-6);max-width:var(--lecture)}
.frais h3{font-size:1.25rem}
.frais p{margin-top:var(--e-3)}
</style>
