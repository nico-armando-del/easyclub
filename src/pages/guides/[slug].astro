---
/* Une page par fichier de src/content/guides/. Le gabarit éditorial : components/GabaritEditorial.astro. */
import GabaritEditorial from '../../components/GabaritEditorial.astro'
import { liste } from '../../lib/collections'
export async function getStaticPaths() {
  const entrees = await liste('guides')
  return entrees.map((entree) => ({ params: { slug: entree.id }, props: { entree } }))
}
const { entree } = Astro.props
---
<GabaritEditorial collection="guides" entree={entree} />
