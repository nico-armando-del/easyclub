---
/*
  LE HUB DES FONCTIONNALITÉS, PAR FAMILLES (maquettes §B.4). Construit à partir de la
  collection : une fonctionnalité ajoutée dans src/content/fonctionnalites/ apparaît
  ici, dans le menu, le pied de page et le plan du site.
  Ordre : héros compact, bento des six familles (lot B), une section par famille
  (tuiles sur 3 colonnes), la FAQ, la case vide compacte.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import TuileFonction from '../components/TuileFonction.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import Bento from '../components/Bento.astro'
import { parFamille } from '../lib/collections'
import { existeEcranFonctionEs } from '../lib/ecransFonction'
import { i18n } from '../i18n/ui'

/* Une seule page pour les deux langues : /es/fonctionnalites l'importe (src/pages/es/), les textes passent par t(). */
const { langue, t, lien } = i18n(Astro.url)
const familles = await parFamille(langue)
const total = familles.reduce((s, f) => s + f.items.length, 0)
const fil = [{ nom: t('Fonctionnalités'), url: lien('/fonctionnalites') }]
const faq = [
  { question: t('Faut-il prendre toutes les fonctionnalités ?'), reponse: t('Non. OnClub Mini couvre les inscriptions, le paiement, le suivi de l’argent, les relances, les pièces, les convocations, l’appel et la compo du match. Pro ajoute la saison suivante, la liste d’attente, les messages, le site et Cluby. Pro Max IA ajoute la boutique et les événements. Chaque page indique l’offre qui l’ouvre.') },
  { question: t('Où arrive l’argent payé par carte ?'), reponse: t('Sur le compte de l’association, déduction faite de la part OnClub et des frais de carte. Les chèques et les espèces se notent dans le dossier, au centime, et ne passent pas par la commission.') },
  { question: t('Peut-on reprendre nos fichiers de la saison passée ?'), reponse: t('Oui. Vous déposez le tableur de la saison passée, en CSV : les anciens adhérents sont reconnus et reçoivent leur lien de réinscription. Vous relisez ce qui a été lu avant de valider.') },
  { question: t('Un encadrant doit-il créer un compte ?'), reponse: t('Non. Le bureau lui transmet un lien personnel, sans compte ni mot de passe. Il fait l’appel et prépare la compo depuis son téléphone, sans voir ni adresse ni téléphone des familles.') },
]
/* La vignette d'écran d'une tuile : en espagnol, seulement si l'écran traduit existe (jamais d'écran français). */
const vignette = (e: { id: string; data: any }) => {
  const nom = e.data.ecranFonction === true ? e.id : e.data.ecranFonction || undefined
  return nom && (langue === 'fr' || existeEcranFonctionEs(nom)) ? nom : undefined
}
---
<Layout
  titre={t('Fonctionnalités pour gérer une association | OnClub')}
  description={t('Les {n} fonctionnalités d’OnClub en six familles : inscrire, encaisser, organiser, communiquer, vendre, piloter. Le nom, et le temps que chacune vous rend.', { n: total })}
  chemin={lien('/fonctionnalites')}
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre={t('Les fonctionnalités')}
    titre={t('Chaque soirée perdue a sa fonctionnalité')}
    phrase={t('{n} fonctionnalités en six familles, chacune avec le temps qu’elle vous rend. Estimation pour 250 adhérents, pas une étude.', { n: total })}
    cta={{ texte: t('Demander une démo'), href: lien('/demo') }}
    lien={{ texte: t('Voir les offres'), href: lien('/tarifs') }}
  />

  <section class="section section-bento" aria-labelledby="t-familles">
    <div class="enveloppe">
      <Bento titre={t('Les six familles')} niveau="h2" lienTout={false} id="t-familles" />
    </div>
  </section>

  {familles.map((f) => (
    <section class="section famille" id={f.ancre} aria-labelledby={`t-${f.ancre}`}>
      <div class="enveloppe">
        <div class="section-tete">
          <h2 id={`t-${f.ancre}`} class="h2-idee">{t(f.cle)}</h2>
        </div>
        <ul class="tuiles">
          {f.items.map((e) => (
            <li><TuileFonction nom={e.nom} ligne={e.ligne ?? ''} href={e.url} offre={e.data.offre} ecran={vignette(e)} fr={e.fr} /></li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <div class="section"><div class="enveloppe"><Faq items={faq} disposition="deux-colonnes" /></div></div>
  <CaseVide compact />
</Layout>

<style>
.section-bento{padding-top:var(--e-5)}
.famille .section-tete{margin-bottom:var(--e-6)}
.tuiles{list-style:none;padding:0;margin:0;display:grid;gap:var(--col-gap)}
.tuiles>li{min-width:0}
@media (min-width:640px){.tuiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1000px){.tuiles{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
