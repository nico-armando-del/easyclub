---
/*
  LE HUB DES FONCTIONNALITÉS, PAR FAMILLES (maquettes §B.4). Construit à partir de la
  collection : une fonctionnalité ajoutée dans src/content/fonctionnalites/ apparaît
  ici, dans le menu, le pied de page et le plan du site.
  Ordre : héros compact, bento des six familles (lot B), une section par famille
  (tuiles sur 3 colonnes), la FAQ, la case vide compacte.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import TuileFonction from '../components/TuileFonction.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import Bento from '../components/Bento.astro'
import { parFamille, url } from '../lib/collections'

const familles = await parFamille()
const total = familles.reduce((s, f) => s + f.items.length, 0)
const fil = [{ nom: 'Fonctionnalités', url: '/fonctionnalites' }]
const faq = [
  { question: 'Faut-il prendre toutes les fonctionnalités ?', reponse: 'Non. OnClub Mini couvre les inscriptions, le paiement, le suivi de l’argent, les relances et les pièces. Pro ajoute la saison suivante, la liste d’attente, les messages, le site et Cluby. Pro Max IA ajoute la boutique et les événements. Chaque page indique l’offre qui l’ouvre.' },
  { question: 'Où arrive l’argent payé par carte ?', reponse: 'Sur le compte de l’association, déduction faite de la part OnClub et des frais de carte. Les chèques et les espèces se notent dans le dossier, au centime, et ne passent pas par la commission.' },
  { question: 'Peut-on reprendre nos fichiers de la saison passée ?', reponse: 'Oui. Vos tableurs sont repris : les anciens adhérents sont reconnus et reçoivent leur lien de réinscription, sans rien ressaisir.' },
  { question: 'Un encadrant doit-il créer un compte ?', reponse: 'Non. Il reçoit un lien personnel, sans compte ni mot de passe. Il fait l’appel et prépare la compo depuis son téléphone, sans voir ni adresse ni téléphone des familles.' },
]
---
<Layout
  titre="Fonctionnalités pour gérer une association | OnClub"
  description={`Les ${total} fonctionnalités d’OnClub en six familles : inscrire, encaisser, organiser, communiquer, vendre, piloter. Le nom, et le temps que chacune vous rend.`}
  chemin="/fonctionnalites"
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre="Les fonctionnalités"
    titre="Chaque soirée perdue a sa fonctionnalité"
    phrase={`${total} fonctionnalités en six familles, chacune avec le temps qu’elle vous rend. Estimation pour 250 adhérents, pas une étude.`}
    cta={{ texte: 'Demander une démo', href: '/demo' }}
    lien={{ texte: 'Voir les offres', href: '/tarifs' }}
  />

  <section class="section section-bento" aria-labelledby="t-familles">
    <div class="enveloppe">
      <Bento titre="Les six familles" niveau="h2" lienTout={false} id="t-familles" />
    </div>
  </section>

  {familles.map((f) => (
    <section class="section famille" id={f.ancre} aria-labelledby={`t-${f.ancre}`}>
      <div class="enveloppe">
        <div class="section-tete">
          <h2 id={`t-${f.ancre}`} class="h2-idee">{f.cle}</h2>
        </div>
        <ul class="tuiles">
          {f.items.map((e) => (
            <li><TuileFonction nom={e.data.nom} ligne={e.data.ligne} href={url('fonctionnalites', e.id)} offre={e.data.offre} /></li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <div class="section"><div class="enveloppe"><Faq items={faq} disposition="deux-colonnes" /></div></div>
  <CaseVide compact />
</Layout>

<style>
.section-bento{padding-top:var(--e-5)}
.famille .section-tete{margin-bottom:var(--e-6)}
.tuiles{list-style:none;padding:0;margin:0;display:grid;gap:var(--col-gap)}
@media (min-width:640px){.tuiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1000px){.tuiles{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
