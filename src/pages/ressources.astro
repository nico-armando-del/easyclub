---
/*
  /RESSOURCES EN MAGAZINE (maquettes §B.6, récit §5) : fond papier, la couleur ne vient que
  des couvertures. En-tête compact, rubriques en ANCRES (pas de filtre JS), la une et
  « À lire aussi », les récents en filets, les guides sur deux colonnes avec leur couverture
  carrée, les comparatifs, la bande encre des trois outils, la FAQ (inchangée), la case vide.
  Tout est construit à partir des collections : un nouveau .mdx apparaît ici tout seul.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import UneMagazine from '../components/UneMagazine.astro'
import ListeFilets, { type EntreeFilet } from '../components/ListeFilets.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import { liste, url } from '../lib/collections'
import { MISE_EN_ROUTE } from '../data/site'

const fil = [{ nom: 'Ressources', url: '/ressources' }]
const faq = [
  { question: 'Qu’est-ce qu’OnClub ?', reponse: 'Une plateforme française pour les associations qui inscrivent des adhérents : inscriptions et cotisations en ligne, suivi de l’argent, relances d’un bouton, pièces justificatives, saison suivante, convocations, site et boutique de l’association.' },
  { question: 'OnClub convient-il à une association qui n’est pas sportive ?', reponse: 'Oui, dès qu’il y a des inscriptions, des cours ou des groupes et des cotisations : école de musique, de danse, de théâtre, de langues, chorale, atelier. Chaque cours a sa discipline, son niveau, ses encadrants, sa salle, ses créneaux, ses places et son tarif.' },
  { question: 'Combien de temps faut-il pour démarrer ?', reponse: MISE_EN_ROUTE },
  { question: 'Les données des familles sont-elles protégées ?', reponse: 'Les données sont hébergées dans l’Union européenne, ni revendues ni utilisées à des fins publicitaires. Les paiements sont traités par Stripe : OnClub ne voit ni ne conserve les numéros de carte. Le détail est dans la politique de confidentialité.' },
  { question: 'Comment obtenir une démo ?', reponse: 'Répondez aux cinq questions de la page de démo : vous voyez le temps que votre association gagnerait, puis vous nous écrivez sur WhatsApp ou par e-mail avec un message déjà rempli.' },
]

const AUTEUR = 'L’équipe OnClub'
const dateCourte = (x: Date) => x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
const articles = await liste('articles')
const guides = await liste('guides')
const comparatifs = await liste('comparatifs')

type Edito = { c: 'guides' | 'articles'; e: any }
const enFilet = ({ c, e }: Edito, avecCouv = false): EntreeFilet => ({
  rubrique: c === 'articles' ? e.data.rubrique : 'Guide',
  duree: `${e.data.lecture} min`,
  titre: e.data.titre,
  href: url(c, e.id),
  date: dateCourte(e.data.publie),
  auteur: AUTEUR,
  ligne: c === 'guides' ? e.data.ligne : undefined,
  ...(avecCouv ? { couverture: { rubrique: c, donnee: e.data.couverture?.donnee, titreCourt: e.data.nom } } : {}),
})

/* La une : l'entrée marquée `une: true`, sinon la plus récente des guides et articles. */
const tous: Edito[] = [
  ...articles.map((e) => ({ c: 'articles' as const, e })),
  ...guides.map((e) => ({ c: 'guides' as const, e })),
].sort((a, b) => b.e.data.publie.getTime() - a.e.data.publie.getTime())
const une = tous.find((x) => x.e.data.une) ?? tous[0]
const memeQueUne = (x: Edito) => !!une && x.c === une.c && x.e.id === une.e.id
const entreeUne = une && {
  ...enFilet(une),
  ligne: une.e.data.ligne,
  couverture: {
    rubrique: une.c,
    donnee: une.e.data.couverture?.donnee,
    apres: une.e.data.couverture?.apres,
    sous: une.e.data.couverture?.sous,
    titreCourt: une.e.data.nom,
  },
}
/* « À lire aussi » : les deux guides les plus récents (les articles suivent dans « Les récents »). */
const aussi = tous.filter((x) => x.c === 'guides' && !memeQueUne(x)).slice(0, 2).map((x) => enFilet(x))
const recents = tous.filter((x) => x.c === 'articles' && !memeQueUne(x)).slice(0, 10).map((x) => enFilet(x))
const listeGuides = tous
  .filter((x) => x.c === 'guides' && !memeQueUne(x))
  .map((x) => ({ ...enFilet(x, true), rubrique: `${x.e.data.lecture} min de lecture`, duree: undefined, date: undefined, auteur: undefined, ligne: undefined }))
const listeComparatifs = comparatifs.map((e) => ({ titre: e.data.nom, href: url('comparatifs', e.id) }))

const RUBRIQUES = [
  { nom: 'Tout', href: '#a-la-une' },
  { nom: 'Guides', href: '#guides' },
  { nom: 'Articles', href: '#articles' },
  { nom: 'Comparatifs', href: '#comparatifs' },
  { nom: 'Outils', href: '#outils' },
]
const OUTILS = [
  { titre: 'Le calculateur du temps gagné', href: '/temps-gagne' },
  { titre: 'Les offres et un exemple chiffré', href: '/tarifs' },
  { titre: 'OnClub en écrans animés', href: '/presentation' },
]
const VIDE = 'Rien dans cette rubrique pour l’instant.'
---
<Layout
  titre="Guides et ressources pour gérer une association | OnClub"
  description="Guides pratiques, articles et comparatifs pour les bénévoles d’association : cotisations, aides, inscriptions, rentrée. Sans jargon, avec les sources."
  chemin="/ressources"
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre="Ressources"
    titre="Les ressources du bureau bénévole"
    phrase="Guides pour faire juste, articles pour gagner du temps, comparatifs pour choisir."
  >
    <nav class="rubriques" aria-label="Rubriques des ressources">
      <ul>
        {RUBRIQUES.map((r, i) => <li><a href={r.href} aria-current={i === 0 ? 'true' : undefined}>{r.nom}</a></li>)}
      </ul>
    </nav>
  </HerosCompact>

  <div class="magazine enveloppe">
    <div class="mag-bloc" id="a-la-une">
      {entreeUne ? (
        <UneMagazine entree={entreeUne} aussi={aussi} />
      ) : (
        <p class="vide">{VIDE} <a href="/ressources">Toutes les ressources</a></p>
      )}
    </div>

    <div class="mag-bloc">
      {recents.length > 0 ? (
        <ListeFilets entrees={recents} titre="Les récents" niveau="h2" id="articles" />
      ) : (
        <section id="articles" aria-labelledby="articles-titre">
          <h2 class="mag-h2" id="articles-titre">Les récents</h2>
          <p class="vide">{VIDE} <a href="/ressources">Toutes les ressources</a></p>
        </section>
      )}
    </div>

    <div class="mag-bloc">
      {listeGuides.length > 0 ? (
        <ListeFilets entrees={listeGuides} titre="Les guides pratiques" niveau="h2" colonnes={2} id="guides" />
      ) : (
        <section id="guides" aria-labelledby="guides-titre">
          <h2 class="mag-h2" id="guides-titre">Les guides pratiques</h2>
          <p class="vide">{VIDE} <a href="/ressources">Toutes les ressources</a></p>
        </section>
      )}
    </div>

    <section class="mag-bloc outils" aria-label="Comparatifs et outils">
      <div class="outils-groupe" id="comparatifs">
        <h2 class="outils-titre">Les comparatifs</h2>
        {listeComparatifs.length > 0 ? (
          <ul>{listeComparatifs.map((o) => <li><a class="lien-fleche" href={o.href}>{o.titre} <svg aria-hidden="true"><use href="#fleche"/></svg></a></li>)}</ul>
        ) : (
          <p class="vide-encre">{VIDE} <a href="/ressources">Toutes les ressources</a></p>
        )}
      </div>
      <div class="outils-groupe" id="outils">
        <h2 class="outils-titre">Les outils</h2>
        <ul>
          {OUTILS.map((o) => <li><a class="lien-fleche" href={o.href}>{o.titre} <svg aria-hidden="true"><use href="#fleche"/></svg></a></li>)}
        </ul>
      </div>
    </section>

    <div class="mag-bloc"><Faq items={faq} /></div>
  </div>

  <CaseVide compact />
</Layout>
<style>
.rubriques{margin-top:var(--e-5,24px)}
.rubriques ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:0 24px}
.rubriques a{display:inline-flex;align-items:center;min-height:44px;font-weight:600;color:var(--gris);text-decoration:none;border-bottom:2px solid transparent}
.rubriques a:hover{color:var(--encre);border-bottom-color:var(--encre)}
.rubriques a[aria-current]{color:var(--encre);border-bottom-color:var(--menthe)}

.magazine{padding-bottom:var(--e-9,96px)}
.mag-bloc+.mag-bloc{margin-top:var(--e-8,64px)}
@media (min-width:760px){.mag-bloc+.mag-bloc{margin-top:80px}}
/* Le h1 tient sur une ligne à 1280 (maquettes §B.6) */
@media (min-width:1000px){:global(.heros-compact) :global(.hc-titre){max-width:none}}
.mag-h2{font-size:var(--t-h2-idee,clamp(2rem,1.3rem + 2.6vw,3.25rem));line-height:1.08;margin-bottom:var(--e-5,24px)}
.vide{color:var(--gris)}
.vide a{font-weight:700;color:var(--encre)}

.outils{background:var(--encre);color:var(--blanc);border-radius:var(--r-xl,40px);padding:20px 24px;display:grid;gap:12px}
.outils-groupe{display:grid;gap:4px}
@media (min-width:760px){.outils{padding:24px 40px;gap:4px}.outils-groupe{display:flex;align-items:center;gap:8px 32px}}
.outils-titre{font:700 var(--t-micro,.8125rem)/1.3 var(--f-texte);letter-spacing:.08em;text-transform:uppercase;color:var(--texte-scene-doux,#AEB4BE);flex:none;min-width:9.5em}
.outils ul{list-style:none;padding:0;margin:0;display:grid}
@media (min-width:760px){.outils ul{display:flex;flex-wrap:wrap;gap:0 32px}}
.outils a{color:var(--blanc)}
.outils a svg{color:var(--menthe)}
.vide-encre{color:var(--texte-scene,#D7DBE1)}
.vide-encre a{color:var(--blanc);font-weight:700}
</style>
