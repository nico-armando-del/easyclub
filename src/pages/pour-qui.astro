---
/*
  LE HUB « POUR QUI » (maquettes §B.4 et §F) : sports, autres activités, profils,
  construits à partir des collections. Aucun annuaire de clubs.
  C'est la page qui lie TOUTES les pages sports et activités : les 10 premières en
  cartes photo, puis (au-delà de 10) la liste complète de A à Z avec son filtre.
  L'en-tête et le pied de page n'en montrent que 10 et renvoient ici.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import CartesCollection from '../components/CartesCollection.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import { liste, url } from '../lib/collections'

const sports = await liste('sports')
const activites = await liste('activites')
const profils = await liste('profils')

const fil = [{ nom: 'Pour qui', url: '/pour-qui' }]
const faq = [
  { question: 'Mon activité n’est pas dans la liste : OnClub peut-il convenir ?', reponse: 'Probablement, s’il y a des inscriptions, des cours ou des groupes et des cotisations. Chaque cours ou équipe a sa discipline, son niveau, ses encadrants, sa salle, ses créneaux, ses places et son tarif : le formulaire d’inscription suit votre catalogue. Le plus simple est d’en parler en démo.' },
  { question: 'Les adultes peuvent-ils s’inscrire seuls ?', reponse: 'Oui. Chaque cours est borné par années de naissance : un cours pour adultes s’ouvre aux années qui conviennent. Un adulte qui s’inscrit seul indique un contact d’urgence.' },
  { question: 'Je suis adhérent, pas au bureau : que puis-je faire ?', reponse: 'Transmettre OnClub à votre club : la page dédiée prépare un message court pour le bureau, à envoyer par WhatsApp ou par e-mail.' },
]
---
<Layout
  titre="Pour quelles associations ? Sport, musique, danse | OnClub"
  description="OnClub sert toutes les associations qui inscrivent : clubs de sport, écoles de musique, de danse, de théâtre, de langues. Et chaque rôle du bureau."
  chemin="/pour-qui"
  fil={fil}
  faq={faq}
>
  <HerosCompact
    fil={fil}
    surtitre="Pour qui"
    titre="Toutes les associations qui inscrivent et cotisent"
    phrase="Club de foot, école de musique, troupe de théâtre : dès qu’il y a des inscriptions et des cotisations, le bureau y laisse ses soirées."
    cta={{ texte: 'Demander une démo', href: '/demo' }}
  />

  <section class="section" id="sports" aria-labelledby="t-sports">
    <div class="enveloppe">
      <div class="tete-ligne">
        <div class="section-tete">
          <h2 id="t-sports" class="h2-idee">Sports</h2>
          <p>Catégories tirées de la date de naissance, convocations, compo du match, licences.</p>
        </div>
        {sports.length > 10 && <a class="lien-fleche" href="#sports-az">Tous les sports ({sports.length}) <svg aria-hidden="true"><use href="#fleche"/></svg></a>}
      </div>
      <CartesCollection collection="sports" portrait limite={10} az={{ titre: 'Tous les sports, de A à Z', champ: 'Chercher un sport', id: 'sports-az' }} />
    </div>
  </section>

  <section class="section" id="activites" aria-labelledby="t-activites">
    <div class="enveloppe">
      <div class="tete-ligne">
        <div class="section-tete">
          <h2 id="t-activites" class="h2-idee">Autres activités</h2>
          <p>Des cours, des niveaux, des professeurs, des salles : les inscriptions de la rentrée, sans fiches à recopier.</p>
        </div>
        {activites.length > 10 && <a class="lien-fleche" href="#activites-az">Toutes les activités ({activites.length}) <svg aria-hidden="true"><use href="#fleche"/></svg></a>}
      </div>
      <CartesCollection collection="activites" portrait limite={10} az={{ titre: 'Toutes les activités, de A à Z', champ: 'Chercher une activité', id: 'activites-az' }} />
    </div>
  </section>

  <section class="section" id="profils" aria-labelledby="t-profils">
    <div class="enveloppe">
      <div class="section-tete">
        <h2 id="t-profils" class="h2-idee">Votre rôle</h2>
        <p>Ce que chaque rôle récupère, à commencer par le trésorier. Parent ou adhérent : transmettez à votre club.</p>
      </div>
      <ul class="pilules">
        {profils.map((e) => <li><a href={url('profils', e.id)}><b>{e.data.nom}</b><span>{e.data.ligne}</span></a></li>)}
        <li><a class="pilule-membre" href="/recommander"><b>Adhérent ou parent ?</b><span>Transmettre à mon club</span></a></li>
      </ul>
    </div>
  </section>

  <div class="section"><div class="enveloppe"><Faq items={faq} disposition="deux-colonnes" /></div></div>
  <CaseVide compact />
</Layout>
<style>
.tete-ligne{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:0 24px}
.tete-ligne .section-tete{margin-bottom:0}
.tete-ligne .lien-fleche{margin-bottom:4px}
.pilules{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:12px}
.pilules a{display:inline-flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;padding:10px 22px;border-radius:var(--r-m);background:var(--blanc);box-shadow:var(--ombre-carte);text-decoration:none;max-width:420px;transition:box-shadow var(--d-2) var(--courbe-sortie)}
.pilules a:hover{box-shadow:var(--ombre-carte-survol)}
.pilules b{font:700 1.125rem/1.2 var(--f-titre)}
.pilules span{font-size:var(--t-petit);color:var(--gris);line-height:1.4}
.pilules .pilule-membre{background:var(--lilas-pale);box-shadow:none}
.pilules .pilule-membre span{color:var(--encre);font-weight:600}
</style>
