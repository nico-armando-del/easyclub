---
/*
  L'ACCUEIL, ÉCRAN PAR ÉCRAN (maquettes §B.2, récit §1, arbitrages du plan).
  1. Le héros : le titre, une phrase, un bouton ; le produit en scène (trois
     vrais écrans, trois légendes cliquables, le temps rendu). Rien d'épinglé.
  2. Avec ou sans OnClub : la semaine du bureau, l'interrupteur que le visiteur
     bascule lui-même ; « Calculer pour mon association ».
  3. Les fonctionnalités en bento (une carte par famille).
  4. Le produit qui tourne : onglets verticaux et écran.
  5. Les sites de club de démonstration (vitrine).
  6. Les associations : la bande de photos, les clubs de sport d'abord
     (au moins 8), deux activités artistiques à la fin, « Et la vôtre ? ».
  7. Les offres : le temps d'abord. 8. La FAQ (six questions, JSON-LD).
  9. L'appel final : la case vide.
*/
import Layout from '../layouts/Layout.astro'
import SceneAccueil from '../components/SceneAccueil.astro'
import SemaineBureau from '../components/SemaineBureau.astro'
import MiniEcran from '../components/MiniEcran.astro'
import Bento from '../components/Bento.astro'
import OngletsProduit from '../components/OngletsProduit.astro'
import VitrineClubs from '../components/VitrineClubs.astro'
import BandeAssociations from '../components/BandeAssociations.astro'
import Offres from '../components/Offres.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import EcranTraduit from '../components/langue/EcranTraduit.astro'
import VersFr from '../components/langue/VersFr.astro'
import { cartesSports, cartesArts } from '../i18n/bande'
import { catalogue } from '../lib/collections'
import { MISE_EN_ROUTE } from '../data/site'
import { i18n, SR_FR } from '../i18n/ui'
import { ECRANS_ES } from '../i18n/accueil-es'

/*
  UNE SEULE PAGE POUR LES DEUX ACCUEILS : / et /es (src/pages/es.astro l'importe).
  Les phrases passent par t() (src/i18n/ui.ts) ; les textes en bloc du héros et de la
  semaine viennent de src/i18n/accueil-es.ts ; sur /es, les écrans animés sont remplacés
  par leur état final traduit (EcranTraduit), en attendant src/ecrans/es/.
*/
const { langue, t, lien, versFr } = i18n(Astro.url)
const es = langue === 'es'
/** Un lien vers une autre page : l'adresse dans la langue, et l'étiquette « FR » s'il reste en français. */
const vers = (chemin: string) => ({ href: lien(chemin), hreflang: versFr(chemin) ? 'fr' : undefined, fr: versFr(chemin) })

const ressources = [
  ...(await catalogue('guides', langue)).map((e) => ({ e, c: 'guides' as const })),
  ...(await catalogue('articles', langue)).map((e) => ({ e, c: 'articles' as const })),
  ...(await catalogue('comparatifs', langue)).map((e) => ({ e, c: 'comparatifs' as const })),
].slice(0, 3)

/* La bande : les clubs de sport d'abord (au moins 8), puis deux activités artistiques (Nico, 10 oct.). */
const bande = [...(await cartesSports(langue)), ...(await cartesArts(langue))]

/* L'inscription et la relance sont déjà dans le héros : les onglets montrent la suite. Le visiteur clique (rien ne s'enchaîne seul). */
const ONGLETS = [
  { id: 'rentree', libelle: t('Rentrée suivante'), ecran: 'reinscription' as const, phrase: t('La rentrée suivante, sans tout refaire.'), lien: { texte: t('Saison suivante'), href: '/fonctionnalites/saison-suivante' } },
  { id: 'compo', libelle: t('Compo du match'), ecran: 'terrain' as const, phrase: t('Le samedi, la compo se fait d’un geste.'), lien: { texte: t('Compo du match'), href: '/fonctionnalites/compo-du-match' } },
  { id: 'convocations', libelle: t('Convocations'), ecran: 'terrain' as const, phrase: t('La famille répond présent ou absent depuis le mail, sans compte.'), lien: { texte: t('Convocations en ligne'), href: '/fonctionnalites/convocations' } },
  { id: 'site', libelle: t('Site du club'), ecran: 'site' as const, phrase: t('Le site du club se met à jour sans prestataire.'), lien: { texte: t('Site de l’association'), href: '/fonctionnalites/site-association' } },
].map((o) => ({ ...o, lien: { texte: o.lien.texte, href: lien(o.lien.href) } }))
/* Sur /es, un onglet dont la page n'est pas encore traduite garde son lien français : l'étiquette « FR » est posée par OngletsProduit (versFr). */
const ongletsVersFr = es && ONGLETS.some((o) => !o.lien.href.startsWith('/es')) ? SR_FR : undefined

/* La FAQ : six questions, inchangées (arbitrage 14) ; le JSON-LD est construit à partir de la même liste. */
const faq = [
  { question: t('OnClub, c’est pour quelles associations ?'), reponse: t('Pour toutes celles qui inscrivent des adhérents, avec des équipes ou des cours et des cotisations : d’abord les clubs de sport (foot, basket, volley, judo, tennis…), aussi les écoles de musique, de danse, de théâtre, de langues, chorales, ateliers. Dans OnClub, chaque cours ou équipe a sa discipline, son niveau, ses encadrants, sa salle, ses créneaux, ses places et son tarif.') },
  { question: t('Combien coûte OnClub ?'), reponse: t('Un abonnement au pourcentage des cotisations encaissées en ligne : 2,90 % avec OnClub Mini, 4,90 % avec Pro, 6,90 % avec Pro Max IA, plus 2 % sur la boutique. Rien de fixe, et rien sur les chèques ni les espèces. Les frais de carte bancaire restent à la charge de l’association.') },
  { question: t('D’où viennent les 61 heures rendues ?'), reponse: t('C’est une estimation OnClub pour une association de 250 adhérents, pas une étude : 66 heures par saison aujourd’hui pour recopier les fiches, suivre les paiements, relancer, réclamer les pièces et préparer la rentrée, contre environ 5 heures avec OnClub. Le calcul et les hypothèses sont sur la page du temps gagné.') },
  { question: t('Les familles doivent-elles créer un compte ?'), reponse: t('Non. La famille remplit un seul formulaire pour tous ses membres, depuis son téléphone. Elle reçoit un récapitulatif par mail et retrouve ensuite son dossier par son lien. Pour une convocation, elle répond présent ou absent depuis le mail.') },
  { question: t('En combien de temps notre association est-elle en ligne ?'), reponse: `${t(MISE_EN_ROUTE)} ${t('Vous déposez le tableur de la saison passée : les anciens adhérents sont reconnus et reçoivent leur lien de réinscription.')}` },
  { question: t('Je suis adhérent ou parent : comment proposer OnClub à mon club ?'), reponse: t('Utilisez la page « Transmettre à mon club » : elle prépare un message court pour le bureau, à envoyer par WhatsApp ou par e-mail, avec ce que l’association y gagne. Vous n’avez rien à installer et rien à remplir pour nous.') },
]
const demo = vers('/demo')
const temps = vers('/temps-gagne')
const pourQui = vers('/pour-qui')
---
<Layout
  titre={t('OnClub : inscriptions et cotisations en ligne des clubs')}
  description={t('Club de sport ou association : OnClub met en ligne vos inscriptions, vos cotisations et vos relances. Foot, basket, volley, judo… et aussi la musique.')}
  chemin={lien('/')}
  faq={faq}
>
  <SceneAccueil
    titre={t('Association sportive ou artistique ? La paperasse, c’est fini')}
    phrase={t('OnClub met les inscriptions et les cotisations de votre club en ligne. Vos bénévoles reprennent leurs soirées.')}
    cta={{ texte: t('Demander une démo'), href: demo.href }}
    ctaVersFr={demo.fr ? SR_FR : undefined}
  >
    {es && <EcranTraduit slot="ecran-tel" x={ECRANS_ES.inscription} />}
    {es && <EcranTraduit slot="ecran-tab" x={ECRANS_ES.tableau} />}
  </SceneAccueil>

  <SemaineBureau versFr={temps.fr ? SR_FR : undefined}>
    {es && <EcranTraduit slot="ecran-0" x={ECRANS_ES.inscription} />}
    {es && <EcranTraduit slot="ecran-1" x={ECRANS_ES.tableau} />}
    {es && <EcranTraduit slot="ecran-2" x={ECRANS_ES.relance} />}
    {es && <EcranTraduit slot="ecran-4" x={ECRANS_ES.reinscription} />}
  </SemaineBureau>

  <section class="section" id="fonctionnalites" aria-labelledby="t-bento">
    <div class="enveloppe"><Bento /></div>
  </section>

  <section class="section" aria-labelledby="onglets-titre">
    <div class="enveloppe sur-encre">
      <OngletsProduit titre={t('Voyez-le tourner')} onglets={ONGLETS} legende={t('Noms et montants fictifs.')} versFr={ongletsVersFr} pause={{ pause: t('Mettre en pause'), reprise: t('Relancer l’animation') }}>
        {es ? <EcranTraduit slot="ecran-convocations" x={ECRANS_ES.convocations} /> : (
        <MiniEcran
          slot="ecran-convocations"
          association="Votre club"
          titre="Match · samedi 17 octobre à 14 h"
          sousTitre="U13 · 11 présents · 2 absents · 1 sans réponse"
          lignes={[
            { nom: 'Nathan Bernard', statut: 'Présent', ton: 'ok' },
            { nom: 'Hugo Arnaud', statut: 'Absent', ton: 'ko' },
            { nom: 'Enzo Garcia', statut: 'Sans réponse', ton: 'neutre' },
            { nom: 'Malo Chevalier', statut: 'Présent', ton: 'ok' },
          ]}
          bouton="Composer le match"
        />)}
        {es && <EcranTraduit slot="ecran-rentree" x={ECRANS_ES.reinscription} />}
        {es && <EcranTraduit slot="ecran-compo" x={ECRANS_ES.compo} />}
        {es && <EcranTraduit slot="ecran-site" x={ECRANS_ES.site} />}
      </OngletsProduit>
    </div>
  </section>

  <section class="section">
    <div class="enveloppe"><VitrineClubs /></div>
  </section>

  <section class="section accueil-bande" aria-labelledby="t-assos">
    <BandeAssociations
      titre={t('Foot, basket, judo, tennis. Et tous les autres')}
      phrase={t('Les clubs de sport d’abord. Aussi la musique et le théâtre : dès qu’il y a des inscriptions et des cotisations.')}
      items={bande}
      derniere={{ texte: t('Et la vôtre ?'), href: pourQui.href, nomAccessible: t('Et la vôtre ? Toutes les associations') }}
    />
  </section>

  <section class="section fond-blanc" aria-labelledby="t-offres">
    <div class="enveloppe">
      <div class="accueil-tete">
      <h2 class="h2-idee accueil-h2" id="t-offres">{t('Un pourcentage. Rien de fixe')}</h2>
      <p class="intro">{t('Un pourcentage des cotisations encaissées en ligne. Rien sur les chèques ni les espèces. Frais de carte à la charge de l’association.')}</p>
      </div>
      <div class="accueil-offres"><Offres mode="accueil" /></div>
      <a class="lien-fleche" href={lien('/tarifs')}>{t('Le détail des offres et un exemple chiffré')} <svg aria-hidden="true"><use href="#fleche"/></svg></a>
    </div>
  </section>

  <div class="section fond-blanc">
    <div class="enveloppe accueil-faq">
      <Faq items={faq} titre={t('Les questions du bureau')} disposition="deux-colonnes">
        {ressources.length > 0 && (
          <p class="accueil-guides">
            <span>{t('Des guides pour le bureau :')}</span>
            {ressources.map(({ e }) => <a href={e.url} hreflang={e.fr ? 'fr' : undefined}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a>)}
            <a class="lien-fleche" href={vers('/ressources').href} hreflang={vers('/ressources').hreflang}>{t('Toutes les ressources')}{vers('/ressources').fr && <VersFr sr={SR_FR} />} <svg aria-hidden="true"><use href="#fleche"/></svg></a>
          </p>
        )}
      </Faq>
    </div>
  </div>

  <CaseVide />
</Layout>

<style>
.accueil-h2{max-width:16ch}
@media (min-width:1000px){.accueil-tete{display:grid;grid-template-columns:5fr 7fr;gap:var(--e-7,48px);align-items:end}.accueil-tete .intro{margin:0}}
.accueil-offres{margin-top:40px}
.accueil-offres + .lien-fleche{margin-top:12px}
.accueil-guides{display:flex;flex-wrap:wrap;align-items:center;gap:4px 20px;margin-top:24px;font-size:.9375rem;color:var(--gris)}
.accueil-guides span{font-weight:600;color:var(--encre)}
.accueil-guides a:not(.lien-fleche){display:inline-flex;align-items:center;min-height:44px;font-weight:600;color:var(--encre);text-underline-offset:3px}
.accueil-guides .lien-fleche{color:var(--sapin)}
/* Six questions seulement : le titre reste en haut, face à la première (pas collant, il descendait seul dans le vide). */
.enveloppe.accueil-faq :global(.faq[data-disposition="deux-colonnes"] h2){position:static}
</style>
