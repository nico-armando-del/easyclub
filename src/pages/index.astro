---
/*
  L'ACCUEIL, ÉCRAN PAR ÉCRAN (maquettes §B.2, récit §1, arbitrages du plan).
  1. Le héros immersif : le titre, une phrase, un bouton ; la scène où le
     désordre se range (66 h → ≈ 5 h, 61 h rendues). Note et hypothèses.
  2. Le temps rendu : « Et chez vous ? », le champ « 250 ».
  3. Les fonctionnalités en bento (une carte par famille).
  4. Le produit qui tourne : onglets verticaux et écran.
  5. Les sites de club de démonstration (vitrine).
  6. Les associations : la bande de photos, « Et la vôtre ? ».
  7. Les offres : le temps d'abord. 8. La FAQ (six questions, JSON-LD).
  9. L'appel final : la case vide.
*/
import Layout from '../layouts/Layout.astro'
import SceneAccueil from '../components/SceneAccueil.astro'
import TempsRendu from '../components/TempsRendu.astro'
import Bento from '../components/Bento.astro'
import OngletsProduit from '../components/OngletsProduit.astro'
import VitrineClubs from '../components/VitrineClubs.astro'
import BandeAssociations from '../components/BandeAssociations.astro'
import Offres from '../components/Offres.astro'
import Faq from '../components/Faq.astro'
import CaseVide from '../components/CaseVide.astro'
import { photoDe } from '../data/photos'
import { liste, url } from '../lib/collections'
import { MISE_EN_ROUTE } from '../data/site'

const sports = await liste('sports')
const activites = await liste('activites')
const guides = await liste('guides')
const articles = await liste('articles')
const comparatifs = await liste('comparatifs')
const ressources = [
  ...guides.map((e) => ({ e, c: 'guides' as const })),
  ...articles.map((e) => ({ e, c: 'articles' as const })),
  ...comparatifs.map((e) => ({ e, c: 'comparatifs' as const })),
].slice(0, 3)

/* La bande : seulement les pages publiées qui ont une vraie photo, sport et culture mêlés (arbitrage 9). */
const ORDRE = ['football', 'volley', 'ecole-de-musique', 'handball', 'theatre', 'tennis', 'chorale', 'danse', 'judo', 'club-d-echecs', 'arts-plastiques', 'rugby']
const toutes = [...sports.map((e) => ({ e, c: 'sports' as const })), ...activites.map((e) => ({ e, c: 'activites' as const }))].filter(({ e }) => photoDe(e.id))
const bande = [...ORDRE.flatMap((id) => toutes.filter(({ e }) => e.id === id)), ...toutes.filter(({ e }) => !ORDRE.includes(e.id))]
  .slice(0, 12)
  .map(({ e, c }) => ({ nom: e.data.nom, href: url(c, e.id), photo: e.id, ligne: e.data.ligne }))

const ONGLETS = [
  { id: 'inscription', libelle: 'Inscription', ecran: 'inscription' as const, phrase: 'La famille s’inscrit depuis son canapé.', lien: { texte: 'Inscription en ligne', href: '/fonctionnalites/inscription-en-ligne' } },
  { id: 'relance', libelle: 'Relance', ecran: 'relance' as const, phrase: 'Un retard, un clic, une relance.', lien: { texte: 'Relance d’un clic', href: '/fonctionnalites/relance-un-clic' } },
  { id: 'rentree', libelle: 'Rentrée suivante', ecran: 'reinscription' as const, phrase: 'La rentrée suivante, sans tout refaire.', lien: { texte: 'Saison suivante', href: '/fonctionnalites/saison-suivante' } },
  { id: 'compo', libelle: 'Compo du match', ecran: 'terrain' as const, phrase: 'Le samedi, la compo se fait d’un geste.', lien: { texte: 'Compo du match', href: '/fonctionnalites/compo-du-match' } },
]

/* La FAQ : six questions, inchangées (arbitrage 14) ; le JSON-LD est construit à partir de la même liste. */
const faq = [
  { question: 'OnClub, c’est pour quelles associations ?', reponse: 'Pour toutes celles qui inscrivent des adhérents, avec des cours ou des équipes et des cotisations : clubs de sport, écoles de musique, de danse, de théâtre, de langues, chorales, ateliers. Dans OnClub, chaque cours ou équipe a sa discipline, son niveau, ses encadrants, sa salle, ses créneaux, ses places et son tarif.' },
  { question: 'Combien coûte OnClub ?', reponse: 'Un abonnement au pourcentage des cotisations encaissées en ligne : 2,90 % avec OnClub Mini, 4,90 % avec Pro, 6,90 % avec Pro Max IA, plus 2 % sur la boutique. Rien de fixe, et rien sur les chèques ni les espèces. Les frais de carte bancaire restent à la charge de l’association.' },
  { question: 'D’où viennent les 61 heures rendues ?', reponse: 'C’est une estimation OnClub pour une association de 250 adhérents, pas une étude : 66 heures par saison aujourd’hui pour recopier les fiches, suivre les paiements, relancer, réclamer les pièces et préparer la rentrée, contre environ 5 heures avec OnClub. Le calcul et les hypothèses sont sur la page du temps gagné.' },
  { question: 'Les familles doivent-elles créer un compte ?', reponse: 'Non. La famille remplit un seul formulaire pour tous ses membres, depuis son téléphone. Elle reçoit un récapitulatif par mail et retrouve ensuite son dossier par son lien. Pour une convocation, elle répond présent ou absent depuis le mail.' },
  { question: 'En combien de temps notre association est-elle en ligne ?', reponse: `${MISE_EN_ROUTE} Vos tableurs de la saison passée sont repris : les anciens adhérents sont reconnus et reçoivent leur lien de réinscription.` },
  { question: 'Je suis adhérent ou parent : comment proposer OnClub à mon club ?', reponse: 'Utilisez la page « Transmettre à mon club » : elle prépare un message court pour le bureau, à envoyer par WhatsApp ou par e-mail, avec ce que l’association y gagne. Vous n’avez rien à installer et rien à remplir pour nous.' },
]
---
<Layout
  titre="Inscriptions et cotisations d’association en ligne | OnClub"
  description="Marre de passer vos soirées sur l’administratif ? OnClub prend les inscriptions, les cotisations et les relances de votre association : sport, musique, danse."
  chemin="/"
  faq={faq}
  langues={true}
>
  <SceneAccueil
    titre="Association sportive ou artistique ? La paperasse, c’est fini"
    phrase="Inscriptions, cotisations, relances : tout se fait en ligne. Vos bénévoles reprennent leurs soirées."
    cta={{ texte: 'Demander une démo', href: '/demo' }}
  />

  <section class="section" aria-labelledby="t-temps">
    <div class="enveloppe"><TempsRendu /></div>
  </section>

  <section class="section" id="fonctionnalites" aria-labelledby="t-bento">
    <div class="enveloppe"><Bento /></div>
  </section>

  <section class="section" aria-labelledby="onglets-titre">
    <div class="enveloppe sur-encre">
      <OngletsProduit titre="Voyez-le tourner" onglets={ONGLETS} legende="Noms et montants fictifs." />
    </div>
  </section>

  <section class="section">
    <div class="enveloppe"><VitrineClubs /></div>
  </section>

  <section class="section accueil-bande" aria-labelledby="t-assos">
    <BandeAssociations
      titre="Foot, musique, théâtre. Et toutes les autres"
      phrase="Dès qu’il y a des inscriptions, des cours ou des équipes, et des cotisations."
      items={bande}
      derniere={{ texte: 'Et la vôtre ?', href: '/pour-qui', nomAccessible: 'Et la vôtre ? Toutes les associations' }}
    />
  </section>

  <section class="section fond-blanc" aria-labelledby="t-offres">
    <div class="enveloppe">
      <div class="accueil-tete">
      <h2 class="h2-idee accueil-h2" id="t-offres">Un pourcentage. Rien de fixe</h2>
      <p class="intro">Un pourcentage des cotisations encaissées en ligne. Rien sur les chèques ni les espèces. Frais de carte à la charge de l’association.</p>
      </div>
      <div class="accueil-offres"><Offres mode="accueil" /></div>
      <a class="lien-fleche" href="/tarifs">Le détail des offres et un exemple chiffré <svg aria-hidden="true"><use href="#fleche"/></svg></a>
    </div>
  </section>

  <div class="section fond-blanc">
    <div class="enveloppe">
      <Faq items={faq} titre="Les questions du bureau" disposition="deux-colonnes">
        {ressources.length > 0 && (
          <p class="accueil-guides">
            <span>Des guides pour le bureau&nbsp;:</span>
            {ressources.map(({ e, c }) => <a href={url(c, e.id)}>{e.data.nom}</a>)}
            <a class="lien-fleche" href="/ressources">Toutes les ressources <svg aria-hidden="true"><use href="#fleche"/></svg></a>
          </p>
        )}
      </Faq>
    </div>
  </div>

  <CaseVide />
</Layout>

<style>
.accueil-h2{max-width:16ch}
@media (min-width:1000px){.accueil-tete{display:grid;grid-template-columns:5fr 7fr;gap:var(--e-7,48px);align-items:end}.accueil-tete .intro{margin:0}}
.accueil-offres{margin-top:40px}
.accueil-offres + .lien-fleche{margin-top:12px}
.accueil-guides{display:flex;flex-wrap:wrap;align-items:center;gap:4px 20px;margin-top:24px;font-size:.9375rem;color:var(--gris)}
.accueil-guides span{font-weight:600;color:var(--encre)}
.accueil-guides a:not(.lien-fleche){display:inline-flex;align-items:center;min-height:44px;font-weight:600;color:var(--encre);text-underline-offset:3px}
.accueil-guides .lien-fleche{color:var(--sapin)}
</style>
