---
/*
  LE PARCOURS DE DÉMO, EN CINQ ÉTAPES. Aucune base de données, rien n'est
  stocké : les réponses ne vont que dans le message WhatsApp ou l'e-mail que
  la personne envoie elle-même.

  Avec JavaScript (public/js/demo.js) : une étape à la fois, le temps calculé
  à l'étape 4 (même calcul que le calculateur), les liens de l'étape 5
  préremplis avec les réponses. Sans JavaScript : les cinq étapes sont
  visibles d'un bloc, le formulaire s'envoie par e-mail (action mailto), et
  les liens directs restent là.

  Paramètres d'adresse acceptés : ?type=musique (étape 1 préchoisie) et
  ?offre=mini|pro|max (citée dans le message). Exemple : /demo?type=danse.

  Mise en page (maquettes §B.7) : une seule carte, les barres d'étapes, le compteur
  à l'étape 4, « Avant la démo » replié à côté. Les champs, les attributs data-* et
  public/js/demo.js ne changent pas. La carte porte le même view-transition-name
  que la case vide : on y arrive depuis l'appel final de chaque page.
*/
import Layout from '../layouts/Layout.astro'
import HerosCompact from '../components/HerosCompact.astro'
import ProgressionEtapes from '../components/ProgressionEtapes.astro'
import CompteurHeures from '../components/CompteurHeures.astro'
import Calculateur from '../components/Calculateur.astro'
import Repli from '../components/Repli.astro'
import { TYPES_ASSOCIATION, CE_QUI_PESE, EMAIL, lienWhatsApp, MESSAGE_DEMO } from '../data/site'
import { liste, url } from '../lib/collections'
import { ADHERENTS_REFERENCE, TOTAL } from '../data/temps'

const fonctions = await liste('fonctionnalites')
/* Ce qui pèse → les fonctionnalités qui y répondent (seulement celles qui existent). */
const REPONSES: Record<string, string[]> = {
  inscriptions: ['inscription-en-ligne', 'formulaire-sur-mesure', 'reinscriptions'],
  paiements: ['paiement-en-ligne', 'suivi-des-paiements', 'aides-deduites'],
  relances: ['relance-un-clic', 'suivi-des-paiements'],
  pieces: ['pieces-justificatives'],
  equipes: ['convocations', 'compo-du-match', 'espace-encadrant'],
  boutique: ['boutique-en-ligne', 'vente-au-comptoir'],
  site: ['site-association'],
}
const tuiles = Object.entries(REPONSES).flatMap(([cle, ids]) =>
  ids.map((id) => fonctions.find((f) => f.id === id)).filter(Boolean).map((f) => ({ cle, f: f! })),
)
const vus = new Set<string>()
const tuilesUniques = tuiles.filter((t) => (vus.has(t.f.id) ? false : (vus.add(t.f.id), true)))
const cles = (id: string) => tuiles.filter((t) => t.f.id === id).map((t) => t.cle).join(' ')
const fil = [{ nom: 'Demander une démo', url: '/demo' }]
---
<Layout
  titre="Demander une démo d’OnClub pour votre association"
  description="Cinq questions pour préparer votre démo d’OnClub : type d’association, nombre d’adhérents, ce qui pèse, le temps gagné, puis WhatsApp ou e-mail."
  chemin="/demo"
  fil={fil}
  sansBoutonFixe={true}
>
  <HerosCompact
    fil={fil}
    surtitre="Demander une démo"
    titre="Votre démo, préparée en cinq questions"
    phrase="Dites-nous qui vous êtes et ce qui vous prend le plus de temps : la démo commence par là."
  />

  <div class="enveloppe section-parcours">
    <form class="parcours" action={`mailto:${EMAIL}?subject=${encodeURIComponent('Démo OnClub')}`} method="post" enctype="text/plain" data-parcours>
      <ProgressionEtapes etapes={['Votre association', 'Adhérents', 'Ce qui pèse', 'Le temps gagné', 'Réserver']} actuelle={1} data-etapes-fil />

      <fieldset class="etape" data-etape="1" id="etape-1">
        <legend><span class="etape-num">Étape 1 sur 5</span>Quel type d’association ?</legend>
        <div class="choix-grille">
          {TYPES_ASSOCIATION.map((t, i) => (
            <label class="choix"><input type="radio" name="type" value={t.nom} data-type={t.cle} checked={i === 0}><span>{t.nom}</span></label>
          ))}
        </div>
        <div class="etape-nav"><button type="button" class="btn btn-encre" data-suivant>Continuer <svg aria-hidden="true"><use href="#fleche"/></svg></button></div>
      </fieldset>

      <fieldset class="etape" data-etape="2" id="etape-2">
        <legend><span class="etape-num">Étape 2 sur 5</span>Combien d’adhérents ?</legend>
        <p class="etape-aide">Joueurs, élèves, adhérents : un ordre de grandeur suffit.</p>
        <label class="champ-nombre"><span class="sr">Nombre d’adhérents</span><input type="number" name="adherents" min="10" max="5000" step="1" value={ADHERENTS_REFERENCE} inputmode="numeric" data-adherents></label>
        <div class="raccourcis" data-raccourcis hidden>
          {[50, 100, 250, 500, 1000].map((n) => <button type="button" class="btn btn-contour btn-petit" data-n={n}>{n}</button>)}
        </div>
        <div class="etape-nav"><button type="button" class="retour" data-retour>Étape précédente</button><button type="button" class="btn btn-encre" data-suivant>Continuer <svg aria-hidden="true"><use href="#fleche"/></svg></button></div>
      </fieldset>

      <fieldset class="etape" data-etape="3" id="etape-3">
        <legend><span class="etape-num">Étape 3 sur 5</span>Qu’est-ce qui vous prend le plus de temps ?</legend>
        <p class="etape-aide">Cochez tout ce qui compte.</p>
        <div class="choix-grille">
          {CE_QUI_PESE.map((c) => (
            <label class="choix"><input type="checkbox" name="pese" value={c.nom} data-pese={c.cle}><span>{c.nom}</span></label>
          ))}
        </div>
        <div class="etape-nav"><button type="button" class="retour" data-retour>Étape précédente</button><button type="button" class="btn btn-encre" data-suivant>Continuer <svg aria-hidden="true"><use href="#fleche"/></svg></button></div>
      </fieldset>

      <fieldset class="etape" data-etape="4" id="etape-4">
        <legend><span class="etape-num">Étape 4 sur 5</span>Le temps que votre association gagnerait</legend>
        <div class="compteur-boite" data-compteur-demo>
          <CompteurHeures deMin={TOTAL.avantMin} aMin={TOTAL.apresMin} libelleAvant="d’administratif aujourd’hui, par saison" libelleApres="d’administratif avec OnClub, par saison" declencheur="visible" />
        </div>
        <p class="etape-aide" data-resume-n>Calcul pour 250 adhérents.</p>
        <p class="etape-note">Estimation OnClub, pas une étude.</p>
        <Repli titre="Le détail du calcul">
          <Calculateur id="calc-demo" entree={false} grand />
        </Repli>
        <div class="reponses" data-reponses>
          <p class="reponses-titre">Ce qui répond à ce qui vous pèse</p>
          <ul class="reponses-liste">
            {tuilesUniques.map(({ f }) => (
              <li data-pour={cles(f.id)}><a href={url('fonctionnalites', f.id)} target="_blank" rel="noopener"><b>{f.data.nom}</b><span>{f.data.ligne}</span></a></li>
            ))}
          </ul>
        </div>
        <div class="etape-nav"><button type="button" class="retour" data-retour>Étape précédente</button><button type="button" class="btn btn-encre" data-suivant>Continuer <svg aria-hidden="true"><use href="#fleche"/></svg></button></div>
      </fieldset>

      <fieldset class="etape" data-etape="5" id="etape-5">
        <legend><span class="etape-num">Étape 5 sur 5</span>Réserver ma démo</legend>
        <p class="etape-aide">Deux champs facultatifs, puis le moyen qui vous arrange. Le message est déjà écrit avec vos réponses : vous le relisez avant de l’envoyer.</p>
        <div class="champs-fin">
          <label class="champ"><span>Nom de l’association <i>(facultatif)</i></span><input type="text" name="association" maxlength="80" autocomplete="organization" data-asso></label>
          <label class="champ"><span>Ville <i>(facultatif)</i></span><input type="text" name="ville" maxlength="60" autocomplete="address-level2" data-ville-champ data-ville></label>
        </div>
        <div class="reserver">
          <a class="btn btn-encre" href={lienWhatsApp()} target="_blank" rel="noopener" data-lien-wa><svg aria-hidden="true"><use href="#wa"/></svg>Réserver sur WhatsApp</a>
          <a class="lien-fleche" href={`mailto:${EMAIL}?subject=${encodeURIComponent('Démo OnClub')}&body=${encodeURIComponent(MESSAGE_DEMO)}`} data-lien-mail><svg aria-hidden="true"><use href="#courriel"/></svg>Réserver par e-mail</a>
          <button type="submit" class="btn btn-contour envoi-sansjs">Envoyer mes réponses par e-mail</button>
        </div>
        <details class="apercu repli" data-apercu-boite>
          <summary>Voir le message</summary>
          <pre data-apercu>{MESSAGE_DEMO}</pre>
        </details>
        <div class="etape-nav"><button type="button" class="retour" data-retour>Étape précédente</button></div>
      </fieldset>
    </form>

    <aside class="a-cote" aria-labelledby="t-ensuite">
      <h2 id="t-ensuite">Ce qui se passe ensuite</h2>
      <ol>
        <li>Nous vous répondons pour fixer un moment.</li>
        <li>La démo se fait sur vos cas : vos cours ou vos équipes, vos tarifs, vos questions.</li>
        <li>Si vous y allez, l’association est en ligne en quinze jours, avec une pré-livraison au dixième jour.</li>
      </ol>
      <p class="a-cote-note">Rien n’est enregistré sur ce site : vos réponses partent seulement dans le message que vous nous envoyez.</p>
      <Repli titre="Avant la démo">
        <ul class="avant">
          <li><a href="/tarifs">Les tarifs</a></li>
          <li><a href="/temps-gagne">Le calcul du temps gagné</a></li>
          <li><a href="/fonctionnalites">Les fonctionnalités</a></li>
        </ul>
      </Repli>
      <p class="a-cote-membre">Adhérent ou parent ? <a href="/recommander">Transmettre à mon club</a></p>
    </aside>
  </div>
  <script is:inline defer src="/js/demo.js"></script>
</Layout>

<script>
  /*
    Étape 4 : le compteur suit le calcul que demo.js fait faire au calculateur
    (« ≈ 66 h » → « ≈ 5 h » pour 250 adhérents). Rien d'autre ne change dans le parcours.
  */
  const boite = document.querySelector<HTMLElement>('[data-compteur-demo]')
  const calc = document.getElementById('calc-demo')
  const cpt = boite?.querySelector<HTMLElement>('[data-cpt]')
  const avant = calc?.querySelector('[data-calc-avant]')
  const apres = calc?.querySelector('[data-calc-apres]')
  if (boite && cpt && avant && apres) {
    const nombre = (t: string | null) => parseFloat((t || '').replace(/[^0-9,.]/g, '').replace(',', '.')) || 0
    const suit = () => {
      const a = (avant.textContent || '').replace('≈', '').trim()
      const b = (apres.textContent || '').trim()
      const val = cpt.querySelector<HTMLElement>('.cpt-val')
      const span = val?.querySelector('span')
      if (!val || !span || (val.dataset.avant === a && span.textContent === b)) return
      val.dataset.avant = a
      span.textContent = b
      const r = Math.max(0.02, Math.min(1, nombre(b) / (nombre(a) || 1)))
      cpt.style.setProperty('--ratio', r.toFixed(3))
      if (cpt.classList.contains('cpt-joue')) { cpt.classList.remove('cpt-joue'); void cpt.offsetWidth; cpt.classList.add('cpt-joue') }
    }
    new MutationObserver(suit).observe(apres, { childList: true, characterData: true, subtree: true })
  }
</script>

<style>
.section-parcours{display:grid;gap:var(--e-7);padding-block:0 var(--section)}
@media (min-width:1040px){.section-parcours{grid-template-columns:repeat(12,minmax(0,1fr));gap:0 var(--col-gap);align-items:start}.parcours{grid-column:1 / span 8}.a-cote{grid-column:9 / span 4}}
.parcours{display:grid;gap:var(--e-5);min-width:0;background:var(--blanc);border-radius:var(--r-xl);box-shadow:var(--ombre-carte);padding:var(--e-5) 20px;view-transition-name:case-vide}
@media (min-width:760px){.parcours{padding:var(--e-7)}}
.etape legend:focus{outline:none}
.etape{border:0;padding:0;margin:0;min-width:0}
:global(.js) .etape:not(.active):not([data-etape="1"]),:global(.js) .parcours:has(.etape.active) .etape[data-etape="1"]:not(.active){display:none} /* l’étape 1 visible dès le premier affichage : pas de décalage quand le script démarre */
:global(html:not(.js)) .etape+.etape{border-top:1px solid var(--trait);padding-top:var(--e-6)}
.etape legend{float:left;width:100%;padding:0;font:700 clamp(1.5rem,1.2rem + 1vw,1.75rem)/1.15 var(--f-titre);margin-bottom:20px}
.etape legend+*{clear:both}
.etape-num{display:block;font:700 var(--t-micro)/1.3 var(--f-texte);letter-spacing:.06em;text-transform:uppercase;color:var(--sapin);margin-bottom:8px}
.etape-aide{color:var(--gris);margin-bottom:18px;max-width:var(--lecture)}
.choix-grille{display:grid;gap:10px}
@media (min-width:600px){.choix-grille{grid-template-columns:1fr 1fr}}
.choix{display:flex;align-items:center;gap:12px;min-height:56px;padding:12px 16px;border:2px solid var(--trait);border-radius:14px;cursor:pointer;font-weight:600;background:var(--papier)}
.choix:has(input:checked){border-color:var(--encre);background:var(--menthe-pale)}
.choix input{width:22px;height:22px;accent-color:var(--sapin);flex:none;margin:0}
.champ-nombre input{width:100%;max-width:240px;min-height:64px;border:2px solid var(--encre);border-radius:14px;padding:0 18px;font:800 2rem var(--f-titre);background:var(--papier);color:var(--encre)}
.raccourcis{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.raccourcis[hidden]{display:none}
:global(.js) .raccourcis{display:flex}
.etape-nav{display:none;justify-content:space-between;align-items:center;gap:12px;margin-top:28px;flex-wrap:wrap}
:global(.js) .etape-nav{display:flex}
.etape-nav [data-suivant]{margin-left:auto}
.retour{display:inline-flex;align-items:center;min-height:44px;padding:0;background:none;border:0;color:var(--encre);font:600 1rem/1.2 var(--f-texte);text-decoration:underline;text-underline-offset:4px;cursor:pointer}
.compteur-boite{--cpt-piste:var(--papier-2);--cpt-taille:clamp(3.5rem,2.4rem + 4vw,5.5rem);padding:var(--e-5);border-radius:var(--r-l);background:var(--papier);margin-bottom:var(--e-4)}
.compteur-boite :global(.cpt-barre){max-width:360px}
.etape-note{margin:-8px 0 16px;font-size:var(--t-petit);color:var(--gris)}
.etape :global(.calculateur){border:0;box-shadow:none;padding:0;background:transparent}
.etape :global(.repli){max-width:none}
.reponses{margin-top:28px}
.reponses-titre{font:700 1.125rem/1.3 var(--f-titre)}
.reponses-liste{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:10px}
@media (min-width:700px){.reponses-liste{grid-template-columns:1fr 1fr}}
.reponses-liste li[hidden]{display:none}
.reponses-liste a{display:grid;gap:2px;padding:14px 16px;background:var(--papier);border-radius:var(--r-s);text-decoration:none;min-height:44px}
.reponses-liste b{font:700 1.0625rem/1.25 var(--f-titre)}
.reponses-liste span{font-size:.9375rem;color:var(--gris)}
.champs-fin{display:grid;gap:16px}
@media (min-width:700px){.champs-fin{grid-template-columns:1fr 1fr}}
.champ span{display:block;font-weight:700;margin-bottom:6px}
.champ i{font-style:normal;font-weight:500;color:var(--gris)}
.champ input{width:100%;min-height:52px;border:2px solid var(--encre);border-radius:12px;padding:0 14px;font:500 1.0625rem var(--f-texte);background:var(--papier);color:var(--encre)}
.champ input:focus,.champ-nombre input:focus{outline:none;box-shadow:0 0 0 3px var(--menthe)}
.reserver{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin-top:24px}
@media (max-width:599px){.reserver .btn{width:100%}}
:global(.js) .envoi-sansjs{display:none}
.apercu{margin-top:18px}
.apercu pre{white-space:pre-wrap;font:500 .9375rem/1.5 var(--f-texte);background:var(--papier);border-radius:var(--r-s);padding:16px;margin:8px 0 0}
.a-cote{padding:var(--e-2) 0 0}
@media (min-width:1040px){.a-cote{position:sticky;top:calc(var(--entete-h) + 24px);padding:var(--e-5) 0 0 var(--e-2)}}
.a-cote h2{font-size:1.5rem}
.a-cote ol{margin:16px 0 20px;padding-left:1.2em;display:grid;gap:10px}
.a-cote-note{font-size:var(--t-petit);color:var(--gris);margin-bottom:var(--e-5)}
.avant{list-style:none;padding:0;margin:0}
.avant a{display:inline-flex;align-items:center;min-height:44px;font-weight:700}
.a-cote-membre{margin-top:var(--e-5);font-size:var(--t-petit)}
.a-cote-membre a{font-weight:700;display:inline-flex;align-items:center;min-height:44px}
</style>
