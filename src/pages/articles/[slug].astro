---
/* Une page par fichier de src/content/articles/. Le gabarit éditorial : components/GabaritEditorial.astro. */
import GabaritEditorial from '../../components/GabaritEditorial.astro'
import { liste } from '../../lib/collections'
export async function getStaticPaths() {
  const entrees = await liste('articles')
  return entrees.map((entree) => ({ params: { slug: entree.id }, props: { entree } }))
}
const { entree } = Astro.props
---
<GabaritEditorial collection="articles" entree={entree} />
