---
/* Une page par fichier de src/content/sports/. Le gabarit : components/GabaritProduit.astro (maquettes §B.3). */
import GabaritProduit from '../../components/GabaritProduit.astro'
import { liste } from '../../lib/collections'
export async function getStaticPaths() {
  const entrees = await liste('sports')
  return entrees.map((entree) => ({ params: { slug: entree.id }, props: { entree } }))
}
const { entree } = Astro.props
---
<GabaritProduit collection="sports" entree={entree} />
