---
/*
  « TRANSMETTRE À MON CLUB » : pour l'adhérent, l'élève ou le parent. Pas
  d'annuaire, pas de recherche de club : un message prêt à envoyer au bureau,
  par WhatsApp (la personne choisit le contact), par e-mail ou par le partage
  du téléphone. Rien n'est envoyé à OnClub, rien n'est stocké.
  Si la localisation a été acceptée, la ville entre dans le message.
  Logique : public/js/recommander.js (inchangée).
  Mise en page (maquettes §B.7) : un écran. À gauche le titre, le champ, le bouton ;
  à droite le message tel qu'il partira, dans une bulle qui s'écrit en direct
  (sur téléphone : la bulle seule, sous le champ). « Modifier le message » replié.
*/
import Layout from '../layouts/Layout.astro'
import FilAriane from '../components/FilAriane.astro'
import Repli from '../components/Repli.astro'
import Faq from '../components/Faq.astro'
import { SITE } from '../data/site'

const message = `Bonjour, je suis adhérent du club. J’ai vu OnClub, une plateforme pour les associations : les familles s’inscrivent et paient en ligne, le bureau relance d’un bouton et ne recopie plus de fiches. Leur estimation, pas une étude : environ 61 heures rendues aux bénévoles chaque saison pour 250 adhérents. Ça pourrait nous aider ? ${SITE}`
const morceaux = message.split('61 heures')
const fil = [{ nom: 'Transmettre à mon club', url: '/recommander' }]
const faq = [
  { question: 'Est-ce que mon club saura que le message vient d’OnClub ?', reponse: 'Le message part de votre téléphone ou de votre messagerie, à votre nom, vers la personne que vous choisissez. OnClub ne reçoit rien et ne contacte pas votre club de lui-même.' },
  { question: 'Qu’est-ce que ça change pour moi, adhérent ou parent ?', reponse: 'Vous vous inscrivez depuis votre téléphone, toute la famille dans un seul formulaire, vous payez en une ou plusieurs fois par carte, vous déposez le certificat en photo et vous répondez aux convocations en un clic, sans créer de compte.' },
  { question: 'Combien ça coûte au club ?', reponse: 'Un pourcentage des cotisations encaissées en ligne, de 2,90 % à 6,90 % selon l’offre, rien de fixe et rien sur les chèques ni les espèces. Le détail est sur la page des tarifs, à transmettre au trésorier.' },
]
---
<Layout
  titre="Proposer OnClub à son club ou son association"
  description="Adhérent, élève ou parent : envoyez au bureau de votre association un message prêt à partir, avec le temps que les bénévoles gagneraient avec OnClub."
  chemin="/recommander"
  fil={fil}
  faq={faq}
  sansBoutonFixe={true}
>
  <div class="enveloppe ecran" data-recommander data-heros data-ville-usage>
    <div class="ecran-tete">
      <FilAriane fil={fil} />
      <p class="surtitre">Adhérent, élève ou parent</p>
      <h1>Vos bénévoles méritent leurs soirées. <span class="nw">Dites-le</span> à votre club</h1>
      <p class="chapo">Le bureau court après les fiches, les chèques et les certificats ? Envoyez-lui ce message, de chez vous, à la personne de votre choix.</p>
    </div>

    <label class="champ ecran-champ"><span>Le nom de votre club <i>(facultatif)</i></span><input type="text" maxlength="80" data-club autocomplete="off"></label>

    <div class="ecran-bulle">
      <div class="tel" aria-hidden="true">
        <div class="tel-ecran">
          <div class="bulle" data-bulle>{morceaux[0]}{morceaux.length > 1 && <><mark>61 heures</mark>{morceaux.slice(1).join('61 heures')}</>}</div>
        </div>
      </div>
      <p class="bulle-legende">Le message tel qu’il partira. 61 h : estimation OnClub pour 250 adhérents, pas une étude.</p>
    </div>

    <div class="ecran-actions">
      <div class="partager">
        <a class="btn btn-encre" href={`https://wa.me/?text=${encodeURIComponent(message)}`} target="_blank" rel="noopener" data-wa data-envoi><svg aria-hidden="true"><use href="#wa"/></svg>Envoyer sur WhatsApp</a>
        <a class="lien-fleche" href={`mailto:?subject=${encodeURIComponent('Une idée pour le club : OnClub')}&body=${encodeURIComponent(message)}`} data-mail data-envoi><svg aria-hidden="true"><use href="#courriel"/></svg>Envoyer par e-mail</a>
        <button type="button" class="action-texte" data-partage hidden><svg aria-hidden="true"><use href="#partage"/></svg>Partager</button>
        <button type="button" class="action-texte" data-copier hidden>Copier le message</button>
      </div>
      <Repli titre="Modifier le message">
        <label class="champ"><span>Le message</span><textarea rows="7" data-message data-base={message}>{message}</textarea></label>
      </Repli>
      <p class="message-ville" hidden data-ville-note></p>
      <p class="note" aria-live="polite" data-etat>Rien n’est envoyé à OnClub : WhatsApp ou votre messagerie s’ouvre, vous choisissez le destinataire.</p>
    </div>
  </div>

  <section class="section ce-que" aria-labelledby="t-change">
    <div class="enveloppe">
      <h2 id="t-change" class="h2-idee">Pour vous, pour le bureau</h2>
      <div class="ce-que-grille">
        <div>
          <h3>Pour vous</h3>
          <ul>
            <li>S’inscrire depuis le canapé, toute la famille d’un coup.</li>
            <li>Payer en plusieurs fois, par carte.</li>
            <li>Déposer le certificat en photo.</li>
            <li>Répondre à une convocation en un clic, sans compte.</li>
          </ul>
        </div>
        <div>
          <h3>Pour le bureau</h3>
          <ul>
            <li>Plus de fiches à recopier.</li>
            <li>L’argent à jour sans tableur.</li>
            <li>Une relance d’un bouton.</li>
            <li>La rentrée suivante sans tout refaire.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="section"><div class="enveloppe">
    <Faq items={faq} disposition="deux-colonnes">
      <p class="liens-fin">À transmettre aussi : <a href="/tarifs">les tarifs</a>, <a href="/temps-gagne">le calcul du temps gagné</a>, <a href="/fonctionnalites">les fonctionnalités</a>. Vous êtes au bureau ? <a href="/demo">Demander une démo</a>.</p>
    </Faq>
  </div></div>
  <script is:inline defer src="/js/recommander.js"></script>
</Layout>

<script>
  /*
    La bulle recopie le message tel qu'il partira (recommander.js l'écrit dans le champ),
    « 61 heures » surligné. Au retour sur la page après un envoi, la note remercie.
  */
  const boite = document.querySelector<HTMLElement>('[data-recommander]')
  const zone = boite?.querySelector<HTMLTextAreaElement>('[data-message]')
  const bulle = boite?.querySelector<HTMLElement>('[data-bulle]')
  const etat = boite?.querySelector<HTMLElement>('[data-etat]')
  if (boite && zone && bulle) {
    const ecrit = () => {
      bulle.textContent = ''
      zone.value.split('61 heures').forEach((morceau, i) => {
        if (i > 0) { const m = document.createElement('mark'); m.textContent = '61 heures'; bulle.append(m) }
        bulle.append(morceau)
      })
    }
    const plusTard = () => setTimeout(ecrit, 0)
    boite.addEventListener('input', plusTard)
    document.addEventListener('onclub:ville', plusTard)
    plusTard()
    let envoye = false
    boite.querySelectorAll('[data-envoi]').forEach((a) => a.addEventListener('click', () => { envoye = true }))
    document.addEventListener('visibilitychange', () => {
      if (envoye && document.visibilityState === 'visible' && etat) {
        etat.textContent = 'Merci. Le bureau vous devra peut-être quelques soirées.'
        envoye = false
      }
    })
  }
</script>

<style>
.ecran{display:grid;gap:var(--e-5);padding-block:var(--e-5) var(--section)}
@media (min-width:1000px){
  .ecran{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:var(--col-gap);row-gap:var(--e-5);align-items:start;padding-top:var(--e-7)}
  .ecran-tete,.ecran-champ,.ecran-actions{grid-column:1 / span 8}
  .ecran-bulle{grid-column:9 / span 4;grid-row:1 / span 3}
}
.ecran-tete .surtitre{margin-top:var(--e-4);color:var(--sapin)}
.ecran-tete h1{font-size:var(--t-h1-produit);line-height:1.06;letter-spacing:-.02em;max-width:20ch}
/* Le h1 tient sur deux lignes à 1280 et 1440 (G4, tour 2 défaut 41) : colonne de 8/12, taille plafonnée. */
@media (min-width:1000px){.ecran-tete h1{max-width:none;font-size:min(var(--t-h1-produit),2.75rem);text-wrap:balance}}
.ecran-tete .chapo{margin-top:var(--e-4);color:var(--gris)}
.champ span{display:block;font-weight:700;margin-bottom:6px}
.champ i{font-style:normal;font-weight:500;color:var(--gris)}
.champ input,.champ textarea{width:100%;min-height:52px;border:2px solid var(--encre);border-radius:12px;padding:12px 14px;font:500 1rem/1.5 var(--f-texte);background:var(--blanc);color:var(--encre)}
.champ textarea{resize:vertical}
.champ input:focus,.champ textarea:focus{outline:none;box-shadow:0 0 0 3px var(--menthe)}
.ecran-champ{max-width:520px}
/* La bulle : seule sur téléphone, dans un cadre de téléphone dès 1000 px (sans marque, sans rond). */
.tel-ecran{background:var(--papier-2);border-radius:var(--r-l);padding:20px 16px}
.bulle{background:var(--blanc);border-radius:var(--r-m) var(--r-m) var(--r-m) 6px;padding:14px 16px;font-size:var(--t-petit);line-height:1.5;box-shadow:var(--ombre-carte);max-width:34ch;overflow-wrap:anywhere}
.bulle :global(mark){background:var(--menthe-pale);color:var(--sapin);font-weight:700;padding:0 3px;border-radius:4px}
.bulle-legende{margin-top:var(--e-3);font-size:var(--t-micro);color:var(--gris)}
@media (min-width:1000px){
  .tel{width:300px;min-height:600px;margin-inline:auto;border:10px solid var(--encre);border-radius:var(--r-appareil);background:var(--papier-2);box-shadow:var(--ombre-appareil);position:relative;padding-top:44px;overflow:hidden}
  .tel::before{content:"";position:absolute;top:10px;left:35%;width:30%;height:22px;border-radius:999px;background:var(--encre)}
  .tel-ecran{border-radius:0;padding:16px 14px}
  .bulle-legende{text-align:center}
}
.partager{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px}
@media (max-width:599px){.partager .btn{width:100%}}
.partager [hidden]{display:none}
.action-texte{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0;background:none;border:0;color:var(--encre);font:700 1rem/1.2 var(--f-texte);text-decoration:underline;text-underline-offset:4px;cursor:pointer}
.action-texte svg{width:18px;height:18px}
.ecran-actions{display:grid;gap:var(--e-4)}
.ecran-actions :global(.repli){max-width:560px}
.message-ville{font-size:.9375rem;color:var(--sapin);font-weight:600}
.ce-que{padding-top:0}
.ce-que-grille{display:grid;gap:var(--col-gap);margin-top:var(--e-6)}
@media (min-width:760px){.ce-que-grille{grid-template-columns:1fr 1fr}}
.ce-que-grille>div{background:var(--blanc);border-radius:var(--r-l);box-shadow:var(--ombre-carte);padding:24px}
.ce-que-grille ul{margin-top:12px;padding-left:1.2em;display:grid;gap:8px}
.liens-fin{margin-top:var(--e-6);max-width:var(--lecture)}
.liens-fin a{font-weight:700}
</style>
