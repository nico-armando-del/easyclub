---
/*
  « TRANSMETTRE À MON CLUB » : pour l'adhérent, l'élève ou le parent. Pas
  d'annuaire, pas de recherche de club : un message prêt à envoyer au bureau,
  par WhatsApp (la personne choisit le contact), par e-mail ou par le partage
  du téléphone. Rien n'est envoyé à OnClub, rien n'est stocké.
  Si la localisation a été acceptée, la ville entre dans le message.
  Logique : public/js/recommander.js.
*/
import Layout from '../layouts/Layout.astro'
import FilAriane from '../components/FilAriane.astro'
import BlocTemps from '../components/BlocTemps.astro'
import EcranAnime from '../components/EcranAnime.astro'
import Faq from '../components/Faq.astro'
import { SITE } from '../data/site'
import { CINQ_TACHES } from '../data/temps'

const message = `Bonjour, je suis adhérent du club. J’ai vu OnClub, une plateforme pour les associations : les familles s’inscrivent et paient en ligne, le bureau relance d’un bouton et ne recopie plus de fiches. Leur estimation : environ 61 heures rendues aux bénévoles chaque saison pour 250 adhérents. Ça pourrait nous aider ? ${SITE}`
const fil = [{ nom: 'Transmettre à mon club', url: '/recommander' }]
const faq = [
  { question: 'Est-ce que mon club saura que le message vient d’OnClub ?', reponse: 'Le message part de votre téléphone ou de votre messagerie, à votre nom, vers la personne que vous choisissez. OnClub ne reçoit rien et ne contacte pas votre club de lui-même.' },
  { question: 'Qu’est-ce que ça change pour moi, adhérent ou parent ?', reponse: 'Vous vous inscrivez depuis votre téléphone, toute la famille dans un seul formulaire, vous payez en une ou plusieurs fois par carte, vous déposez le certificat en photo et vous répondez aux convocations en un clic, sans créer de compte.' },
  { question: 'Combien ça coûte au club ?', reponse: 'Un pourcentage des cotisations encaissées en ligne, de 2,90 % à 6,90 % selon l’offre, rien de fixe et rien sur les chèques ni les espèces. Le détail est sur la page des tarifs, à transmettre au trésorier.' },
]
---
<Layout
  titre="Proposer OnClub à son club ou son association"
  description="Adhérent, élève ou parent : envoyez au bureau de votre association un message prêt à partir, avec le temps que les bénévoles gagneraient avec OnClub."
  chemin="/recommander"
  fil={fil}
  faq={faq}
>
  <div class="tete-page">
    <div class="enveloppe tete-grille">
      <div>
        <FilAriane fil={fil} />
        <p class="surtitre">Adhérent, élève ou parent</p>
        <h1>Vos bénévoles méritent leurs soirées. <span class="insec">Dites-le</span> à votre club.</h1>
        <p class="chapo">Vous voyez le bureau courir après les fiches, les chèques et les certificats&nbsp;? Envoyez-lui ce message&nbsp;: il part de chez vous, vers la personne de votre choix.</p>
      </div>
    </div>
  </div>

  <div class="enveloppe corps">
    <section class="boite-message" aria-labelledby="t-message" data-recommander>
      <h2 id="t-message">Le message, prêt à partir</h2>
      <label class="champ"><span>Le nom de votre club <i>(facultatif)</i></span><input type="text" maxlength="80" data-club autocomplete="off"></label>
      <label class="champ"><span>Le message</span><textarea rows="7" data-message data-base={message}>{message}</textarea></label>
      <p class="message-ville" hidden data-ville-note></p>
      <div class="partager">
        <a class="btn btn-encre" href={`https://wa.me/?text=${encodeURIComponent(message)}`} target="_blank" rel="noopener" data-wa><svg aria-hidden="true"><use href="#wa"/></svg>Envoyer sur WhatsApp</a>
        <a class="btn btn-contour" href={`mailto:?subject=${encodeURIComponent('Une idée pour le club : OnClub')}&body=${encodeURIComponent(message)}`} data-mail><svg aria-hidden="true"><use href="#courriel"/></svg>Envoyer par e-mail</a>
        <button type="button" class="btn btn-contour" data-partage hidden><svg aria-hidden="true"><use href="#partage"/></svg>Partager</button>
        <button type="button" class="btn btn-contour" data-copier hidden>Copier le message</button>
      </div>
      <p class="note" aria-live="polite" data-etat>Rien n’est envoyé à OnClub&nbsp;: WhatsApp ou votre messagerie s’ouvre, vous choisissez le destinataire.</p>
    </section>

    <section class="ce-que" aria-labelledby="t-change">
      <h2 id="t-change">Ce que ça change, pour vous et pour le bureau</h2>
      <div class="ce-que-grille">
        <div>
          <h3>Pour vous</h3>
          <ul>
            <li>S’inscrire depuis le canapé, toute la famille d’un coup.</li>
            <li>Payer en plusieurs fois, par carte.</li>
            <li>Déposer le certificat en photo.</li>
            <li>Répondre à une convocation en un clic, sans compte.</li>
          </ul>
        </div>
        <div>
          <h3>Pour les bénévoles</h3>
          <ul>
            <li>Plus de fiches à recopier.</li>
            <li>L’argent à jour sans tableur.</li>
            <li>Une relance d’un bouton.</li>
            <li>La rentrée suivante sans tout refaire.</li>
          </ul>
        </div>
      </div>
      <EcranAnime nom="inscription" legende="L’inscription vue par la famille, données fictives." />
    </section>

    <BlocTemps cles={CINQ_TACHES} titre="Le temps rendu aux bénévoles, pour 250 adhérents" />

    <Faq items={faq} />

    <p class="liens-fin">À transmettre aussi&nbsp;: <a href="/tarifs">les tarifs</a>, <a href="/temps-gagne">le calcul du temps gagné</a>, <a href="/fonctionnalites">les fonctionnalités</a>, <a href="/presentation">la présentation</a>. Vous êtes au bureau&nbsp;? <a href="/demo">Demander une démo</a>.</p>
  </div>
  <script is:inline defer src="/js/recommander.js"></script>
</Layout>

<style>
.tete-page{background:var(--lilas);padding-block:8px calc(var(--section) * .7)}
.tete-page .surtitre{margin-top:20px}
.tete-page h1{max-width:20ch}
.insec{white-space:nowrap}
.corps{display:grid;gap:clamp(56px,7vw,88px);padding-block:var(--section)}
.boite-message{background:var(--blanc);border:2px solid var(--encre);border-radius:var(--r-l);padding:24px;box-shadow:0 6px 0 var(--encre);max-width:860px;display:grid;gap:18px}
@media (min-width:760px){.boite-message{padding:36px 40px}}
.boite-message h2{font-size:clamp(1.5rem,1.2rem + 1.2vw,2.125rem)}
.champ span{display:block;font-weight:700;margin-bottom:6px}
.champ i{font-style:normal;font-weight:500;color:var(--gris)}
.champ input,.champ textarea{width:100%;min-height:52px;border:2px solid var(--encre);border-radius:12px;padding:12px 14px;font:500 1rem/1.5 var(--f-texte);background:var(--papier);color:var(--encre)}
.champ textarea{resize:vertical}
.champ input:focus,.champ textarea:focus{outline:none;box-shadow:0 0 0 3px var(--menthe)}
.message-ville{font-size:.9375rem;color:var(--sapin);font-weight:600}
.partager{display:grid;gap:12px}
@media (min-width:700px){.partager{grid-template-columns:1fr 1fr}}
.partager [hidden]{display:none}
.ce-que h2{font-size:clamp(1.75rem,1.4rem + 1.4vw,2.5rem)}
.ce-que-grille{display:grid;gap:20px;margin:28px 0 48px}
@media (min-width:760px){.ce-que-grille{grid-template-columns:1fr 1fr}}
.ce-que-grille>div{background:var(--blanc);border-radius:var(--r-l);padding:24px}
.ce-que-grille ul{margin-top:12px;padding-left:1.2em;display:grid;gap:8px}
.liens-fin{max-width:var(--lecture)}
.liens-fin a{font-weight:700}
</style>
