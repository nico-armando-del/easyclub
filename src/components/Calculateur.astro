---
/*
  « COMBIEN DE TEMPS VOTRE ASSOCIATION VA GAGNER ? »
  Rendu au build pour 250 adhérents : la page est complète sans JavaScript.
  public/js/calculateur.js recalcule pour le nombre saisi, avec la même
  méthode que calculer() (src/data/temps.ts) : quatre tâches proportionnelles
  au nombre d'adhérents, la rentrée suivante fixe (12 h → 2 h).

  compact (accueil, écran « Et chez vous ? ») : le seul total rendu, en géant,
  et le nombre d'adhérents en champ dans la phrase. Même donnée
  (data-calculateur, lue par scripts/controle_seo.py), même méthode, dans un
  script en ligne de quelques lignes ; data-calc-pret écarte
  public/js/calculateur.js. Sans JS, le champ est en lecture seule (250).
*/
import { calculer, duree, TACHES, CINQ_TACHES, ADHERENTS_REFERENCE } from '../data/temps'
import { i18n } from '../i18n/ui'
interface Props {
  grand?: boolean; id?: string; entree?: boolean
  /** Version en une phrase (accueil). */
  compact?: boolean
  /** Mots de la version compacte (français par défaut ; /en et /es). */
  mots?: { avant: string; apres: string; etiquette: string }
  /** Sur /temps-gagne : la note renvoie aux hypothèses juste en dessous, pas à la page elle-même. */
  surPageTemps?: boolean
}
const { t, lien, langue } = i18n(Astro.url)
const {
  grand = false, id = 'calculateur', entree = true, compact = false, surPageTemps = false,
  mots = { avant: t('rendues chaque saison, pour'), apres: t('adhérents.'), etiquette: t('Nombre d’adhérents') },
} = Astro.props
const r = calculer(ADHERENTS_REFERENCE)
const h = (m: number) => `${Math.round(m / 60)} h`
const donnees = JSON.stringify(CINQ_TACHES.map((c) => ({ cle: c, avant: TACHES[c].avantMin, apres: TACHES[c].apresMin, prop: TACHES[c].proportionnelle })))
---
{compact ? (
<div class="calc-compact" id={id} data-calculateur={donnees} data-calc-pret="1" data-calc-compact>
  <p class="cc-chiffre num"><span aria-live="polite" data-cc-gain>{h(r.gain)}</span></p>
  <i class="cc-barre" aria-hidden="true"></i>
  <p class="cc-phrase">{mots.avant} <label class="sr" for={`${id}-n`}>{mots.etiquette}</label><input id={`${id}-n`} class="cc-champ num" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" size="4" autocomplete="off" value={ADHERENTS_REFERENCE} readonly data-cc-n> {mots.apres}</p>
</div>
<script is:inline>
(function(){document.querySelectorAll('[data-calc-compact]').forEach(function(r){var t=JSON.parse(r.getAttribute('data-calculateur')),c=r.querySelector('[data-cc-n]'),o=r.querySelector('[data-cc-gain]'),f,der=250;c.readOnly=false;function lu(){return parseInt(c.value.replace(/\D/g,''),10)}function maj(n){var k=n/250,g=0;t.forEach(function(x){g+=(x.avant-x.apres)*(x.prop?k:1)});o.textContent=Math.round(g/60)+' h'}c.addEventListener('input',function(){clearTimeout(f);f=setTimeout(function(){var v=lu();if(v>=10&&v<=5000){der=v;maj(v)}},150)});c.addEventListener('change',function(){var v=lu();if(isNaN(v))v=der;v=Math.max(10,Math.min(5000,v));c.value=v;der=v;maj(v)})})})()
</script>
) : (
<div class:list={['calculateur', { grand, 'sans-entree': !entree }]} id={id} data-calculateur={donnees}>
  <div class="calc-gauche">
  <div class="calc-entree">
    <label for={`${id}-n`}>{t('Nombre d’adhérents de votre association')}</label>
    <div class="calc-champs">
      <input id={`${id}-n`} type="number" inputmode="numeric" min="10" max="5000" step="1" value={ADHERENTS_REFERENCE} data-calc-n>
      <input type="range" min="10" max="1500" step="10" value={ADHERENTS_REFERENCE} aria-label={t('Nombre d’adhérents, curseur')} data-calc-curseur>
    </div>
    <p class="calc-sansjs">{t('Calcul affiché pour {n} adhérents.', { n: ADHERENTS_REFERENCE })}</p>
  </div>
  <!-- Les trois totaux sous le curseur, dans la colonne de gauche (tour 2, défaut 14). -->
  <div class="calc-totaux" aria-live="polite">
    <div><span>{t('Aujourd’hui')}</span><b class="num" data-calc-avant>≈ {h(r.avant)}</b></div>
    <div><span>{t('Avec OnClub')}</span><b class="num" data-calc-apres>≈ {h(r.apres)}</b></div>
    <div class="calc-gain"><span>{t('Rendues chaque saison')}</span><b class="num" data-calc-gain>≈ {h(r.gain)}</b></div>
  </div>
  </div>
  <div class="calc-resultat" aria-live="polite">
    <table class="calc-table">
      <caption class="sr">{t('Les cinq tâches recalculées')}</caption>
      <thead><tr><th scope="col">{t('Tâche')}</th><th scope="col">{t('Aujourd’hui')}</th><th scope="col">{t('Avec OnClub')}</th></tr></thead>
      <tbody>
        {r.lignes.map((l) => (
          <tr data-calc-ligne={l.cle}><th scope="row">{t(l.tache)}</th><td class="num" data-avant>{duree(l.avant, langue)}</td><td class="num" data-apres>{duree(l.apres, langue)}</td></tr>
        ))}
      </tbody>
    </table>
    {surPageTemps
      ? <p class="calc-note">{t('Estimation, pas une promesse : la méthode et les hypothèses sont')} <a href="#hypotheses">{t('juste en dessous')}</a>.</p>
      : <p class="calc-note">{t('Estimation, pas une promesse : la méthode et les hypothèses sont sur')} <a href={lien('/temps-gagne#hypotheses')}>{t('la page du temps gagné')}</a>.</p>}
  </div>
</div>
)}
{!compact && <script is:inline defer src="/js/calculateur.js"></script>}
<style>
.calc-compact{display:grid;gap:14px;justify-items:start}
.cc-chiffre{font:800 clamp(4.5rem,2rem + 10vw,10rem)/.9 var(--f-titre);letter-spacing:-.03em;color:var(--encre)}
.cc-barre{display:block;width:min(100%,360px);height:10px;border-radius:999px;background:var(--menthe)}
.cc-phrase{font-size:clamp(1.125rem,1rem + .5vw,1.25rem);line-height:1.5;max-width:26em}
.cc-champ{display:inline-block;width:4.5ch;min-height:44px;margin:0 .15em;padding:0 .1em;border:0;border-bottom:2px dotted var(--encre);border-radius:0;background:transparent;font:700 1em/1 var(--f-titre);color:var(--encre);text-align:center;vertical-align:baseline}
.cc-champ:focus{outline:none;background:var(--papier-2,#EDE8DC);box-shadow:0 0 0 3px var(--menthe)}
.calculateur{background:var(--blanc);border:1px solid var(--trait);border-radius:var(--r-l);padding:24px;display:grid;gap:28px;box-shadow:0 18px 40px -26px rgba(11,15,20,.38)}
@media (min-width:960px){.calculateur.grand{grid-template-columns:.8fr 1.2fr;padding:40px;gap:48px}}
.sans-entree .calc-entree{display:none}
@media (min-width:960px){.calculateur.grand.sans-entree{grid-template-columns:1fr}}
.calc-entree label{display:block;font:700 1.25rem/1.25 var(--f-titre)}
.calc-champs{display:grid;gap:14px;margin-top:14px}
.calc-champs input[type=number]{width:100%;max-width:220px;min-height:56px;border:1px solid var(--trait);border-radius:14px;padding:0 16px;font:700 1.5rem var(--f-titre);background:var(--papier);color:var(--encre)}
.calc-champs input[type=number]:focus{outline:none;box-shadow:0 0 0 3px var(--menthe)}
.calc-champs input[type=range]{width:100%;accent-color:var(--sapin);min-height:44px}
.calc-sansjs{margin-top:8px;font-size:.9375rem;color:var(--gris)}
:global(.js) .calc-sansjs{display:none}
.calc-champs{display:none}
:global(.js) .calc-champs{display:grid}
.calc-gauche{display:grid;gap:24px;align-content:start;min-width:0}
.calc-totaux{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.calc-totaux div{background:var(--papier);border-radius:var(--r-s);padding:14px}
.calc-totaux span{display:block;font-size:.875rem;color:var(--gris)}
.calc-totaux b{display:block;font:700 clamp(1.5rem,1.2rem + 1vw,2.25rem)/1.1 var(--f-titre)}
.calc-totaux .calc-gain{grid-column:1/-1;background:var(--menthe)}
.calc-totaux .calc-gain span{color:var(--encre)}
.calc-table{width:100%;border-collapse:collapse;font-size:.9375rem}
.calc-table th,.calc-table td{padding:10px 6px;border-bottom:1px solid var(--trait);text-align:left;vertical-align:top}
.calc-table thead th{font-size:.8125rem;text-transform:uppercase;letter-spacing:.06em;color:var(--gris)}
.calc-table td{white-space:nowrap;font-weight:700}
.calc-table tbody th{font-weight:500}
@media (max-width:520px){.calc-table tbody th{width:58%}.calc-table thead th{letter-spacing:0;text-transform:none;font-size:.875rem}}
.calc-note{margin-top:14px;font-size:.875rem;color:var(--gris)}
.calc-note a{font-weight:700}
</style>
