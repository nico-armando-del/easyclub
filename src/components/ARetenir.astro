---
/*
  « À RETENIR », en tête du texte d'un guide ou d'un article (maquettes §B.5).
  Les phrases viennent du champ `aRetenir` (3 à 5, 140 caractères au plus).
  Rien ne s'affiche si le champ est absent. Le titre est un h2 exclu du sommaire
  (le sommaire ne lit que les titres du texte MDX).
*/
interface Props { items?: string[] }
const { items = [] } = Astro.props
---
{items.length > 0 && (
  <section class="a-retenir" aria-labelledby="a-retenir-titre">
    <h2 class="ar-titre" id="a-retenir-titre">À retenir</h2>
    <ul class="ar-liste">
      {items.map((i) => (
        <li><svg class="ar-coche" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><path d="M3.5 9.5l3.6 3.4L14.5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{i}</span></li>
      ))}
    </ul>
  </section>
)}
<style>
.a-retenir{background:var(--papier);border-radius:var(--r-m,20px);padding:24px 22px}
@media (min-width:760px){.a-retenir{padding:28px 32px}}
.a-retenir>h2.ar-titre{margin:0;font:700 1.5rem/1.15 var(--f-titre);letter-spacing:-.01em}
.a-retenir>ul.ar-liste{list-style:none;padding:0;margin:16px 0 0;display:grid;gap:12px;max-width:none}
.ar-liste li{display:grid;grid-template-columns:18px minmax(0,1fr);gap:12px;align-items:start;font-size:1.0625rem;line-height:1.55;margin:0}
.ar-coche{margin-top:4px;color:var(--sapin)}
</style>
