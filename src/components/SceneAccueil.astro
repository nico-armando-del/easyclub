---
/*
  LE HÉROS DE L'ACCUEIL : LE PRODUIT EN SCÈNE (concept A retenu le 10 oct. 2026,
  après « au scroll ça va trop vite » et « on comprend pas bien » de Nico).

  Le titre, une phrase, un bouton. Dessous, un panneau encre où trois vrais
  écrans d'OnClub sont posés en profondeur : (1) le téléphone de la famille qui
  s'inscrit (écran animé), (2) le tableau de bord du trésorier (figé sur son
  accueil), (3) la relance telle que la famille la reçoit. Une carte dit le
  temps rendu (src/data/temps.ts, jamais tapé). Trois légendes cliquables
  expliquent chaque écran ; un clic met l'écran en avant, un second rend la scène.

  Le mouvement : une entrée lente au chargement (1,1 s, 180 ms d'écart), une
  fois. RIEN n'est épinglé, rien ne s'enchaîne seul : au défilement, la scène se
  redresse seulement (8°) pendant qu'elle entre (scroll-timeline, repli
  IntersectionObserver). L'écran animé s'arrête hors de la vue ; le bouton
  « Mettre en pause » l'arrête pour de bon (WCAG 2.2.2), via
  public/js/ecrans-ctrl.js, chargé ici AVANT les scripts des écrans (en différé).
  Sous mouvement réduit : tout est à sa place, l'écran montre son état final.

  Pages traduites (/en, /es) : mêmes props ; `t` porte les textes, et les slots
  « ecran-tel » et « ecran-tab » remplacent les écrans français.
*/
import EcranAnime from './EcranAnime.astro'
import EcranFige from './EcranFige.astro'
import VersFr from './langue/VersFr.astro'
import { TOTAL, ADHERENTS_REFERENCE, PART_RENDUE } from '../data/temps'
import { i18n } from '../i18n/ui'
import { SCENE_ES } from '../i18n/accueil-es'

export type TextesScene = {
  legendes: [{ titre: string; phrase: string }, { titre: string; phrase: string }, { titre: string; phrase: string }]
  groupe: string
  tableau: string
  relance: { asso: string; quand: string; objet: string; texte: string; aria: string }
  temps: { avant: string; rendu: string; part?: string; note: string; lien: string }
  pause: string
  reprise: string
  /** La ligne des sports sous le titre : les clubs de sport d'abord (Nico, 10 oct., 14 h 22). */
  sports?: { liste: { texte: string; href?: string }[]; aussi: string }
}

const FR: TextesScene = {
  legendes: [
    { titre: 'La famille s’inscrit', phrase: 'Depuis son téléphone : chaque enfant, son équipe ou son cours, la cotisation par carte, ou étalée.' },
    { titre: 'Le trésorier voit tout', phrase: 'Ce qui est encaissé, à venir ou en retard, sans tableur à tenir.' },
    { titre: 'Un retard, une relance', phrase: 'Le message est prêt : vous le relisez, il part d’un clic.' },
  ],
  groupe: 'Ce que montre la scène',
  tableau: 'Le tableau de bord du club : 28 640 euros encaissés sur 40 395 attendus, quatre points à traiter. Montants fictifs.',
  relance: {
    asso: 'Volley Club Démo',
    quand: 'maintenant',
    objet: '110 € en retard de règlement',
    texte: 'Bonjour Sophie, il manque 110 € sur l’inscription de Léna : la tranche du 28 septembre 2026 n’est pas arrivée.',
    aria: 'La relance reçue par la famille : Volley Club Démo, 110 euros en retard de règlement. Données fictives.',
  },
  temps: {
    avant: 'd’administratif par saison',
    rendu: 'rendues au bureau',
    part: `soit ${PART_RENDUE.fr} de l’administratif en moins`,
    note: `Estimation pour ${ADHERENTS_REFERENCE} adhérents, pas une étude.`,
    lien: 'Le calcul',
  },
  pause: 'Mettre en pause',
  reprise: 'Relancer l’animation',
  sports: {
    liste: [
      { texte: 'Foot', href: '/sport/football' },
      { texte: 'basket', href: '/sport/basket' },
      { texte: 'volley', href: '/sport/volley' },
      { texte: 'handball', href: '/sport/handball' },
      { texte: 'judo', href: '/sport/judo' },
      { texte: 'tennis', href: '/sport/tennis' },
    ],
    aussi: 'et aussi la musique et le théâtre.',
  },
}

interface Props {
  titre: string
  phrase: string
  cta: { texte: string; href: string }
  t?: TextesScene
  /** /en, /es : « OnClub is a French platform… », sous le bouton. */
  noteLangue?: string
  idTitre?: string
  /** /en, /es : le bouton mène à une page en français (étiquette « FR »). */
  ctaVersFr?: string
  /** Où mène « Le calcul » (la semaine du bureau, juste dessous). */
  lienCalcul?: string
}
const { langue, lien, versFr } = i18n(Astro.url)
const { titre, phrase, cta, noteLangue, idTitre = 'titre', ctaVersFr, lienCalcul = '#semaine' } = Astro.props
/* Sur /es : les textes de src/i18n/accueil-es.ts ; un sport n'est lien que si sa page espagnole existe. */
const t: TextesScene = Astro.props.t ?? (langue === 'es'
  ? { ...SCENE_ES, sports: SCENE_ES.sports && { ...SCENE_ES.sports, liste: SCENE_ES.sports.liste.map((x) => ({ texte: x.texte, href: x.href && !versFr(x.href) ? lien(x.href) : undefined })) } }
  : FR)
const NBESP = langue === 'es'
const NB = String.fromCharCode(160)
const fine = (s: string) => (NBESP ? s : s.replace(/ ([?!:;€])/g, `${NB}$1`)).replace(/(\d) (h|€|min)\b/g, `$1${NB}$2`)
/* Le titre en deux temps : une ligne par phrase, aussi sur téléphone. */
const coupe = titre.match(/^(.+?[?.!])\s+(.+)$/)
const parties = coupe ? [fine(coupe[1]), fine(coupe[2])] : [fine(titre)]
/* Un slot passé sous condition ({es && <X slot="ecran-tel" />}) existe même vide sur la page
   française : on regarde son rendu, pas sa présence, sinon l'accueil français perd ses écrans. */
const rendu = async (nom: string) => (Astro.slots.has(nom) ? (await Astro.slots.render(nom)).trim() : '')
const telHtml = await rendu('ecran-tel')
const tabHtml = await rendu('ecran-tab')
const telTraduit = telHtml !== ''
const tabTraduit = tabHtml !== ''
const sigle = t.relance.asso.split(/\s+/).filter((m) => m.length > 3 || /^[A-Z]/.test(m)).map((m) => m[0].toUpperCase()).join('').slice(0, 2)
---
<script is:inline src="/js/ecrans-ctrl.js"></script>
<section class="heros" data-heros data-sans-bouton-fixe aria-labelledby={idTitre}>
  <div class="heros-texte">
    <h1 id={idTitre}>{parties.map((p, i) => <span class="h1-partie">{i > 0 ? ' ' : ''}{p}</span>)}</h1>
    {t.sports && (
      <p class="heros-sports"><span class="hs-liste">{t.sports.liste.map((x, i, a) => <>{i > 0 && (i === a.length - 1 ? `,${NB}` : ', ')}{x.href ? <a href={x.href}>{x.texte}</a> : x.texte}</>)}…</span> <span class="hs-aussi">{t.sports.aussi}</span></p>
    )}
    <p class="heros-phrase">{fine(phrase)}</p>
    <a class="btn btn-encre heros-btn" href={cta.href} hreflang={ctaVersFr ? 'fr' : undefined}>{cta.texte}{ctaVersFr && <VersFr sr={ctaVersFr} />} <svg aria-hidden="true"><use href="#fleche"/></svg></a>
    {noteLangue && <p class="heros-langue">{fine(noteLangue)}</p>}
  </div>

  <div class="scene" id="scene" data-scene>
    <div class="plateau">
      <div class="couche c-tab" style="--i:0" role="img" aria-label={t.tableau}>
        <div class="c-in">
          <span class="repere" aria-hidden="true">2</span>
          {tabTraduit ? (
            <div class="echelle traduit" data-echelle style="--l:760;--h:450"><div class="echelle-in"><Fragment set:html={tabHtml} /></div></div>
          ) : (
            <div class="echelle fenetre" data-echelle style="--l:880;--h:520"><div class="echelle-in"><EcranFige nom="relance" /></div></div>
          )}
        </div>
      </div>
      <div class="couche c-tel" style="--i:1">
        <div class="c-in">
          <span class="repere" aria-hidden="true">1</span>
          {telTraduit ? (
            <div class="echelle traduit" data-echelle style="--l:420;--h:700"><div class="echelle-in"><Fragment set:html={telHtml} /></div></div>
          ) : (
            <div class="echelle" data-echelle style="--l:340;--h:640"><div class="echelle-in"><EcranAnime nom="inscription" /></div></div>
          )}
        </div>
      </div>
      <div class="couche c-notif" style="--i:2">
        <div class="c-in">
          <span class="repere" aria-hidden="true">3</span>
          <div class="notif" role="img" aria-label={t.relance.aria}>
            <p class="n-tete"><span class="n-sig" aria-hidden="true">{sigle}</span><b>{t.relance.asso}</b><span class="n-quand">{t.relance.quand}</span></p>
            <p class="n-objet">{fine(t.relance.objet)}</p>
            <p class="n-texte">{fine(t.relance.texte)}</p>
          </div>
        </div>
      </div>
      <div class="couche c-temps" style="--i:3">
        <div class="c-in temps">
          <p class="t-avant"><b>{TOTAL.avant}&nbsp;→ {TOTAL.apres}</b> {fine(t.temps.avant)}</p>
          <p class="t-gros"><b class="num">{TOTAL.gain}</b><span>{t.temps.rendu}</span></p>
          {t.temps.part && <p class="t-part">{fine(t.temps.part)}</p>}
          <span class="t-barre" aria-hidden="true"><i></i></span>
          <p class="t-note">{fine(t.temps.note)} <a href={lienCalcul}>{t.temps.lien}</a></p>
        </div>
      </div>
    </div>
    <div class="scene-pied">
      <button class="pause" type="button" aria-pressed="false" data-pause-ecrans data-pause={t.pause} data-reprise={t.reprise}><svg class="i-pause" viewBox="0 0 14 14" aria-hidden="true"><path fill="currentColor" d="M3 2h3v10H3zM8 2h3v10H8z"/></svg><svg class="i-lecture" viewBox="0 0 14 14" aria-hidden="true"><path fill="currentColor" d="M3 2l9 5-9 5z"/></svg><span data-texte>{t.pause}</span></button>
    </div>
  </div>

  <div class="legendes" role="group" aria-label={t.groupe}>
    {t.legendes.map((l, k) => (
      <button class="leg" type="button" aria-pressed="false" aria-controls="scene" data-cible={['tel', 'tab', 'notif'][k]}><span class="num-leg" aria-hidden="true">{k + 1}</span><span><b>{fine(l.titre)}</b><span class="l">{fine(l.phrase)}</span></span></button>
    ))}
  </div>
</section>
<script is:inline>
(function () {
  var scene = document.getElementById('scene'); if (!scene) return
  var legs = [].slice.call(document.querySelectorAll('.legendes .leg'))
  var mm = window.matchMedia, reduit = !!(mm && mm('(prefers-reduced-motion: reduce)').matches)
  /* Les légendes : un clic met un écran en avant, un second clic rend toute la scène. */
  legs.forEach(function (b) {
    b.addEventListener('click', function () {
      var on = b.getAttribute('aria-pressed') !== 'true'
      legs.forEach(function (x) { x.setAttribute('aria-pressed', 'false') })
      if (on) { b.setAttribute('aria-pressed', 'true'); scene.setAttribute('data-focus', b.getAttribute('data-cible')) }
      else scene.removeAttribute('data-focus')
      /* L'écran mis en avant doit se voir : sur téléphone, les écrans sont l'un sous l'autre. */
      var cible = on && scene.querySelector('.c-' + b.getAttribute('data-cible'))
      if (cible) {
        var r = cible.getBoundingClientRect(), pl = cible.parentNode.getBoundingClientRect(), mode = reduit ? 'auto' : 'smooth'
        /* Téléphone : les écrans glissent côte à côte ; on amène celui de la légende. */
        if (r.left < pl.left || r.right > pl.right + 1) cible.parentNode.scrollTo({ left: cible.offsetLeft - 20, behavior: mode })
        if (r.top < 0 || r.bottom > window.innerHeight) scene.scrollIntoView({ behavior: mode, block: 'center' })
      }
    })
  })
  /* Repli sans animation-timeline : la scène se redresse une fois, quand elle entre. */
  var IO = window.IONatif || window.IntersectionObserver
  if (reduit || !IO || (window.CSS && CSS.supports && CSS.supports('animation-timeline', 'view()'))) return
  scene.classList.add('repli-io')
  new IO(function (es, o) { if (es[0].isIntersecting) { scene.classList.add('vue'); o.disconnect() } }, { threshold: .3 }).observe(scene)
})()
</script>

<style>
/* ---- Le texte ---- */
.heros-texte{max-width:var(--max);margin:0 auto;padding:28px var(--g) 0;display:flex;flex-direction:column;align-items:flex-start}
h1{font-size:clamp(2.125rem,1.15rem + 4.4vw,4.6875rem);line-height:1;font-weight:800;letter-spacing:-.025em;max-width:none;text-wrap:balance}
.h1-partie{display:block}
.heros-sports{margin-top:14px;font:700 clamp(1.0625rem,1rem + .35vw,1.25rem)/1.4 var(--f-titre);color:var(--sapin);max-width:34em;text-wrap:balance}
/* Six liens d'affilée : pas de soulignement au repos (la ligne resterait en pointillés), il revient au survol et au focus. */
.heros-sports a{color:inherit;text-decoration:none;text-underline-offset:4px;text-decoration-thickness:1.5px}
.heros-sports a:hover,.heros-sports a:focus-visible{text-decoration:underline}
.hs-aussi{font:500 .9375em var(--f-texte);color:var(--gris)}
.heros-phrase{margin-top:16px;font-size:var(--t-chapo);line-height:1.5;color:var(--gris);max-width:34em;text-wrap:pretty}
.heros-btn{margin-top:24px}
.heros-langue{margin-top:14px;font-size:.875rem;color:var(--gris);max-width:40em}
@media (max-width:759px){.heros-btn{align-self:stretch}}
@media (min-width:760px){
  .heros-texte{align-items:center;text-align:center;padding-top:56px}
  .heros-sports{margin-top:18px}
  .heros-phrase{margin-top:18px}
  .heros-btn{margin-top:30px}
}

/* ---- La scène ---- */
.scene{position:relative;margin:36px 16px 0;border-radius:var(--r-panneau);background-color:var(--scene);background-image:var(--lueur),var(--lueur-haut);color:var(--blanc);overflow:hidden;padding:24px 16px 16px}
@media (min-width:760px){.scene{width:calc(100% - 80px);max-width:var(--max-large);margin:52px auto 0;padding:40px 40px 24px}}
.plateau{position:relative;display:grid;gap:22px;max-width:1120px;margin:0 auto;transform-origin:50% 0}
.couche{position:relative;min-width:0}
.c-in{position:relative;transition:opacity var(--d-3) var(--courbe-sortie)}
/* Téléphone : les écrans l'un sous l'autre, rien ne se recouvre. Le téléphone en grand ;
   le tableau de bord recadré sur l'argent (lisible) ; la relance ; le temps rendu. */
.c-tel{justify-self:center;width:min(260px,80%);order:-1}
.c-tab .fenetre{--cx:216;--cy:50;--cw:372;--ch:350}
.c-tab .traduit{--l:440!important;--h:440!important}
/* Écrans traduits (HTML fluide) : on les compose à la largeur voulue, sans vide sous le contenu. */
.c-tel .traduit{--h:500!important}
/* Téléphone (défaut 2 du 10 oct. : rien hors du cadre, aucun mot coupé) : tout se voit sans
   glisser. Le téléphone de la famille à gauche ; à droite, le temps rendu puis l'argent du
   tableau de bord, recadré sur sa carte ; la relance en dessous, sur toute la largeur. */
@media (max-width:759px){
  .scene{padding:18px 14px 12px}
  .plateau{grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:14px 12px;align-items:start}
  .c-tel{order:0;grid-column:1;grid-row:1 / span 2;width:100%;justify-self:stretch}
  .c-temps{grid-column:2;grid-row:1}
  .c-tab{grid-column:2;grid-row:2}
  .c-notif{grid-column:1 / -1;grid-row:3}
  .c-tab .fenetre{--cx:227;--cy:156;--cw:361;--ch:248;border-radius:12px}
  .temps{padding:12px 12px 10px;border-radius:14px}
  .t-avant{font-size:.75rem}
  .t-gros{margin-top:4px;gap:2px 6px}
  .t-gros b{font-size:2.125rem}
  .t-gros span{font-size:.8125rem}
  .t-barre{margin-top:8px;height:5px}
  .t-note{font-size:.75rem}
  .scene-pied{margin-top:10px}
  /* Écrans traduits (/en, /es) : la carte d'inscription est courte ; le tableau de bord passe
     dessous, sur toute la largeur, et le repère 1 va au coin droit, hors du logo. */
  .plateau:has(.traduit) .c-tel{grid-row:1}
  .plateau:has(.traduit) .c-tab{grid-column:1 / -1;grid-row:2}
  .c-tel:has(.traduit) .repere{left:auto;right:-10px}
}
/* Tablette : le téléphone à gauche, les trois autres à droite, en colonne. */
@media (min-width:760px) and (max-width:1099px){
  .plateau{grid-template-columns:minmax(0,34%) minmax(0,1fr);column-gap:28px;align-items:start}
  .c-tel{grid-column:1;grid-row:1 / span 3;width:100%}
  .c-tab,.c-notif,.c-temps{grid-column:2}
  .c-tab .fenetre{--cx:200;--cy:34;--cw:680;--ch:486}
  .c-tab .traduit{--l:620!important;--h:440!important}
}
/* Ordinateur : la scène en profondeur, mais sans recouvrement d'un contenu : le téléphone à
   gauche, le tableau de bord (sans sa barre latérale) au centre, le temps et la relance à droite. */
@media (min-width:1100px){
  .plateau{display:block;height:560px}
  /* Écrans traduits, plus courts : la scène se resserre. */
  .plateau:has(.traduit){height:460px}
  .couche{position:absolute}
  .c-tel{left:0;top:44px;width:22%}
  .c-tab{left:24.5%;top:24px;width:51%}
  .c-tab .fenetre{--cx:200;--cy:34;--cw:680;--ch:486}
  .c-tab .traduit{--l:760!important;--h:440!important}
  /* La carte traduite s'aligne sur le haut du tableau de bord. */
  .c-tel:has(.traduit){top:24px}
  .c-temps{right:0;top:0;width:23%;z-index:4}
  .c-notif{right:0;bottom:16px;width:24.5%;z-index:4}
}
.fenetre{border-radius:14px;box-shadow:0 50px 90px -40px rgba(0,0,0,.8)}
.c-tel .c-in{filter:drop-shadow(0 40px 40px rgba(0,0,0,.45))}
/* Le premier écran du site ne montre pas d'erreur : le rappel rouge « aucun cours sélectionné »
   du formulaire vide est retiré de la scène (public/ecrans reste intact). */
.c-tel :global(.eci-err){visibility:hidden}
.traduit{border-radius:var(--r-l)}
.traduit :global(.ml-cadre){max-width:none;box-shadow:none}

/* Le repère numéroté de chaque écran (carré, jamais rond) */
.repere{position:absolute;z-index:6;display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--menthe);color:var(--encre);font:800 .875rem/1 var(--f-titre);box-shadow:0 6px 16px -6px rgba(0,0,0,.6)}
/* Posé sur le coin du cadre, jamais sur un contenu. */
.c-tel .repere,.c-tab .repere,.c-notif .repere{left:-10px;top:-10px}
/* Écran traduit (carte blanche, sans cadre de téléphone) : le repère passe au-dessus du cadre, hors du logo. */
@media (min-width:760px){.c-tel:has(.traduit) .repere{top:-14px;left:-14px;transform:translateY(-50%)}}

/* La relance, telle que la famille la reçoit */
.notif{background:#FAFAF7;color:var(--encre);border-radius:18px;padding:12px 14px;box-shadow:0 30px 50px -24px rgba(0,0,0,.7);font-size:.8125rem;line-height:1.35}
.n-tete{display:flex;align-items:center;gap:8px;font-size:.75rem;color:var(--gris)}
.n-sig{width:22px;height:22px;border-radius:6px;background:#0F3D2A;color:var(--menthe);display:grid;place-items:center;font:800 .625rem var(--f-titre);flex:none}
.n-tete b{color:var(--encre);font-weight:700}
.n-quand{margin-left:auto}
.n-objet{margin-top:8px;font:700 .875rem/1.25 var(--f-titre)}
.n-texte{margin-top:3px;color:var(--gris)}
@media (max-width:759px){.notif{padding:12px 14px;border-radius:14px}.c-tab .repere{left:auto;right:-10px}}
@media (min-width:760px){.notif{padding:14px 16px;font-size:.875rem}.n-objet{font-size:.9375rem}}

/* La carte du temps rendu */
.temps{background:var(--blanc);color:var(--encre);border-radius:18px;padding:14px 16px;box-shadow:0 30px 50px -24px rgba(0,0,0,.7)}
.t-avant{font-size:.8125rem;font-weight:600;color:var(--gris);line-height:1.3}
.t-avant b{color:var(--encre);font-weight:700}
.t-gros{margin-top:6px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.t-gros b{font:800 2.5rem/1 var(--f-titre);letter-spacing:-.02em;color:var(--sapin)}
.t-gros span{font:700 .9375rem/1.2 var(--f-titre)}
.t-barre{display:block;height:6px;margin-top:10px;background:#E7E2D6;border-radius:999px;overflow:hidden}
.t-barre i{display:block;height:100%;width:92%;background:var(--menthe);border-radius:inherit}
.t-part{margin-top:6px;font:700 .9375rem/1.25 var(--f-titre);color:var(--encre)}
.t-note{margin-top:8px;font-size:.8125rem;line-height:1.35;color:var(--gris)}
.t-note a{display:inline-block;padding-block:4px;font-weight:700;color:var(--encre)}
@media (min-width:760px){.temps{padding:18px 20px}.t-gros b{font-size:3.5rem}.t-gros span{font-size:1.0625rem}.t-avant{font-size:.875rem}}

.scene-pied{position:relative;z-index:7;display:flex;justify-content:flex-end;margin-top:8px}

/* ---- Les trois légendes, cliquables ---- */
.legendes{display:grid;gap:4px;max-width:var(--max);margin:16px auto 0;padding:0 var(--g)}
@media (min-width:760px){.legendes{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:28px}}
.leg{display:grid;grid-template-columns:28px minmax(0,1fr);gap:14px;align-items:start;padding:14px 4px 16px;border:0;border-top:2px solid var(--trait);background:none;color:inherit;font:inherit;text-align:left;cursor:pointer;transition:border-color var(--d-2)}
.leg:hover{border-top-color:var(--encre)}
.leg[aria-pressed="true"]{border-top-color:var(--sapin)}
.leg:focus-visible{outline:3px solid var(--sapin);outline-offset:2px;border-radius:4px}
.num-leg{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--encre);color:var(--menthe);font:800 .875rem/1 var(--f-titre)}
.leg[aria-pressed="true"] .num-leg{background:var(--menthe);color:var(--encre)}
.leg b{display:block;font:700 1.1875rem/1.2 var(--f-titre)}
.leg .l{display:block;margin-top:4px;font-size:1rem;line-height:1.45;color:var(--gris)}

/* Le focus sur un écran : les autres s'effacent */
.scene[data-focus] .couche .c-in{opacity:.22}
.scene[data-focus="tel"] .c-tel .c-in,.scene[data-focus="tab"] .c-tab .c-in,.scene[data-focus="notif"] .c-notif .c-in{opacity:1}
.scene[data-focus="tab"] .c-tab{z-index:5}

/* ================= MOUVEMENT (jamais sous mouvement réduit) ================= */
@media (prefers-reduced-motion:no-preference){
  /* Entrée au chargement : lente, échelonnée, une seule fois */
  :global(.js) .c-in{animation:a-entre 1100ms var(--courbe-sortie) backwards;animation-delay:calc(var(--i) * 180ms + 150ms)}
  :global(.js) .c-notif .c-in{animation:a-notif 900ms var(--courbe-sortie) 2600ms backwards}
  /* Le défilement redresse la scène (inclinée de 8°) pendant qu'elle entre ; rien n'est épinglé */
  @supports (animation-timeline: view()){
    :global(.js) .plateau{animation:a-redresse linear both;animation-timeline:view();animation-range:entry 20% cover 50%}
  }
  :global(.js) .repli-io .plateau{transform:perspective(2000px) rotateX(8deg) scale(.96);transition:transform 1400ms var(--courbe-sortie)}
  :global(.js) .repli-io.vue .plateau{transform:none}
}
@keyframes a-entre{from{opacity:0;transform:translateY(40px)}}
@keyframes a-notif{from{opacity:0;transform:translateY(-18px)}}
@keyframes a-redresse{from{transform:perspective(2000px) rotateX(8deg) scale(.96)}to{transform:none}}
</style>
