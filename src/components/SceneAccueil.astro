---
/*
  LE HÉROS IMMERSIF DE L'ACCUEIL (maquettes §A1, §A1b, §D.1).

  Le titre, une phrase, un bouton ; dessous, un grand panneau encre (lueur
  menthe) qui s'agrandit au défilement jusqu'au plein écran. Dedans, le
  désordre du bureau (fiche, chèque, tableur, relance, certificat, message de
  23:47) se range dans OnClub, ligne par ligne ; le compteur passe de « 66 h »
  à « ≈ 5 h » sans aucune valeur entre les deux (une barre menthe descend d'un
  cran par objet rangé) ; puis « 61 h rendues » et ce qu'on en fait.

  TROIS CHEMINS, sans détection de navigateur :
  1. Par défaut (sans JS, sans support, mouvement réduit) : L'ÉTAT FINAL, en
     carte arrondie sous le texte. C'est le HTML tel quel.
  2. animation-timeline (CSS pur) : la piste fait 150svh (G1 : 180 dépassait), l'étage est collant,
     chaque élément a sa plage de défilement.
  3. Repli IntersectionObserver : trois jalons règlent data-etape (0 à 3),
     des transitions CSS font le reste. Aucun écouteur de défilement.
  Le h1 n'est jamais animé à l'entrée (élément LCP). Les objets restent dans le
  HTML final, glissés sous la fenêtre OnClub (rien de caché en CSS). Les
  barres « Avant · Rangé · Rendu » ne sont créées que par le script, quand le
  mouvement est permis : sans JS, elles n'existent pas.
*/
import CompteurHeures from './CompteurHeures.astro'
import BlocTemps from './BlocTemps.astro'
import { TOTAL, CINQ_TACHES, HYPOTHESES } from '../data/temps'
import { INJEP } from '../data/site'
import VersFr from './langue/VersFr.astro'

export type TextesScene = {
  objets: {
    fiche: string; ficheNom: string; ficheNe: string; ficheStatut: string
    cheque: string; chequeDepot: string
    tableur: string
    relance: string; relanceTexte: string
    certificat: string; certificatStatut: string
    message: string
  }
  fenetre: string
  lignes: [string, string, string, string, string, string]
  vide: string
  compteurAvant: string
  compteurApres: string
  rendu: string
  moments: [string, string, string]
  barres: [string, string, string]
  aria: string
  note: string
  hypotheses: string
}

const FR: TextesScene = {
  objets: {
    fiche: 'Fiche d’inscription', ficheNom: 'Nom : ……………', ficheNe: 'Né(e) le : … / … / ……', ficheStatut: 'À recopier',
    cheque: 'Chèque n° 3 sur 4', chequeDepot: 'À déposer le 5 novembre',
    tableur: 'cotisations_2026_FINAL(3).xlsx',
    relance: 'Relance n° 3', relanceTexte: 'Cotisation de septembre, toujours rien',
    certificat: 'Certificat médical', certificatStatut: 'Manquant',
    message: 'Bonjour, il reste de la place le mercredi ?',
  },
  fenetre: 'OnClub · Saison 2026-2027',
  lignes: ['La famille s’inscrit seule', 'Payé en ligne', 'L’argent à jour', 'Relance d’un clic', 'Pièces en photo', 'Messages au bon groupe'],
  vide: 'Votre association',
  compteurAvant: 'd’administratif par saison, aujourd’hui',
  compteurApres: 'd’administratif par saison, avec OnClub',
  rendu: `${TOTAL.gain} rendues`,
  moments: ['le samedi au bord du terrain', 'la répétition du jeudi', 'la soirée en famille'],
  barres: ['Avant', 'Rangé', 'Rendu'],
  aria: 'Illustration : le désordre administratif d’une association se range dans OnClub. Il reste environ 5 heures par saison au lieu de 66 ; les 61 heures rendues vont au samedi au bord du terrain, à la répétition du jeudi et à la soirée en famille.',
  note: 'Estimation OnClub pour 250 adhérents, pas une étude.',
  hypotheses: 'Voir les hypothèses',
}

interface Props {
  titre: string
  phrase: string
  cta: { texte: string; href: string }
  t?: TextesScene
  /** /en, /es : « OnClub is a French platform… », sous le bouton. */
  noteLangue?: string
  idTitre?: string
  /** /en, /es : le bouton mène à une page en français (étiquette « FR »). */
  ctaVersFr?: string
}
const { titre, phrase, cta, t = FR, noteLangue, idTitre = 'titre', ctaVersFr } = Astro.props
const NB = String.fromCharCode(160)
const fine = (s: string) => s.replace(/ ([?!:;])/g, `${NB}$1`)
/* Le titre en deux temps : une ligne par phrase, aussi sur téléphone (pas de « La » orphelin). */
const coupe = titre.match(/^(.+?[?.!])\s+(.+)$/)
const parties = coupe ? [fine(coupe[1]), fine(coupe[2])] : [fine(titre)]
const o = t.objets
---
<section class="piste" data-heros data-sans-bouton-fixe data-scene aria-labelledby={idTitre} data-barres={JSON.stringify(t.barres)}>
  <div class="etage">
    <div class="heros-texte" data-heros-texte>
      <h1 id={idTitre}>{parties.map((p, i) => <span class="h1-partie">{i > 0 ? ' ' : ''}{p}</span>)}</h1>
      <p class="heros-phrase">{fine(phrase)}</p>
      <a class="btn btn-encre heros-btn" href={cta.href} hreflang={ctaVersFr ? 'fr' : undefined}>{cta.texte}{ctaVersFr && <VersFr sr={ctaVersFr} />} <svg aria-hidden="true"><use href="#fleche"/></svg></a>
      {noteLangue && <p class="heros-langue">{fine(noteLangue)}</p>}
    </div>
    <div class="panneau">
      <div class="plateau" role="img" aria-label={t.aria}>
        <div class="fenetre">
          <p class="fen-tete"><svg aria-hidden="true"><use href="#boucle"/></svg>{t.fenetre}</p>
          <ul class="fen-lignes">
            {t.lignes.map((l, k) => (
              <li class={`ligne l${k + 1}`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg>{l}</li>
            ))}
            <li class="ligne vide">{t.vide}</li>
          </ul>
        </div>
        <div class="objet o1" style="--k:0"><div class="objet-carte"><b>{o.fiche}</b><span class="trait">{o.ficheNom}</span><span class="trait">{o.ficheNe}</span><span class="statut neutre">{o.ficheStatut}</span></div></div>
        <div class="objet o2" style="--k:1"><div class="objet-carte"><b>{fine(o.cheque)}</b><span>{o.chequeDepot}</span><span class="montant num">45,00&nbsp;€</span></div></div>
        <div class="objet o3" style="--k:2"><div class="objet-carte"><b>{o.tableur}</b><span class="grille-xls"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div></div>
        <div class="objet o4" style="--k:3"><div class="objet-carte"><b>{fine(o.relance)}</b><span>{o.relanceTexte}</span></div></div>
        <div class="objet o5" style="--k:4"><div class="objet-carte"><b>{o.certificat}</b><span class="statut ko">{o.certificatStatut}</span></div></div>
        <div class="objet o6" style="--k:5"><div class="objet-carte"><span class="heure">23:47</span><span>{fine(o.message)}</span></div></div>
        <div class="cote">
          <div class="sc-cpt"><CompteurHeures deMin={TOTAL.avantMin} aMin={TOTAL.apresMin} libelleAvant={fine(t.compteurAvant)} libelleApres={fine(t.compteurApres)} declencheur="defilement" /></div>
          <div class="rendu">
            <p class="rendu-titre">{t.rendu}</p>
            {t.moments.map((m, k) => <p class={`moment m${k + 1}`}>{m}</p>)}
          </div>
        </div>
      </div>
      <div class="barres" data-barres-place></div>
    </div>
  </div>
  <i class="jalon j1"></i><i class="jalon j2"></i><i class="jalon j3"></i>
</section>
<script is:inline>
(function(){var p=document.currentScript&&document.currentScript.previousElementSibling,m=window.matchMedia;if(!p||!p.hasAttribute('data-scene')||!m||m('(prefers-reduced-motion: reduce)').matches)return;
var tx=p.querySelector('[data-heros-texte]');function haut(){p.style.setProperty('--haut',tx.offsetHeight+'px')}haut();if('ResizeObserver'in window)new ResizeObserver(haut).observe(tx);
var css=window.CSS&&CSS.supports&&CSS.supports('animation-timeline','view()');
if(!css){if(!('IntersectionObserver'in window))return;p.classList.add('repli-io');p.setAttribute('data-etape','0');var js=[].slice.call(p.querySelectorAll('.jalon'));var io=new IntersectionObserver(function(){var c=innerHeight/2,n=0;js.forEach(function(j){if(j.getBoundingClientRect().top<c)n++});p.setAttribute('data-etape',n)},{rootMargin:'-50% 0px -50% 0px'});js.forEach(function(j){io.observe(j)})}
var b=p.querySelector('[data-barres-place]'),L=JSON.parse(p.getAttribute('data-barres')),P=[0,.7,1];
L.forEach(function(l,k){var x=document.createElement('button');x.type='button';x.className='barre b'+(k+1);x.innerHTML='<span></span><i><i></i></i>';x.firstChild.textContent=l;x.addEventListener('click',function(){var h=p.offsetHeight-innerHeight;window.scrollTo({top:p.getBoundingClientRect().top+window.scrollY+P[k]*h+(k?2:0),behavior:'smooth'})});b.appendChild(x)})})()
</script>
<div class="enveloppe scene-note">
  <p>{fine(t.note)}</p>
  <details class="scene-hyp">
    <summary>{t.hypotheses}</summary>
    <div class="scene-hyp-corps">
      <slot name="hypotheses">
        <p>{HYPOTHESES}</p>
        <BlocTemps cles={CINQ_TACHES} titre="Aujourd’hui → avec OnClub, pour 250 adhérents" />
        <p class="scene-injep"><b>{INJEP.chiffre}</b> {INJEP.texte} <a href={INJEP.source} target="_blank" rel="noopener">{INJEP.titreSource}</a></p>
      </slot>
    </div>
  </details>
</div>

<style>
/* ================= 1. L'ÉTAT FINAL (par défaut) ================= */
.piste{position:relative;--haut:360px;--cote:max(16px,calc((100vw - 1200px) / 2))}
@media (min-width:760px){.piste{--haut:440px}}
.etage{position:relative}
.heros-texte{position:relative;z-index:1;max-width:var(--max);margin-inline:auto;padding:28px var(--g) 32px;display:flex;flex-direction:column;align-items:flex-start}
h1{font-size:clamp(2.125rem,1.15rem + 4.4vw,4.6875rem);line-height:1;font-weight:800;letter-spacing:-.025em;max-width:none;text-wrap:balance}
.heros-phrase{margin-top:16px;font-size:var(--t-chapo,clamp(1.0625rem,1rem + .3vw,1.25rem));line-height:1.5;color:var(--gris);max-width:34em;text-wrap:pretty}
.heros-btn{margin-top:24px}
.heros-langue{margin-top:14px;font-size:.875rem;color:var(--gris);max-width:40em}
@media (max-width:759px){.heros-btn{align-self:stretch}}
.h1-partie{display:block}
@media (min-width:760px){
  .heros-texte{align-items:center;text-align:center;padding:56px var(--g) 40px}
  .heros-phrase{margin-top:24px}
  .heros-btn{margin-top:32px}
}
.panneau{position:relative;margin:0 16px;border-radius:var(--r-panneau,24px);background:var(--scene,#0B0F14);background-image:var(--lueur,radial-gradient(70% 55% at 50% 112%,rgba(93,232,143,.42) 0%,rgba(93,232,143,.12) 45%,rgba(93,232,143,0) 72%));color:var(--blanc);padding:24px 16px 28px;overflow:hidden}
@media (min-width:760px){.panneau{margin-inline:var(--cote);padding:48px}}
.plateau{position:relative;display:grid;gap:16px;max-width:1120px;margin-inline:auto}
@media (min-width:760px){.cote{gap:24px}}
@media (min-width:1000px){.plateau{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:56px;align-items:center}}

/* La fenêtre OnClub */
.fenetre{position:relative;z-index:2;background:var(--scene-2,#121821);border:1px solid var(--trait-scene,rgba(255,255,255,.10));border-radius:20px;box-shadow:var(--ombre-fenetre,0 40px 80px -40px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.06));overflow:hidden}
@media (min-width:760px){.fenetre{border-radius:var(--r-l)}}
.fen-tete{display:flex;align-items:center;gap:10px;height:44px;padding:0 16px;font:700 .9375rem/1 var(--f-titre);color:var(--blanc);border-bottom:1px solid var(--trait-scene,rgba(255,255,255,.10))}
.fen-tete svg{width:30px;height:15px;color:var(--menthe);flex:none}
.fen-lignes{list-style:none;margin:0;padding:4px 0 10px}
.ligne{display:flex;align-items:center;gap:10px;min-height:36px;padding:0 16px;font-size:.875rem;font-weight:600;color:var(--texte-scene,#D7DBE1);border-bottom:1px solid var(--trait-scene,rgba(255,255,255,.10))}
.ligne svg{width:18px;height:18px;flex:none;fill:none;stroke:var(--menthe);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:20;stroke-dashoffset:0}
.ligne.vide{margin:10px 12px 0;padding-inline:12px;border:1.5px dashed rgba(255,255,255,.28);border-radius:10px;color:var(--texte-scene-doux,#AEB4BE)}
@media (min-width:760px){.fen-tete{height:56px;padding:0 24px;font-size:1.0625rem}.ligne{min-height:50px;padding:0 24px;font-size:1.0625rem}.ligne.vide{margin:12px 16px 0;padding-inline:20px}}

/* Les objets du désordre : à l'état final, glissés sous la fenêtre (couverts par elle). */
.objet{position:absolute;z-index:1;left:var(--fx);top:var(--fy);transform-origin:0 0;transform:scale(.6)}
.objet-carte{display:flex;flex-direction:column;gap:4px;width:150px;padding:10px 12px;background:var(--blanc);color:var(--encre);border-radius:var(--r-s,12px);box-shadow:var(--ombre-objet,0 18px 30px -18px rgba(11,15,20,.55));font-size:.75rem;line-height:1.3}
@media (min-width:760px){.objet-carte{width:210px;font-size:.8125rem;padding:12px 14px}}
.objet-carte b{font:700 .8125rem/1.2 var(--f-titre)}
@media (min-width:760px){.objet-carte b{font-size:.9375rem}}
.objet-carte .statut{align-self:flex-start;font-size:.6875rem;padding:2px 8px}
.trait{color:var(--gris)}
.montant{font:700 1rem/1 var(--f-titre)}
.o2 .objet-carte{background:var(--lilas-pale)}
.o3 .objet-carte{width:170px}
@media (min-width:760px){.o3 .objet-carte{width:230px}}
.o4 .objet-carte{background:var(--alerte-pale)}
.o4 b{color:var(--alerte)}
.o6 .objet-carte{background:var(--scene-2,#121821);color:var(--blanc);border:1px solid var(--trait-scene,rgba(255,255,255,.12))}
.heure{font:700 .75rem/1 var(--f-texte);color:var(--menthe)}
.grille-xls{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:2px}
.grille-xls i{height:9px;background:#E7E2D6}
.grille-xls i:nth-child(3n+1){background:#CFE9D8}
/* Positions finales (sous la fenêtre) : téléphone */
.o1{--fx:12px;--fy:56px}.o2{--fx:170px;--fy:60px}.o3{--fx:16px;--fy:150px}.o4{--fx:176px;--fy:160px}.o5{--fx:20px;--fy:240px}.o6{--fx:170px;--fy:244px}
@media (min-width:760px){.o1{--fx:40px;--fy:80px}.o2{--fx:300px;--fy:90px}.o3{--fx:50px;--fy:200px}.o4{--fx:310px;--fy:210px}.o5{--fx:60px;--fy:320px}.o6{--fx:300px;--fy:320px}}

/* Le compteur et le temps rendu */
.cote{position:relative;z-index:2;display:grid;gap:16px;align-content:center}
.sc-cpt{--cpt-taille:clamp(3.5rem,1.5rem + 8vw,8.5rem);--cpt-piste:rgba(255,255,255,.12)}
.sc-cpt :global(.cpt){width:100%}
.sc-cpt :global(.cpt-lib){font-size:1rem;color:var(--texte-scene,#D7DBE1);font-weight:600}
.sc-cpt :global(.cpt-barre){max-width:360px}
.rendu{display:grid;gap:6px}
.rendu-titre{font:800 clamp(1.75rem,1rem + 3.4vw,3.5rem)/1 var(--f-titre);letter-spacing:-.02em;color:var(--menthe);margin-bottom:6px}
.moment{font:700 clamp(1.125rem,.7rem + 1.6vw,2rem)/1.2 var(--f-titre);color:var(--blanc)}

/* Les barres (créées par le script) et les jalons */
.barres{display:none}
.jalon{position:absolute;left:0;width:1px;height:1px;pointer-events:none}
.j1{top:38%}.j2{top:50%}.j3{top:60%}

/* La note sous la scène */
.scene-note{display:flex;flex-wrap:wrap;align-items:center;gap:0 20px;padding-top:8px;font-size:var(--t-micro,.8125rem);color:var(--gris)}
.scene-hyp summary{display:inline-flex;align-items:center;min-height:44px;cursor:pointer;font-weight:700;color:var(--encre)}
.scene-hyp[open]{flex-basis:100%}
.scene-hyp-corps{display:grid;gap:16px;padding:8px 0 16px;font-size:.9375rem;color:var(--encre)}
.scene-hyp-corps > :global(p){max-width:var(--lecture)}
.scene-injep a{font-weight:600}

/* ================= 2 et 3. LE MOUVEMENT (jamais sous mouvement réduit) ================= */
@media (prefers-reduced-motion: no-preference){
  /* — Mise en scène commune aux deux chemins : piste épinglée, panneau plein écran — */
  @supports (animation-timeline: view()){
    :global(html.js) .piste{height:150svh;view-timeline:--piste block;view-timeline-inset:0px}
    :global(html.js) .etage{position:sticky;top:0;height:100svh;overflow:hidden}
    :global(html.js) .panneau{position:absolute;inset:0;z-index:2;margin:0;border-radius:0;display:flex;flex-direction:column;justify-content:center;padding:24px 16px 76px;clip-path:inset(0 0 0 0)}
    :global(html.js) .barres{display:grid}
    :global(html.js) .objet{z-index:3}
  }
  .piste:global(.repli-io){height:150svh}
  .piste:global(.repli-io) .etage{position:sticky;top:0;height:100svh;overflow:hidden}
  .piste:global(.repli-io) .panneau{position:absolute;inset:0;z-index:2;margin:0;border-radius:0;display:flex;flex-direction:column;justify-content:center;padding:24px 16px 76px;clip-path:inset(0 0 0 0 round 0)}
  .piste:global(.repli-io) .barres{display:grid}
  .piste:global(.repli-io) .objet{z-index:3}
  @media (min-width:760px){
    @supports (animation-timeline: view()){
    :global(html.js) .panneau{padding:40px 48px 84px}}
    .piste:global(.repli-io) .panneau{padding:40px 48px 84px}
  }

  /* Les barres « Avant · Rangé · Rendu » */
  .barres{position:absolute;left:16px;right:16px;bottom:16px;z-index:4;grid-template-columns:repeat(3,1fr);gap:12px;max-width:1120px;margin-inline:auto}
  @media (min-width:760px){.barres{left:48px;right:48px;bottom:24px;gap:20px}}
  .barres :global(.barre){display:grid;gap:8px;min-height:44px;align-content:end;padding:0;border:0;background:none;color:var(--texte-scene-doux,#AEB4BE);font:600 var(--t-micro,.8125rem)/1.2 var(--f-texte);text-align:left;cursor:pointer}
  .barres :global(.barre:hover){color:var(--blanc)}
  .barres :global(.barre:focus-visible){outline:3px solid var(--menthe);outline-offset:4px;border-radius:4px}
  .barres :global(.barre>i){display:block;height:2px;background:var(--trait-scene,rgba(255,255,255,.18));overflow:hidden}
  .barres :global(.barre>i>i){display:block;height:100%;background:var(--menthe);transform-origin:left;transform:scaleX(0)}

  /* L'entrée, jouée une fois au chargement (pas de JS ; jamais sur le h1) */
  @supports (animation-timeline: view()){
    :global(html.js) .objet-carte{animation:sc-entree var(--d-3,600ms) var(--courbe-sortie,cubic-bezier(.16,1,.3,1)) calc(var(--k) * 80ms) both}
    :global(html.js) .o6 .objet-carte{animation:sc-notif 900ms var(--courbe-ressort,cubic-bezier(.34,1.56,.64,1)) 1500ms both}
  }
  .piste:global(.repli-io) .objet-carte{animation:sc-entree var(--d-3,600ms) var(--courbe-sortie,cubic-bezier(.16,1,.3,1)) calc(var(--k) * 80ms) both}
  .piste:global(.repli-io) .o6 .objet-carte{animation:sc-notif 900ms var(--courbe-ressort,cubic-bezier(.34,1.56,.64,1)) 1500ms both}

  /* — Chemin 2 : le défilement pilote tout, en CSS — */
  @supports (animation-timeline: view()){
    :global(html.js) .heros-texte{animation:sc-texte-monte linear both;animation-range:contain 0% contain 12%}
    /* Dès 1000 px, le plateau part centré dans la partie visible du panneau (sous le texte), puis remonte : aucun papier tranché au premier écran. */
    @media (min-width:1000px){:global(html.js) .plateau{animation:sc-plateau linear both;animation-range:contain 0% contain 25%}}
    :global(html.js) .panneau{animation:sc-croissance linear both;animation-range:contain 0% contain 25%}
    :global(html.js) .fenetre{animation:sc-fenetre-monte linear both;animation-range:contain 25% contain 35%}
    :global(html.js) .objet{animation:sc-ranger linear both}
    :global(html.js) .o1{animation-range:contain 35% contain 40%}
    :global(html.js) .o2{animation-range:contain 40% contain 45%}
    :global(html.js) .o3{animation-range:contain 45% contain 50%}
    :global(html.js) .o4{animation-range:contain 50% contain 55%}
    :global(html.js) .o5{animation-range:contain 55% contain 60%}
    :global(html.js) .o6{animation-range:contain 60% contain 65%}
    :global(html.js) .ligne:not(.vide){animation:sc-ligne-apparait linear both}
    :global(html.js) .ligne:not(.vide) svg{animation:sc-coche linear both}
    :global(html.js) .l1,:global(html.js) .l1 svg{animation-range:contain 35% contain 40%}
    :global(html.js) .l2,:global(html.js) .l2 svg{animation-range:contain 40% contain 45%}
