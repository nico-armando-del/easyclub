---
/*
  Une grille de cartes pour une collection (hubs). Vide : un message, jamais un lien mort.
  Sports et activités : les pages qui ont une photo passent en cartes photo,
  les autres en liste compacte dessous, pour que la grille reste régulière.

  Options du hub /pour-qui (maquettes §B.4 et §F) :
  - `portrait` : cartes photo en 4:5 (5 par ligne à 1280), en liste à vignette sur téléphone ;
  - `limite` : les N premières (ordre, puis nom) en cartes ;
  - `az` : au-delà de `limite`, la liste COMPLÈTE de A à Z, avec un filtre en
    amélioration progressive (attribut hidden sur les lignes écartées ; sans JS,
    tout est là). Chaque page publiée est ainsi liée.
  - `azToujours` : la liste A-Z même sous `limite` (/pour-qui, sports : elle
    grandit avec les pages publiées, rien n'est codé en dur) ; `limite={0}` ne
    garde que la liste ;
  - `vignettes` : une liste compacte (petite photo carrée + nom), pour les
    activités artistiques, sous les sports.
*/
import { catalogue, ETIQUETTE, type NomCollection } from '../lib/collections'
import { i18n, SR_FR } from '../i18n/ui'
import VersFr from './langue/VersFr.astro'
import { photoDe } from '../data/photos'
import Photo from './Photo.astro'
interface Props {
  collection: NomCollection
  vide?: string
  portrait?: boolean
  limite?: number
  az?: { titre: string; champ: string; id: string; indice?: string }
  azToujours?: boolean
  vignettes?: boolean
}
const { langue, t } = i18n(Astro.url)
const { collection, vide = t('Les premières pages arrivent.'), portrait = false, limite, az, azToujours = false, vignettes = false } = Astro.props
/* Chaque page dans la langue de la page qui la liste : en espagnol, une page non traduite garde son lien français (« FR »). */
const toutes = await catalogue(collection, langue)
const entrees = limite !== undefined ? toutes.slice(0, limite) : toutes
const avecPhotos = collection === 'sports' || collection === 'activites'
const illustrees = avecPhotos ? entrees.filter((e: any) => photoDe(e.id)) : []
const autres = avecPhotos ? entrees.filter((e: any) => !photoDe(e.id)) : entrees
const etiquette = (e: any) => `${collection === 'articles' ? e.data.rubrique : t(ETIQUETTE[collection])}${e.data.lecture ? ` · ${e.data.lecture} min` : ''}`
const fr = (e: any) => (e.fr ? 'fr' : undefined)
const plat = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
const montrerAz = az && (azToujours || (limite !== undefined && toutes.length > limite))
const parLettre = new Map<string, any[]>()
if (montrerAz) {
  for (const e of [...toutes].sort((a: any, b: any) => a.nom.localeCompare(b.nom, langue))) {
    const l = plat((e as any).nom).charAt(0).toUpperCase()
    if (!parLettre.has(l)) parLettre.set(l, [])
    parLettre.get(l)!.push(e)
  }
}
---
{toutes.length > 0 ? (
  <>
    {vignettes ? (
      <ul class="vignettes">
        {entrees.map((e: any) => <li><a href={e.url} hreflang={fr(e)}>{photoDe(e.id) ? <Photo nom={e.id} ratio="1/1" tailles="64px" /> : <span class="vg-vide" aria-hidden="true"></span>}<span class="vg-corps"><b>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</b>{e.ligne && <span>{e.ligne}</span>}</span></a></li>)}
      </ul>
    ) : illustrees.length > 0 && (
      <ul class:list={['cartes', portrait ? 'grille-portraits' : 'grille-photos', portrait && illustrees.length <= 2 && 'portraits-peu']}>
        {illustrees.map((e: any) => portrait ? (
          <li><a class="carte-portrait" href={e.url} hreflang={fr(e)}><Photo nom={e.id} ratio="4/5" tailles="(min-width: 1000px) 230px, (min-width: 700px) 30vw, 112px" /><span class="cp-corps"><b>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</b>{e.ligne && <span>{e.ligne}</span>}</span></a></li>
        ) : (
          <li><a class="carte-lien carte-photo" href={e.url} hreflang={fr(e)}><Photo nom={e.id} tailles="(min-width: 1000px) 360px, 50vw" /><span class="carte-corps"><b>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</b>{e.ligne && <span>{e.ligne}</span>}</span></a></li>
        ))}
      </ul>
    )}
    {!vignettes && autres.length > 0 && (illustrees.length > 0 ? (
      <ul class="liste-compacte">
        {autres.map((e: any) => <li><a href={e.url} hreflang={fr(e)}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a></li>)}
      </ul>
    ) : (
      <ul class="grille grille-3 cartes">
        {autres.map((e: any) => (
          <li><a class="carte-lien" href={e.url} hreflang={fr(e)}><small>{etiquette(e)}</small><b>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</b>{e.ligne && <span>{e.ligne}</span>}</a></li>
        ))}
      </ul>
    ))}
    {montrerAz && az && (
      <div class="az" id={az.id} data-az>
        <h3 id={`${az.id}-titre`} class="az-titre">{az.titre}</h3>
        <div class="az-filtre" data-az-filtre hidden>
          <label for={`${az.id}-champ`}>{az.champ}</label>
          <input id={`${az.id}-champ`} type="search" autocomplete="off" spellcheck="false" placeholder={az.indice} data-az-champ>
        </div>
        <div class="az-groupes">
          {[...parLettre.entries()].map(([lettre, items]) => (
            <section class="az-groupe" id={`${az.id}-${lettre.toLowerCase()}`} aria-labelledby={`${az.id}-l-${lettre.toLowerCase()}`} data-az-groupe>
              <h4 class="az-lettre" id={`${az.id}-l-${lettre.toLowerCase()}`}>{lettre}</h4>
              <ul>{items.map((e: any) => <li data-az-nom={plat(e.nom)}><a href={e.url} hreflang={fr(e)}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a></li>)}</ul>
            </section>
          ))}
        </div>
        <p class="note" data-az-vide hidden>{t('Aucune page ne correspond à cette recherche.')}</p>
        <button type="button" class="az-tout" data-az-tout data-texte={t('Voir toute la liste ({n})')} hidden>{t('Voir toute la liste')}</button>
      </div>
    )}
  </>
) : <p class="note">{vide}</p>}

<script>
  /* Le filtre A-Z : il masque (attribut hidden) les lignes qui ne correspondent pas, à la demande du visiteur. */
  const plat = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim()
  document.querySelectorAll<HTMLElement>('[data-az]').forEach((bloc) => {
    const zone = bloc.querySelector<HTMLElement>('[data-az-filtre]')
    const champ = bloc.querySelector<HTMLInputElement>('[data-az-champ]')
    const vide = bloc.querySelector<HTMLElement>('[data-az-vide]')
    if (!zone || !champ) return
    zone.hidden = false
    /* Téléphone : la liste se replie derrière le champ (les premières lettres, puis « Voir toute
       la liste ») ; une recherche, ou le bouton, la déplie. Sans JavaScript : la liste entière. */
    const tout = bloc.querySelector<HTMLButtonElement>('[data-az-tout]')
    const deplier = () => { bloc.classList.remove('az-replie'); if (tout) tout.hidden = true }
    if (tout && window.matchMedia('(max-width: 699px)').matches) {
      const n = bloc.querySelectorAll('[data-az-nom]').length
      if (n > 24) {
        tout.textContent = (tout.dataset.texte || 'Voir toute la liste ({n})').replace('{n}', String(n))
        tout.hidden = false
        bloc.classList.add('az-replie')
        tout.addEventListener('click', () => { deplier(); champ.focus({ preventScroll: true }) })
      }
    }
    champ.addEventListener('input', () => {
      if (champ.value) deplier()
      const q = plat(champ.value)
      let n = 0
      bloc.querySelectorAll<HTMLElement>('[data-az-groupe]').forEach((g) => {
        let dans = 0
        g.querySelectorAll<HTMLElement>('[data-az-nom]').forEach((li) => {
          const ok = !q || (li.dataset.azNom ?? '').includes(q)
          li.hidden = !ok; if (ok) dans++
        })
        g.hidden = dans === 0; n += dans
      })
      if (vide) vide.hidden = n > 0
    })
  })
</script>

<style>
.cartes{list-style:none;padding:0;margin:28px 0 0}
.liste-compacte{list-style:none;padding:0;margin:28px 0 0;display:flex;flex-wrap:wrap;gap:10px}
.liste-compacte a{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;background:var(--blanc);border:1px solid var(--trait);font-weight:600;text-decoration:none;color:var(--encre)}
.liste-compacte a:hover{border-color:var(--encre)}

/* Cartes portrait : liste à vignette sur téléphone, grille 4:5 dès 700 px. */
.grille-portraits{display:grid;gap:12px}
.carte-portrait{display:grid;grid-template-columns:112px minmax(0,1fr);gap:16px;align-items:center;min-height:44px;padding:8px;background:var(--blanc);border-radius:var(--r-m);text-decoration:none;color:var(--encre);box-shadow:var(--ombre-carte);transition:box-shadow var(--d-2) var(--courbe-sortie),transform var(--d-2) var(--courbe-sortie)}
.carte-portrait:hover{box-shadow:var(--ombre-carte-survol);transform:translateY(-2px)}
.carte-portrait :global(.photo){aspect-ratio:1/1!important;border-radius:12px}
.cp-corps{display:flex;flex-direction:column;gap:4px;padding-right:8px}
.cp-corps b{font:700 1.125rem/1.2 var(--f-titre)}
.cp-corps span{font-size:.875rem;line-height:1.4;color:var(--gris)}
@media (min-width:700px){
  .grille-portraits{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--col-gap)}
  .carte-portrait{display:flex;flex-direction:column;align-items:stretch;gap:0;padding:0;overflow:hidden;border-radius:var(--r-l);height:100%}
  .carte-portrait :global(.photo){aspect-ratio:4/5!important;border-radius:0}
  .cp-corps{padding:16px 18px 20px}
}
@media (min-width:1000px){.grille-portraits{grid-template-columns:repeat(5,minmax(0,1fr))}}
/* Une ou deux cartes seulement : une carte large, photo à gauche et texte à droite (col 1-8),
   plutôt qu'une vignette d'un sixième de largeur suivie d'une grille vide. */
@media (min-width:700px){
  .grille-portraits.portraits-peu{grid-template-columns:minmax(0,1fr);max-width:calc(100% * 8 / 12)}
  .portraits-peu .carte-portrait{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:center}
  .portraits-peu .carte-portrait :global(.photo){aspect-ratio:4/3!important;height:100%;object-fit:cover}
  .portraits-peu .cp-corps{padding:24px 32px}
  .portraits-peu .cp-corps b{font-size:1.5rem}
  .portraits-peu .cp-corps span{font-size:1rem}
}

/* Vignettes : liste compacte (activités artistiques sur /pour-qui) */
.vignettes{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:8px}
@media (min-width:700px){.vignettes{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px var(--col-gap)}}
@media (min-width:1000px){.vignettes{grid-template-columns:repeat(3,minmax(0,1fr))}}
.vignettes a{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px;align-items:center;min-height:44px;padding:8px;border-radius:var(--r-m);background:var(--blanc);border:1px solid var(--trait);text-decoration:none;color:var(--encre);transition:border-color var(--d-2)}
.vignettes a:hover{border-color:var(--encre)}
.vignettes :global(.photo){width:64px;height:64px;object-fit:cover;border-radius:10px}
.vg-vide{width:64px;height:64px;border-radius:10px;background:var(--papier-2)}
.vg-corps{display:flex;flex-direction:column;gap:2px;min-width:0}
.vg-corps b{font:700 1.0625rem/1.2 var(--f-titre)}
.vg-corps span{font-size:.875rem;line-height:1.35;color:var(--gris)}

/* Liste A-Z */
.az{margin-top:var(--e-8)}
.az-titre{font-size:clamp(1.375rem,1.2rem + .6vw,1.625rem)}
.az-filtre{margin-top:var(--e-5);display:grid;gap:8px;max-width:420px}
.az-filtre[hidden]{display:none}
.az-filtre label{font-weight:700}
.az-filtre input{min-height:48px;border:2px solid var(--encre);border-radius:12px;padding:0 14px;font:500 1.0625rem var(--f-texte);background:var(--blanc);color:var(--encre)}
.az-filtre input:focus{outline:none;box-shadow:0 0 0 3px var(--menthe)}
.az-groupes{margin-top:var(--e-6);columns:2;column-gap:var(--col-gap)}
@media (min-width:1000px){.az-groupes{columns:4}}
.az-groupe{break-inside:avoid;margin-bottom:var(--e-5)}
.az-groupe[hidden],.az-groupe li[hidden]{display:none}
.az-lettre{font:700 1.75rem/1 var(--f-titre);color:var(--sapin);margin-bottom:4px}
.az-groupe ul{list-style:none;padding:0;margin:0}
/* Un intervalle régulier, que le nom tienne sur une ligne ou deux : le texte part du haut, même marge dessus et dessous. */
.az-groupe a{display:inline-flex;align-items:flex-start;padding-block:11px;line-height:1.3;font-size:var(--t-petit);font-weight:600;text-decoration:none}
@media (min-width:1000px){.az-groupe a{padding-block:7px}}
/* Téléphone, liste repliée : les premières lettres, fondues vers le bas, puis le bouton. */
:global(.az-replie) .az-groupes{max-height:560px;overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,#000 70%,transparent);mask-image:linear-gradient(to bottom,#000 70%,transparent)}
.az-tout{display:inline-flex;align-items:center;min-height:48px;margin-top:8px;padding:0 22px;border:1.5px solid var(--encre);border-radius:999px;background:var(--blanc);color:var(--encre);font:700 1rem var(--f-texte);cursor:pointer}
.az-tout[hidden]{display:none}
.az-tout:focus-visible{outline:3px solid var(--sapin);outline-offset:2px}
.az-groupe a:hover{text-decoration:underline}
</style>
