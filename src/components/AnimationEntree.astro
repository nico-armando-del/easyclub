---
/*
  L'ANIMATION D'ENTRÉE DE L'ACCUEIL : « Marre de passer vos soirées sur l'administratif ? »

  1. Le désordre du bureau bénévole apparaît (fiche à recopier, chèque, tableur,
     relance n° 3, certificat manquant, message à 23 h 47) et le compteur monte
     jusqu'à 66 h par saison.
  2. Tout se range dans OnClub : il reste ≈ 5 h.
  3. Le temps rendu prend la place : le samedi au bord du terrain, la répétition,
     la soirée en famille.

  Environ 5 s, une seule fois. L'ÉTAT FINAL EST L'ÉTAT PAR DÉFAUT DU HTML :
  sans JavaScript, ou sous prefers-reduced-motion, on voit directement le
  rangement, ≈ 5 h et le temps rendu. Le script en ligne n'ajoute les classes
  de l'animation que s'il peut la jouer. Tout est positionné dans une scène de
  hauteur fixe : aucun décalage de mise en page (CLS nul).
*/
import { TOTAL } from '../data/temps'
---
<div class="scene" data-scene aria-label="Illustration : le désordre administratif d’une association se range dans OnClub, il reste environ 5 heures par saison au lieu de 66, et le temps rendu revient au samedi au bord du terrain, à la répétition et à la soirée en famille." role="img">
  <div class="objets" aria-hidden="true">
    <div class="objet o1"><b>Fiche d’inscription</b><span class="trait">Nom : ……………</span><span class="trait">Né(e) le : … / … / ……</span><span class="statut neutre">À recopier</span></div>
    <div class="objet o2"><b>Chèque n° 3 sur 4</b><span>À déposer le 5 novembre</span><span class="montant">45,00 €</span></div>
    <div class="objet o3 tableur"><b>cotisations_2026_FINAL(3).xlsx</b><span class="grille-xls"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
    <div class="objet o4"><b>Relance n° 3</b><span>Cotisation de septembre, toujours rien</span></div>
    <div class="objet o5"><b>Certificat médical</b><span class="statut ko">Manquant</span></div>
    <div class="objet o6 message"><span class="heure">23:47</span><span>Bonjour, il reste de la place le mercredi ?</span></div>
  </div>

  <div class="rangement" aria-hidden="true">
    <p class="rg-tete"><svg aria-hidden="true"><use href="#boucle"/></svg>Rangé dans OnClub</p>
    <ul class="rg-liste">
      <li><svg aria-hidden="true"><use href="#coche"/></svg>La famille s’inscrit seule</li>
      <li><svg aria-hidden="true"><use href="#coche"/></svg>Payé en ligne</li>
      <li><svg aria-hidden="true"><use href="#coche"/></svg>L’argent à jour</li>
      <li><svg aria-hidden="true"><use href="#coche"/></svg>Relance d’un clic</li>
      <li><svg aria-hidden="true"><use href="#coche"/></svg>Pièces en photo</li>
      <li><svg aria-hidden="true"><use href="#coche"/></svg>Messages au bon groupe</li>
    </ul>
    <div class="rg-rendu">
      <p class="rg-rendu-titre">≈ {TOTAL.gain} rendues, pour :</p>
      <p class="rg-moment m1">le samedi au bord du terrain</p>
      <p class="rg-moment m2">la répétition du jeudi</p>
      <p class="rg-moment m3">la soirée en famille</p>
    </div>
  </div>

  <div class="compteur" aria-hidden="true">
    <span class="cpt-lib"><span class="cpt-avant">d’administratif par saison, aujourd’hui</span><span class="cpt-apres">par saison avec OnClub, au lieu de {TOTAL.avant}</span></span>
    <b class="cpt-val num" data-compteur>≈ {TOTAL.apres}</b>
  </div>
</div>
<p class="scene-note">Estimation OnClub pour 250 adhérents, pas une étude. <a href="/temps-gagne#hypotheses">Voir les hypothèses</a></p>

<script is:inline>
(function () {
  var s = document.querySelector('[data-scene]')
  if (!s || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
  var v = s.querySelector('[data-compteur]')
  function compte(de, a, ms, suffixe, fin) {
    var t0 = performance.now()
    ;(function pas(t) {
      var k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 3)
      v.textContent = suffixe + Math.round(de + (a - de) * e) + ' h'
      if (k < 1) requestAnimationFrame(pas); else if (fin) fin()
    })(t0)
  }
  s.classList.add('joue', 'p0')
  v.textContent = '0 h'
  setTimeout(function () { s.classList.add('p1'); compte(0, 66, 1700, '') }, 120)
  setTimeout(function () { s.classList.add('p2'); compte(66, 5, 800, '≈ ') }, 2700)
  setTimeout(function () { s.classList.add('p3') }, 3600)
  setTimeout(function () { s.classList.remove('joue', 'p0', 'p1', 'p2', 'p3'); v.textContent = '≈ 5 h' }, 5200)
})()
</script>

<style>
/* ----- La scène : hauteur fixe, tout est positionné dedans ----- */
.scene{position:relative;height:430px;border:2px solid var(--encre);border-radius:var(--r-l);background:var(--papier);box-shadow:0 6px 0 var(--encre);overflow:hidden}
@media (min-width:760px){.scene{height:470px}}

/* ----- Les objets du désordre ----- */
.objets{position:absolute;inset:0 0 72px 0}
.objet{position:absolute;display:flex;flex-direction:column;gap:4px;padding:10px 12px;background:var(--blanc);border:1.5px solid var(--encre);border-radius:10px;font-size:.8125rem;line-height:1.3;box-shadow:0 4px 0 rgba(11,15,20,.85);max-width:46%}
.objet b{font:700 .875rem/1.2 var(--f-titre)}
.objet .statut{align-self:flex-start;font-size:.75rem;padding:2px 8px}
.objet .trait{color:var(--gris)}
.objet .montant{font:800 1rem/1 var(--f-titre)}
.o1{left:5%;top:5%;transform:rotate(-3deg)}
.o2{right:5%;top:7%;transform:rotate(2.5deg);background:var(--lilas-pale)}
.o3{left:9%;top:36%;transform:rotate(1.5deg);max-width:56%}
.o4{right:4%;top:40%;transform:rotate(-2deg);background:var(--alerte-pale);border-color:var(--alerte)}
.o4 b{color:var(--alerte)}
.o5{left:4%;top:68%;transform:rotate(-1.5deg)}
.o6{right:5%;top:66%;transform:rotate(2deg);background:var(--encre);color:var(--blanc);border-color:var(--encre);max-width:52%}
.o6 .heure{font:700 .75rem/1 var(--f-texte);color:var(--menthe)}
.grille-xls{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:2px}
.grille-xls i{height:9px;background:#E7E2D6}
.grille-xls i:nth-child(3n+1){background:#CFE9D8}

/* ----- Le rangement (état final par défaut) ----- */
.rangement{position:absolute;inset:14px 14px 86px 14px;background:var(--encre);color:var(--blanc);border-radius:var(--r-m);padding:16px;display:flex;flex-direction:column;gap:12px}
.rg-tete{display:flex;align-items:center;gap:10px;font:800 1.0625rem/1 var(--f-titre)}
.rg-tete svg{width:34px;height:17px;color:var(--menthe)}
.rg-liste{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:6px 10px;font-size:.8125rem;line-height:1.25}
.rg-liste li{display:flex;gap:6px;align-items:flex-start;color:#D7DBE1}
.rg-liste svg{width:14px;height:14px;flex:none;color:var(--menthe);margin-top:1px}
.rg-rendu{margin-top:auto;border-top:1px solid #2A323D;padding-top:12px;display:grid;gap:4px}
.rg-rendu-titre{font:700 .8125rem/1.2 var(--f-texte);letter-spacing:.06em;text-transform:uppercase;color:var(--menthe)}
.rg-moment{font:800 clamp(1.125rem,1rem + .6vw,1.375rem)/1.2 var(--f-titre)}
@media (min-width:760px){.rangement{padding:24px;gap:18px}.rg-liste{font-size:1rem;gap:14px 16px}.rg-tete{font-size:1.25rem}.rg-moment{font-size:1.625rem}.rg-rendu{gap:6px;padding-top:16px}}

/* ----- Le compteur ----- */
.compteur{position:absolute;left:0;right:0;bottom:0;height:72px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 18px;background:var(--menthe);border-top:2px solid var(--encre)}
.cpt-lib{font-size:.875rem;font-weight:600;line-height:1.25;max-width:60%}
.cpt-avant{display:none}
.cpt-val{font:800 2.25rem/1 var(--f-titre);min-width:4.2ch;text-align:right;white-space:nowrap}
.scene-note{margin-top:14px;font-size:.875rem}
.scene-note a{font-weight:700}

/* ----- L'animation : n'existe que si le script a posé .joue ----- */
.joue .objet{transition:opacity .45s ease,transform .7s cubic-bezier(.5,0,.2,1)}
.joue .rangement{transition:opacity .5s ease,transform .6s cubic-bezier(.2,.8,.2,1)}
.joue .rg-rendu-titre,.joue .rg-moment{transition:opacity .45s ease,transform .5s ease}
.joue.p0 .objet{opacity:0;transform:translateY(14px) rotate(0)}
.joue.p0 .rangement{opacity:0;transform:scale(.94);visibility:hidden}
.joue.p0 .rg-rendu-titre,.joue.p0 .rg-moment{opacity:0;transform:translateY(8px)}
.joue.p0 .cpt-avant{display:inline}
.joue.p0 .cpt-apres{display:none}
.joue.p1 .objet{opacity:1}
.joue.p1 .o1{transform:rotate(-3deg);transition-delay:0s}
.joue.p1 .o2{transform:rotate(2.5deg);transition-delay:.18s}
.joue.p1 .o3{transform:rotate(1.5deg);transition-delay:.36s}
.joue.p1 .o4{transform:rotate(-2deg);transition-delay:.54s}
.joue.p1 .o5{transform:rotate(-1.5deg);transition-delay:.72s}
.joue.p1 .o6{transform:rotate(2deg);transition-delay:.9s}
.joue.p2 .objet{opacity:0;transition-delay:0s!important}
.joue.p2 .o1{transform:translate(70%,120%) scale(.3)}
.joue.p2 .o2{transform:translate(-70%,120%) scale(.3)}
.joue.p2 .o3{transform:translate(40%,10%) scale(.3)}
.joue.p2 .o4{transform:translate(-50%,0) scale(.3)}
.joue.p2 .o5{transform:translate(80%,-110%) scale(.3)}
.joue.p2 .o6{transform:translate(-60%,-110%) scale(.3)}
.joue.p2 .rangement{opacity:1;transform:none;visibility:visible;transition-delay:.25s}
.joue.p2 .cpt-avant{display:none}
.joue.p2 .cpt-apres{display:inline}
.joue.p3 .rg-rendu-titre,.joue.p3 .rg-moment{opacity:1;transform:none}
.joue.p3 .m1{transition-delay:.2s}
.joue.p3 .m2{transition-delay:.45s}
.joue.p3 .m3{transition-delay:.7s}
/* État final sans .joue : les objets ont disparu, le rangement est là. */
.scene:not(.joue) .objets{visibility:hidden}
</style>
