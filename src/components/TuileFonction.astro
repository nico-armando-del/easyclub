---
/*
  Une fonctionnalité en tuile : nom en 2 ou 3 mots, une ligne « à quoi ça sert / le temps gagné »,
  la pastille de l'offre qui l'ouvre en bas. Toute la tuile est un lien.
*/
import { NOM_OFFRE } from '../data/site'
import { i18n, SR_FR } from '../i18n/ui'
import VersFr from './langue/VersFr.astro'
import EcranFonction from './EcranFonction.astro'
/* ecran : le nom d'un écran de src/ecrans/fonctions, montré en vignette recadrée en tête de tuile
   (décoratif : la tuile garde son nom et sa ligne pour les lecteurs d'écran). */
/** fr : la tuile mène, depuis une page espagnole, à une page restée en français (étiquette « FR »). */
interface Props { nom: string; ligne: string; href: string; offre?: 'mini' | 'pro' | 'max'; titre?: 'h3' | 'h4'; ecran?: string; fr?: boolean }
const { nom, ligne, href, offre, titre = 'h3', ecran, fr = false } = Astro.props
const { t } = i18n(Astro.url)
const T = titre
---
<a class:list={['tuile-fonction', { 'tf-avec-ecran': ecran }]} href={href} hreflang={fr ? 'fr' : undefined}>
  {ecran && <span class="tf-vignette" aria-hidden="true" inert><EcranFonction nom={ecran} nu /></span>}
  <T class="tf-nom">{nom}{fr && <VersFr sr={SR_FR} />}</T>
  <span class="tf-ligne">{ligne}</span>
  {offre && <span class:list={['tf-offre', `tf-${offre}`]}>{t('Dès {offre}', { offre: NOM_OFFRE[offre] })}</span>}
</a>
<style>
.tuile-fonction{display:flex;flex-direction:column;align-items:flex-start;gap:8px;height:100%;min-height:150px;padding:24px;background:var(--blanc);border-radius:var(--r-l);text-decoration:none;box-shadow:var(--ombre-carte);transition:box-shadow var(--d-2) var(--courbe-sortie),transform var(--d-2) var(--courbe-sortie)}
.tuile-fonction:hover{box-shadow:var(--ombre-carte-survol);transform:translateY(-2px)}
.tf-nom{font:700 1.375rem/1.15 var(--f-titre);letter-spacing:-.01em}
.tf-ligne{color:var(--gris);font-size:var(--t-petit);line-height:1.45}
.tf-offre{margin-top:auto;display:inline-flex;align-items:center;min-height:26px;padding:2px 10px;border-radius:8px;background:var(--menthe-pale);color:var(--sapin);font:700 var(--t-micro)/1.2 var(--f-texte)}
.tf-offre.tf-pro{background:var(--lilas-pale);color:var(--encre)}
.tf-offre.tf-max{background:var(--encre);color:var(--menthe)}
.tf-avec-ecran{min-width:0;overflow:hidden}
.tf-vignette{position:relative;display:block;align-self:stretch;height:150px;margin:-24px -24px 8px;overflow:hidden;border-radius:var(--r-l) var(--r-l) 0 0;background:var(--papier-2,#EDE8DC);pointer-events:none}
.tf-vignette::after{content:"";position:absolute;inset:auto 0 0;height:36px;background:linear-gradient(rgba(237,232,220,0),var(--papier-2,#EDE8DC))}
.tf-vignette :global(.ecran-fonction.ef-fenetre){width:840px;margin:18px 0 0 18px;zoom:.5}
.tf-vignette :global(.ecran-fonction.ef-telephone){margin-top:14px;zoom:.5}
.tf-vignette :global(.ecran-fonction .ef-fen){box-shadow:0 0 0 1px #0E111617}
</style>
