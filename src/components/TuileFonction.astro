---
/*
  Une fonctionnalité en tuile : nom en 2 ou 3 mots, une ligne « à quoi ça sert / le temps gagné »,
  la pastille de l'offre qui l'ouvre en bas. Toute la tuile est un lien.
*/
import { NOM_OFFRE } from '../data/site'
interface Props { nom: string; ligne: string; href: string; offre?: 'mini' | 'pro' | 'max'; titre?: 'h3' | 'h4' }
const { nom, ligne, href, offre, titre = 'h3' } = Astro.props
const T = titre
---
<a class="tuile-fonction" href={href}>
  <T class="tf-nom">{nom}</T>
  <span class="tf-ligne">{ligne}</span>
  {offre && <span class:list={['tf-offre', `tf-${offre}`]}>Dès {NOM_OFFRE[offre]}</span>}
</a>
<style>
.tuile-fonction{display:flex;flex-direction:column;align-items:flex-start;gap:8px;height:100%;min-height:150px;padding:24px;background:var(--blanc);border-radius:var(--r-l);text-decoration:none;box-shadow:var(--ombre-carte);transition:box-shadow var(--d-2) var(--courbe-sortie),transform var(--d-2) var(--courbe-sortie)}
.tuile-fonction:hover{box-shadow:var(--ombre-carte-survol);transform:translateY(-2px)}
.tf-nom{font:700 1.375rem/1.15 var(--f-titre);letter-spacing:-.01em}
.tf-ligne{color:var(--gris);font-size:var(--t-petit);line-height:1.45}
.tf-offre{margin-top:auto;display:inline-flex;align-items:center;min-height:26px;padding:2px 10px;border-radius:8px;background:var(--menthe-pale);color:var(--sapin);font:700 var(--t-micro)/1.2 var(--f-texte)}
.tf-offre.tf-pro{background:var(--lilas-pale);color:var(--encre)}
.tf-offre.tf-max{background:var(--encre);color:var(--menthe)}
</style>
