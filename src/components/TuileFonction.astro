---
/* Une fonctionnalité en tuile : nom en 2 ou 3 mots, une ligne « à quoi ça sert / le temps gagné ». */
import { NOM_OFFRE } from '../data/site'
interface Props { nom: string; ligne: string; href: string; offre?: 'mini' | 'pro' | 'max'; titre?: 'h3' | 'h4' }
const { nom, ligne, href, offre, titre = 'h3' } = Astro.props
const T = titre
---
<a class="tuile-fonction" href={href}>
  <T class="tf-nom">{nom}</T>
  <span class="tf-ligne">{ligne}</span>
  {offre && offre !== 'mini' && <span class="tf-offre">Dès {NOM_OFFRE[offre]}</span>}
</a>
<style>
.tuile-fonction{display:flex;flex-direction:column;gap:6px;min-height:100%;padding:20px 20px 22px;background:var(--blanc);border-radius:var(--r-m);text-decoration:none;border:2px solid transparent;transition:border-color .15s}
.tuile-fonction:hover{border-color:var(--encre)}
.tf-nom{font:700 1.25rem/1.2 var(--f-titre);letter-spacing:-.01em}
.tf-ligne{color:var(--gris);font-size:1rem;line-height:1.45}
.tf-offre{margin-top:auto;padding-top:8px;font:700 .8125rem/1.2 var(--f-texte);color:var(--sapin)}
</style>
