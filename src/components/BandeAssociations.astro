---
/*
  LES ASSOCIATIONS EN PHOTOS : un vrai défileur horizontal (scroll-snap), une
  carte par page publiée qui a une photo, la ligne de la page TOUJOURS visible
  (un texte au survol seul serait du texte caché). Dernière carte : la case
  vide « Et la vôtre ? », vers /pour-qui. Boutons précédent / suivant dès
  760 px, ajoutés seulement avec JS ; au doigt sinon.
*/
import { photoDe, srcset } from '../data/photos'
import VersFr from './langue/VersFr.astro'

interface Item { nom: string; href: string; photo: string; ligne: string }
interface Props {
  titre: string
  phrase?: string
  items: Item[]
  derniere: { texte: string; href: string; nomAccessible?: string }
  id?: string
  precedent?: string
  suivant?: string
  versFr?: string
}
const { titre, phrase, items, derniere, id = 't-assos', precedent = 'Précédent', suivant = 'Suivant', versFr } = Astro.props
const NB = String.fromCharCode(160)
const fine = (x: string) => x.replace(/ ([?!:;])/g, `${NB}$1`)
const cartes = items.map((i) => ({ ...i, p: photoDe(i.photo) })).filter((i) => i.p)
---
<div class="bande-bloc" data-bande>
  <div class="enveloppe bande-tete">
    <div>
      <h2 class="bande-titre" id={id}>{fine(titre)}</h2>
      {phrase && <p class="bande-phrase">{fine(phrase)}</p>}
    </div>
    <div class="bande-nav" data-bande-nav>
      <button type="button" class="bande-btn" data-sens="-1" aria-label={precedent}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="bande-btn" data-sens="1" aria-label={suivant}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </div>
  <ul class="bande" data-defile-x aria-labelledby={id}>
    {cartes.map((c) => (
      <li class="bande-carte">
        <a href={c.href} hreflang={versFr ? 'fr' : undefined}>
          <img src={`/img/photos/${c.p!.fichier}-640.webp`} srcset={srcset(c.p!)} sizes="(min-width: 760px) 240px, 200px" width="640" height="427" alt="" loading="lazy" decoding="async" />
          <span class="bande-texte"><b>{c.nom}{versFr && <VersFr sr={versFr} />}</b><span>{c.ligne}</span></span>
        </a>
      </li>
    ))}
    <li class="bande-carte bande-vide">
      <a href={derniere.href} aria-label={fine(derniere.nomAccessible ?? derniere.texte)}>
        <b>{fine(derniere.texte)}</b><i class="curseur" aria-hidden="true"></i>
      </a>
    </li>
  </ul>
</div>
<script is:inline>
(function(){document.querySelectorAll('[data-bande]').forEach(function(b){var l=b.querySelector('.bande'),n=b.querySelector('[data-bande-nav]');if(!l||!n)return;n.classList.add('pret');n.querySelectorAll('button').forEach(function(x){x.addEventListener('click',function(){var c=l.querySelector('.bande-carte');var w=c?c.getBoundingClientRect().width+16:240;l.scrollBy({left:+x.getAttribute('data-sens')*w*2,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})})})})})()
</script>
<style>
.bande-tete{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
.bande-titre{font-size:var(--t-h2-idee,clamp(2rem,1.3rem + 2.6vw,3.25rem));line-height:1.05;max-width:24ch}
.bande-phrase{margin-top:12px;font-size:1.125rem;max-width:var(--lecture)}
.bande-nav{display:none;gap:8px;flex:none}
@media (min-width:760px){.bande-nav.pret{display:flex}}
.bande-btn{display:grid;place-items:center;width:44px;height:44px;border:1.5px solid var(--encre);border-radius:12px;background:transparent;color:var(--encre);cursor:pointer}
.bande-btn svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.bande-btn:hover{background:var(--encre);color:var(--blanc)}
.bande{list-style:none;margin:20px 0 0;padding:4px var(--g) 8px;display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--g);scrollbar-width:thin;max-width:var(--max-large,1360px);margin-inline:auto;overscroll-behavior-x:contain}
@media (min-width:1280px){.bande{padding-inline:max(var(--g),calc((100% - var(--max)) / 2 + var(--g)));scroll-padding-inline:max(var(--g),calc((100% - var(--max)) / 2 + var(--g)))}}
.bande-carte{flex:0 0 200px;scroll-snap-align:start}
@media (min-width:760px){.bande-carte{flex-basis:224px}}
.bande-carte a{position:relative;display:block;aspect-ratio:4/5;border-radius:var(--r-l);overflow:hidden;text-decoration:none;color:var(--blanc);background:var(--encre)}
.bande-carte img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform var(--d-3,600ms) var(--courbe-sortie,ease)}
.bande-carte a::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(11,15,20,.88) 0,rgba(11,15,20,.78) 42%,rgba(11,15,20,0) 70%)}
.bande-texte{position:absolute;left:0;right:0;bottom:0;z-index:1;display:grid;gap:6px;padding:18px}
.bande-texte b{font:700 1.375rem/1.1 var(--f-titre)}
.bande-texte span{font-size:.875rem;line-height:1.35;color:var(--texte-scene,#D7DBE1);min-height:calc(3 * 1.35em)}
.bande-carte a:hover img{transform:scale(1.04)}
.bande-carte a:hover b{text-decoration:underline;text-underline-offset:3px}
.bande-carte a:focus-visible{outline:3px solid var(--encre);outline-offset:3px}
.bande-vide a{display:flex;align-items:center;justify-content:center;gap:4px;background:var(--papier);color:var(--encre);border:2px dashed rgba(11,15,20,.4)}
.bande-vide a::after{display:none}
.bande-vide b{font:700 1.625rem/1.1 var(--f-titre)}
.curseur{display:block;width:2px;height:28px;background:var(--encre)}
@media (prefers-reduced-motion: no-preference){.curseur{animation:ba-clignote 1.1s steps(1) infinite}}
@keyframes ba-clignote{50%{opacity:0}}
</style>
