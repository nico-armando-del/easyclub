---
/*
  L'ACCUEIL TRADUIT (/en, /es) : les mêmes sections que src/pages/index.astro,
  dans le même ordre, avec les textes de src/i18n/accueil.ts.

  1. Ouverture + animation d'entrée (désordre → OnClub → temps rendu ; état
     final par défaut, sans JS ou sous reduced-motion ; scène de hauteur fixe ;
     data-scene : site.js attend la fin de l'animation pour le bandeau).
  2. Le temps (cinq tâches, hypothèses visibles). 3. Les fonctionnalités en
     tuiles, construites depuis la collection française (une fonctionnalité
     sans traduction n'apparaît pas). 4. Quatre écrans d'exemple traduits,
     animés à l'entrée dans la vue. 5. Le calculateur (public/js/calculateur.js,
     mêmes attributs data-). 6. Deux points de vue + « Pass it on to my club »
     (message prêt à envoyer, rien n'est envoyé à OnClub). 7. Pour toutes les
     associations. 8. Les offres. 9. Ressources (en français). 10. FAQ.
     11. Appel final.

  Les composants communs (AnimationEntree, BlocTemps, Calculateur, Offres,
  AppelDemo, EcranAnime) ont leurs textes en français dans le balisage : leur
  structure et leur style sont repris ici. Seule la FAQ (Faq.astro) prend
  ses textes en paramètre et est réutilisée telle quelle.
*/
import Faq from '../Faq.astro'
import VersFr from './VersFr.astro'
import { parFamille, liste, url } from '../../lib/collections'
import { OFFRES, INJEP, lienWhatsApp, EMAIL } from '../../data/site'
import { TACHES, CINQ_TACHES, TOTAL, duree, calculer, ADHERENTS_REFERENCE } from '../../data/temps'
import type { Textes, Langue } from '../../i18n/accueil'

interface Props { l: Textes; langue: Langue }
const { l, langue } = Astro.props
const sr = l.versFrSr

/* ---- Fonctionnalités : la collection française, nommée dans la langue de la page. */
const familles = (await parFamille()).map((f) => ({
  ancre: f.ancre,
  nom: l.familles[f.cle]?.nom ?? f.cle,
  phrase: l.familles[f.cle]?.phrase ?? '',
  items: f.items.filter((e) => l.fonctionnalites[e.id]).map((e) => ({ id: e.id, ...l.fonctionnalites[e.id] })),
})).filter((f) => f.items.length > 0)
const nbFonctions = familles.reduce((s, f) => s + f.items.length, 0)

/* ---- Pour toutes les associations : chaque carte mène à une page qui existe. */
const activites = await liste('activites')
const profils = await liste('profils')
const aMusique = activites.some((e) => e.id === 'ecole-de-musique')
const aTresorier = profils.some((e) => e.id === 'tresorier')
const DESTINATION = {
  sports: '/pour-qui#sports',
  musique: aMusique ? url('activites', 'ecole-de-musique') : '/pour-qui#activites',
  activites: '/pour-qui#activites',
  tresorier: aTresorier ? url('profils', 'tresorier') : '/pour-qui#profils',
  toutes: '/pour-qui',
}

/* ---- Ressources (en français). */
const guides = await liste('guides')
const articles = await liste('articles')
const comparatifs = await liste('comparatifs')
const ressources = [
  ...guides.map((e) => ({ e, c: 'guides' as const })),
  ...articles.map((e) => ({ e, c: 'articles' as const })),
  ...comparatifs.map((e) => ({ e, c: 'comparatifs' as const })),
].slice(0, 3)

/* ---- Le temps : chiffres de src/data/temps.ts, mots traduits. */
const lignesTemps = CINQ_TACHES.map((c) => ({ cle: c, ...TACHES[c], ...l.taches[c]! }))
const max = Math.max(...lignesTemps.map((x) => x.avantMin))
const pct = (m: number) => `${Math.max(1.5, (m / max) * 100).toFixed(1)}%`

/* ---- Calculateur : même donnée que l'accueil français (le contrôle vérifie 66 h → 5 h sur l'accueil). */
const r = calculer(ADHERENTS_REFERENCE)
const h = (m: number) => `${Math.round(m / 60)} h`
const donnees = JSON.stringify(CINQ_TACHES.map((c) => ({ cle: c, avant: TACHES[c].avantMin, apres: TACHES[c].apresMin, prop: TACHES[c].proportionnelle })))

const injep = langue === 'en' ? INJEP.chiffre.replace(' ', '') : INJEP.chiffre
const nomCourt = (n: string) => n.replace('OnClub ', '')
const typeDemo = '/demo'
const partage = {
  whatsapp: `https://wa.me/?text=${encodeURIComponent(l.transmettre.message)}`,
  email: `mailto:?subject=${encodeURIComponent(l.transmettre.sujet)}&body=${encodeURIComponent(l.transmettre.message)}`,
}
---
<section class="ouverture" aria-labelledby="titre">
  <div class="enveloppe ouverture-grille">
    <div class="ouverture-tete">
      <p class="surtitre">{l.ouverture.accroche}</p>
      <h1 id="titre">{l.ouverture.h1}</h1>
    </div>
    <div class="ouverture-texte">
      <p class="chapo">{l.ouverture.chapo}</p>
      <p class="ouverture-ville" data-ville-phrase={l.ouverture.villeModele}>{l.ouverture.villeDefaut}</p>
      <div class="actions">
        <a class="btn btn-encre" href={typeDemo} hreflang="fr">{l.ouverture.demo}<VersFr sr={sr} /></a>
        <a class="btn btn-blanc" href="#combien">{l.ouverture.calcul}</a>
      </div>
      <p class="ouverture-pour">{l.ouverture.pour}</p>
      <p class="ouverture-langue">{l.ouverture.langueNote}</p>
    </div>
    <div class="ouverture-scene">
      <div class="scene" data-scene aria-label={l.scene.aria} role="img">
        <div class="objets" aria-hidden="true">
          <div class="objet o1"><b>{l.scene.fiche}</b><span class="trait">{l.scene.ficheNom}</span><span class="trait">{l.scene.ficheNe}</span><span class="statut neutre">{l.scene.aRecopier}</span></div>
          <div class="objet o2"><b>{l.scene.cheque}</b><span>{l.scene.chequeDepot}</span><span class="montant">{l.scene.chequeMontant}</span></div>
          <div class="objet o3 tableur"><b>{l.scene.tableur}</b><span class="grille-xls"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
          <div class="objet o4"><b>{l.scene.relance}</b><span>{l.scene.relanceTexte}</span></div>
          <div class="objet o5"><b>{l.scene.certificat}</b><span class="statut ko">{l.scene.manquant}</span></div>
          <div class="objet o6 message"><span class="heure">23:47</span><span>{l.scene.message}</span></div>
        </div>
        <div class="rangement" aria-hidden="true">
          <p class="rg-tete"><svg aria-hidden="true"><use href="#boucle"/></svg>{l.scene.range}</p>
          <ul class="rg-liste">
            {l.scene.rangeListe.map((x) => <li><svg aria-hidden="true"><use href="#coche"/></svg>{x}</li>)}
          </ul>
          <div class="rg-rendu">
            <p class="rg-rendu-titre">≈ {TOTAL.gain} {l.scene.rendues}</p>
            <p class="rg-moment m1">{l.scene.moments[0]}</p>
            <p class="rg-moment m2">{l.scene.moments[1]}</p>
            <p class="rg-moment m3">{l.scene.moments[2]}</p>
          </div>
        </div>
        <div class="compteur" aria-hidden="true">
          <span class="cpt-lib"><span class="cpt-avant">{l.scene.cptAvant}</span><span class="cpt-apres">{l.scene.cptApres} {TOTAL.avant}</span></span>
          <b class="cpt-val num" data-compteur>≈ {TOTAL.apres}</b>
        </div>
      </div>
      <p class="scene-note">{l.scene.note} <a href="/temps-gagne#hypotheses" hreflang="fr">{l.scene.noteLien}<VersFr sr={sr} /></a></p>
    </div>
  </div>
</section>

<section class="section temps" id="temps" aria-labelledby="t-temps">
  <div class="enveloppe temps-grille">
    <div class="tete-section">
      <p class="surtitre">{l.temps.surtitre}</p>
      <h2 id="t-temps">{l.temps.h2}</h2>
      <p class="intro">{l.temps.intro}</p>
      <p class="temps-injep"><b>{injep}</b> {l.temps.injepTexte} <a href={INJEP.source} target="_blank" rel="noopener" hreflang="fr">{l.temps.injepSource}</a></p>
    </div>
    <aside class="bloc-temps" aria-label={l.temps.blocAria}>
      <p class="bt-titre">{l.temps.blocTitre}</p>
      <ul class="bt-lignes">
        {lignesTemps.map((x) => (
          <li>
            <div class="bt-tache"><b>{x.tache}</b><span>{x.calcul}</span></div>
            <div class="bt-barres">
              <div class="bt-barre avant"><span class="bt-lib">{l.temps.aujourdhui}</span><span class="bt-piste"><i style={`width:${pct(x.avantMin)}`}></i></span><b>{duree(x.avantMin)}</b></div>
              <div class="bt-barre apres"><span class="bt-lib">{l.temps.avecOnclub}</span><span class="bt-piste"><i style={`width:${pct(x.apresMin)}`}></i></span><b>{duree(x.apresMin)}</b></div>
              <p class="bt-comment">{x.comment}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="bt-hyp">{l.temps.hypotheses} <a href="/temps-gagne#hypotheses" hreflang="fr">{l.temps.voirCalcul}<VersFr sr={sr} /></a></p>
    </aside>
  </div>
</section>

<section class="section fonctions" id="fonctionnalites" aria-labelledby="t-fonctions">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.fonctions.surtitre}</p>
      <h2 id="t-fonctions">{l.fonctions.h2(nbFonctions)}</h2>
      <p class="intro">{l.fonctions.intro}</p>
    </div>
    <div class="familles">
      {familles.map((f) => (
        <section class="famille" aria-labelledby={`fam-${f.ancre}`}>
          <h3 id={`fam-${f.ancre}`}><a href={`/fonctionnalites#${f.ancre}`} hreflang="fr">{f.nom}</a></h3>
          <p class="famille-phrase">{f.phrase}</p>
          <ul>
            {f.items.map((e) => (
              <li><a href={url('fonctionnalites', e.id)} hreflang="fr"><b>{e.nom}</b><span>{e.ligne}</span></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <a class="lien-fleche" href="/fonctionnalites" hreflang="fr">{l.fonctions.tout}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
  </div>
</section>

<section class="section fond-encre sur-encre ecrans" aria-labelledby="t-ecrans">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.ecrans.surtitre}</p>
      <h2 id="t-ecrans">{l.ecrans.h2}</h2>
      <p class="intro">{l.ecrans.intro}</p>
    </div>
    <div class="ecrans-liste">
      {l.ecrans.items.map((x, i) => (
        <article class:list={['ecran-ligne', { inverse: i % 2 === 1 }]}>
          <div class="ecran-texte">
            <p class="surtitre">{x.famille}</p>
            <h3>{x.titre}</h3>
            <p>{x.texte}</p>
            <a class="lien-fleche" href={x.lien} hreflang="fr">{x.lienNom}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
          </div>
          <figure class="ml-ecran">
            <div class="ml-cadre" data-ml-ecran>
              <div class="ml-tete"><span class="ml-sigle" aria-hidden="true">VC</span><span class="ml-asso">{x.asso}</span><span class="exemple">{l.ecrans.exemple}</span></div>
              <p class="ml-titre">{x.ecranTitre}</p>
              {x.ecranSous && <p class="ml-sous">{x.ecranSous}</p>}
              <ul class="ml-lignes">
                {x.lignes.map((g, j) => (
                  <li style={`--i:${j}`}><span class="ml-nom"><b>{g.nom}</b>{g.detail && <span>{g.detail}</span>}</span>{g.statut && <span class:list={['statut', g.ton ?? 'neutre']}>{g.statut}</span>}</li>
                ))}
              </ul>
              {x.pied && <p class="ml-pied" style={`--i:${x.lignes.length}`}><span>{x.pied.libelle}</span><b class="num">{x.pied.valeur}</b></p>}
              {x.bouton && <span class="ml-bouton" aria-hidden="true" style={`--i:${x.lignes.length + 1}`}>{x.bouton}</span>}
            </div>
            <figcaption><span class="exemple">{l.ecrans.exemple}</span> {x.legende}</figcaption>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section calcul" id="combien" aria-labelledby="t-calcul">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.calc.surtitre}</p>
      <h2 id="t-calcul">{l.calc.h2}</h2>
      <p class="intro">{l.calc.intro}</p>
    </div>
    <div class="calcul-boite">
      <div class="calculateur grand" id="calculateur" data-calculateur={donnees}>
        <div class="calc-entree">
          <label for="calculateur-n">{l.calc.label}</label>
          <div class="calc-champs">
            <input id="calculateur-n" type="number" inputmode="numeric" min="10" max="5000" step="1" value={ADHERENTS_REFERENCE} data-calc-n>
            <input type="range" min="10" max="1500" step="10" value={ADHERENTS_REFERENCE} aria-label={l.calc.curseur} data-calc-curseur>
          </div>
          <p class="calc-sansjs">{l.calc.sansJs}</p>
        </div>
        <div class="calc-resultat" aria-live="polite">
          <div class="calc-totaux">
            <div><span>{l.calc.aujourdhui}</span><b class="num" data-calc-avant>≈ {h(r.avant)}</b></div>
            <div><span>{l.calc.avec}</span><b class="num" data-calc-apres>≈ {h(r.apres)}</b></div>
            <div class="calc-gain"><span>{l.calc.rendues}</span><b class="num" data-calc-gain>≈ {h(r.gain)}</b></div>
          </div>
          <table class="calc-table">
            <caption class="sr">{l.calc.caption}</caption>
            <thead><tr><th scope="col">{l.calc.tache}</th><th scope="col">{l.calc.aujourdhui}</th><th scope="col">{l.calc.avec}</th></tr></thead>
            <tbody>
              {r.lignes.map((x) => (
                <tr data-calc-ligne={x.cle}><th scope="row">{l.taches[x.cle]?.tache}</th><td class="num" data-avant>{duree(x.avant)}</td><td class="num" data-apres>{duree(x.apres)}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="calc-note">{l.calc.note} <a href="/temps-gagne#hypotheses" hreflang="fr">{l.calc.noteLien}<VersFr sr={sr} /></a>.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section fond-blanc points" aria-labelledby="t-points">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.points.surtitre}</p>
      <h2 id="t-points">{l.points.h2}</h2>
    </div>
    <div class="points-grille">
      <article class="point">
        <h3>{l.points.benevole.titre}</h3>
        <p class="point-chapo">{l.points.benevole.chapo}</p>
        <ul>{l.points.benevole.items.map(([a, b]) => <li><b>{a}</b>{b}</li>)}</ul>
        <a class="btn btn-encre" href="/demo" hreflang="fr">{l.points.demo}<VersFr sr={sr} /></a>
      </article>
      <article class="point point-lilas">
        <h3>{l.points.membre.titre}</h3>
        <p class="point-chapo">{l.points.membre.chapo}</p>
        <ul>{l.points.membre.items.map(([a, b]) => <li><b>{a}</b>{b}</li>)}</ul>
        <a class="btn btn-contour" href="#transmettre"><svg aria-hidden="true"><use href="#partage"/></svg>{l.points.transmettre}</a>
      </article>
    </div>
    <div class="transmettre" id="transmettre">
      <div>
        <h3>{l.transmettre.titre}</h3>
        <p>{l.transmettre.texte}</p>
      </div>
      <div class="transmettre-actions">
        <a class="btn btn-encre" href={partage.whatsapp} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa"/></svg>{l.transmettre.whatsapp}</a>
        <a class="btn btn-contour" href={partage.email}><svg aria-hidden="true"><use href="#courriel"/></svg>{l.transmettre.email}</a>
        <a class="lien-fleche" href="/recommander" hreflang="fr">{l.transmettre.outil}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
      </div>
    </div>
  </div>
</section>

<section class="section associations" aria-labelledby="t-assos">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.assos.surtitre}</p>
      <h2 id="t-assos">{l.assos.h2}</h2>
      <p class="intro">{l.assos.intro}</p>
    </div>
    <div class="assos-grille">
      {l.assos.cartes.map((c) => (
        <a class:list={['carte-lien', { 'carte-toutes': c.cle === 'toutes' }]} href={DESTINATION[c.cle]} hreflang="fr"><small>{c.etiquette}</small><b>{c.nom}<VersFr sr={sr} /></b><span>{c.ligne}</span></a>
      ))}
    </div>
  </div>
</section>

<section class="section fond-menthe offres-accueil" id="offres" aria-labelledby="t-offres">
  <div class="enveloppe">
    <div class="tete-section">
      <p class="surtitre">{l.offres.surtitre}</p>
      <h2 id="t-offres">{l.offres.h2}</h2>
      <p class="intro">{l.offres.intro}</p>
    </div>
    <div class="offres">
      {OFFRES.map((o) => (
        <article class:list={['offre', { 'offre-phare sur-encre': o.phare }]}>
          <h3 class="offre-nom">{o.nom}</h3>
          <p class="offre-temps"><b class="num">≈ {o.heures} h</b> {l.offres.rendues}</p>
          <p class="offre-taux num">{l.offres.taux[o.cle]}</p>
          <p class="offre-leg">{l.offres.leg(o.tauxBoutique && (langue === 'en' ? o.tauxBoutique.replace(' ', '') : o.tauxBoutique))}</p>
          <ul>{l.offres.ouvre[o.cle].map((x) => <li>{x}</li>)}</ul>
          <a class:list={['btn', o.phare ? 'btn-menthe' : 'btn-contour']} href={`/demo?offre=${o.cle}`} hreflang="fr">{l.offres.voir(nomCourt(o.nom))}<VersFr sr={sr} /></a>
        </article>
      ))}
    </div>
    <p class="note offres-note">{l.offres.note} <a href="/tarifs#exemple" hreflang="fr">{l.offres.noteLien}<VersFr sr={sr} /></a>.</p>
    <a class="lien-fleche" href="/tarifs" hreflang="fr">{l.offres.detail}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
  </div>
</section>

{ressources.length > 0 && (
  <section class="section ressources-accueil" aria-labelledby="t-ressources">
    <div class="enveloppe">
      <div class="tete-section">
        <p class="surtitre">{l.ressources.surtitre}</p>
        <h2 id="t-ressources">{l.ressources.h2}</h2>
        <p class="intro">{l.ressources.intro}</p>
      </div>
      <ul class="grille grille-3 liste-nue">
        {ressources.map(({ e, c }) => (
          <li><a class="carte-lien" href={url(c, e.id)} hreflang="fr"><small>{l.ressources.etiquettes[c]}<VersFr sr={sr} /></small><b lang="fr">{e.data.nom}</b><span lang="fr">{e.data.ligne}</span></a></li>
        ))}
      </ul>
      <a class="lien-fleche" href="/ressources" hreflang="fr">{l.ressources.tout}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
    </div>
  </section>
)}

<div class="section fond-blanc">
  <div class="enveloppe"><Faq items={l.faq} titre={l.faqTitre} /></div>
</div>

<section class="appel-demo sur-encre" aria-labelledby="appel-demo-titre">
  <div class="enveloppe appel-grille">
    <div>
      <p class="surtitre">{l.appel.surtitre}</p>
      <h2 id="appel-demo-titre">{l.appel.titre}</h2>
      <p class="intro">{l.appel.texte}</p>
    </div>
    <div class="appel-actions">
      <a class="btn btn-menthe" href="/demo" hreflang="fr">{l.appel.preparer}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
      <a class="btn btn-contour" href={lienWhatsApp(l.appel.message)} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa"/></svg>{l.appel.whatsapp}</a>
      <a class="btn btn-contour" href={`mailto:${EMAIL}?subject=${encodeURIComponent(l.appel.sujet)}&body=${encodeURIComponent(l.appel.message)}`}><svg aria-hidden="true"><use href="#courriel"/></svg>{l.appel.email}</a>
      <p class="appel-membre">{l.appel.membre} <a href="#transmettre">{l.appel.membreLien}</a></p>
    </div>
  </div>
</section>

<script is:inline>
/* L'animation d'entrée : la même que l'accueil français (AnimationEntree.astro). */
(function () {
  var s = document.querySelector('[data-scene]')
  if (!s || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
  var v = s.querySelector('[data-compteur]')
  function compte(de, a, ms, prefixe) {
    var t0 = performance.now()
    ;(function pas(t) {
      var k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 3)
      v.textContent = prefixe + Math.round(de + (a - de) * e) + ' h'
      if (k < 1) requestAnimationFrame(pas)
    })(t0)
  }
  s.classList.add('joue', 'p0')
  v.textContent = '0 h'
  setTimeout(function () { s.classList.add('p1'); compte(0, 66, 1700, '') }, 120)
  setTimeout(function () { s.classList.add('p2'); compte(66, 5, 800, '≈ ') }, 2700)
  setTimeout(function () { s.classList.add('p3') }, 3600)
  setTimeout(function () { s.classList.remove('joue', 'p0', 'p1', 'p2', 'p3'); v.textContent = '≈ 5 h' }, 5200)
})()
/* Les écrans d'exemple : les lignes arrivent l'une après l'autre quand l'écran entre dans la vue. */
;(function () {
  if (!('IntersectionObserver' in window)) return
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
  document.querySelectorAll('[data-ml-ecran]').forEach(function (el) {
    el.classList.add('ml-attend')
    var o = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { el.classList.remove('ml-attend'); el.classList.add('ml-joue'); o.disconnect() } })
    }, { threshold: 0.35 })
    o.observe(el)
  })
})()
</script>
