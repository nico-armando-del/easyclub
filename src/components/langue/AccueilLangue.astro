---
/*
  L'ACCUEIL TRADUIT (/en, /es), ALIGNÉ SUR LE NOUVEL ACCUEIL FRANÇAIS
  (src/pages/index.astro) : mêmes écrans, même ordre, mêmes composants.

  1. Le héros : le produit en scène (SceneAccueil, prop t ; écrans traduits en
     slots) et la note de langue, visible.
  2. Avec ou sans OnClub (SemaineBureau, prop t ; écrans traduits en slots).
  3. Les fonctionnalités en bento (familles traduites).
  4. Le produit qui tourne : les écrans traduits (EcranTraduit).
  5. Les sites de club de démonstration. 6. Les associations en photos (les clubs de sport d’abord).
  7. Les offres (mode accueil). 8. La FAQ : les six mêmes questions (JSON-LD
     construit par LayoutLangue à partir de la même liste).
  9. L'appel final et « Pass it on to my club » (message prêt à envoyer,
     rien n'est envoyé à OnClub ; /recommander est en français).

  Mots : src/i18n/refonte.ts (nouveaux) et src/i18n/accueil.ts (le reste).
  Les liens vers une page française portent l'étiquette « FR ».
*/
import SceneAccueil from '../SceneAccueil.astro'
import SemaineBureau from '../SemaineBureau.astro'
import MiniEcran from '../MiniEcran.astro'
import Bento from '../Bento.astro'
import OngletsProduit from '../OngletsProduit.astro'
import VitrineClubs from '../VitrineClubs.astro'
import BandeAssociations from '../BandeAssociations.astro'
import Offres, { type TextesOffres } from '../Offres.astro'
import Faq from '../Faq.astro'
import VersFr from './VersFr.astro'
import EcranTraduit from './EcranTraduit.astro'
import { liste, url } from '../../lib/collections'
import { INJEP } from '../../data/site'
import { cartesSports } from '../../i18n/bande'
import type { Textes, Langue } from '../../i18n/accueil'
import { REFONTE } from '../../i18n/refonte'

interface Props { l: Textes; langue: Langue }
const { l, langue } = Astro.props
const r = REFONTE[langue]
const sr = l.versFrSr

const injep = langue === 'en' ? INJEP.chiffre.replace(' ', '') : INJEP.chiffre

/* ---- Les onglets : les écrans traduits, retrouvés par leur lien. */
const ecran = (href: string) => l.ecrans.items.find((x) => x.lien === href)
const eIns = ecran('/fonctionnalites/inscription-en-ligne')
const eRel = ecran('/fonctionnalites/relance-un-clic')
const eRen = ecran('/fonctionnalites/saison-suivante')
const eCompo = ecran('/fonctionnalites/compo-du-match')
const { tableau: eTab, convocations: eConv, site: eSite } = r.ecrans
/* L'inscription et la relance sont dans le héros : les onglets montrent la suite (le visiteur clique, rien ne s'enchaîne). */
const DEF = [
  { id: 'rentree', ecran: 'reinscription' as const, x: eRen, href: '/fonctionnalites/saison-suivante' },
  { id: 'compo', ecran: 'terrain' as const, x: eCompo, href: '/fonctionnalites/compo-du-match' },
  { id: 'convocations', ecran: 'terrain' as const, x: eConv, href: '/fonctionnalites/convocations' },
  { id: 'site', ecran: 'site' as const, x: eSite, href: '/fonctionnalites/site-association' },
]
const onglets = DEF.map((d, i) => ({ id: d.id, ecran: d.ecran, libelle: r.onglets.libelles[i], phrase: d.x?.titre ?? '', lien: { texte: d.x?.lienNom ?? r.onglets.libelles[i], href: d.href } }))


/* ---- La bande : les clubs de sport d'abord (au moins 8, src/i18n/bande.ts), puis la musique et le théâtre (cartes traduites). */
const activites = await liste('activites')
const ARTS = { musique: 'ecole-de-musique', activites: 'theatre' } as const
const arts = l.assos.cartes
  .filter((c) => c.cle === 'musique' || c.cle === 'activites')
  .map((c) => { const id = ARTS[c.cle as keyof typeof ARTS]; return { nom: c.nom, ligne: c.ligne, photo: id, href: activites.some((e) => e.id === id) ? url('activites', id) : '/pour-qui#activites' } })
const bande = [...(await cartesSports(langue)), ...arts]

/* ---- Les offres : les mots et les listes traduits ; les hypothèses sans leur préfixe « * Estimation… ». */
const offres: TextesOffres = {
  rendues: r.offres.rendues,
  leg: '',
  boutique: r.offres.boutique,
  ouvre: r.offres.ouvre,
  note: r.offres.note,
  comment: r.offres.comment,
  hypotheses: l.offres.note.replace(/^\*\s*[^.]*\.\s*/, ''),
  listes: l.offres.ouvre,
  demo: l.offres.voir,
  taux: l.offres.taux,
}

/* ---- Les ressources (en français). */
const ressources = [
  ...(await liste('guides')).map((e) => ({ e, c: 'guides' as const })),
  ...(await liste('articles')).map((e) => ({ e, c: 'articles' as const })),
  ...(await liste('comparatifs')).map((e) => ({ e, c: 'comparatifs' as const })),
].slice(0, 3)

const partage = {
  whatsapp: `https://wa.me/?text=${encodeURIComponent(l.transmettre.message)}`,
  email: `mailto:?subject=${encodeURIComponent(l.transmettre.sujet)}&body=${encodeURIComponent(l.transmettre.message)}`,
}
const NB = String.fromCharCode(160)
const fine = (s: string) => (langue === 'es' ? s : s.replace(/ ([?!:;])/g, `${NB}$1`))
---
<SceneAccueil titre={r.h1} phrase={r.phrase} cta={{ texte: r.bouton, href: '/demo' }} ctaVersFr={sr} noteLangue={r.noteLangue} t={r.scene} lienCalcul="#temps">
  {eIns && <EcranTraduit slot="ecran-tel" x={eIns} />}
  <EcranTraduit slot="ecran-tab" x={eTab} />
</SceneAccueil>

<SemaineBureau t={r.semaine} versFr={sr} id="temps" mots={r.temps.mots}>
  {eIns && <EcranTraduit slot="ecran-0" x={eIns} />}
  <EcranTraduit slot="ecran-1" x={eTab} />
  {eRel && <EcranTraduit slot="ecran-2" x={eRel} />}
  {eRen && <EcranTraduit slot="ecran-4" x={eRen} />}
  <Fragment slot="hypotheses">
    <p>{l.temps.hypotheses}</p>
    <p><b>{injep}</b> {l.temps.injepTexte} <a href={INJEP.source} target="_blank" rel="noopener" hreflang="fr">{l.temps.injepSource}</a></p>
  </Fragment>
</SemaineBureau>

<section class="section" id="fonctionnalites" aria-labelledby="t-bento">
  <div class="enveloppe">
    <Bento titre={r.bento.titre} lienTexte={r.bento.lien} familles={l.familles} langue={langue} versFr={sr} />
  </div>
</section>

<section class="section" aria-labelledby="onglets-titre">
  <div class="enveloppe sur-encre">
    <OngletsProduit titre={r.onglets.titre} onglets={onglets} legende={r.onglets.legende} versFr={sr} pause={{ pause: r.onglets.pause, reprise: r.onglets.reprise }}>
      {eRen && <EcranTraduit slot="ecran-rentree" x={eRen} />}
      {eCompo && <EcranTraduit slot="ecran-compo" x={eCompo} />}
      <EcranTraduit slot="ecran-convocations" x={eConv} />
      <EcranTraduit slot="ecran-site" x={eSite} />
    </OngletsProduit>
  </div>
</section>

<section class="section">
  <div class="enveloppe">
    <VitrineClubs titre={r.vitrine.titre} phrase={r.vitrine.phrase} legende={r.vitrine.legende} mots={r.vitrine.mots} lien={{ texte: r.vitrine.lien, href: '/fonctionnalites/site-association' }} />
  </div>
</section>

<section class="section" aria-labelledby="t-assos">
  <BandeAssociations titre={r.bande.titre} phrase={r.bande.phrase} items={bande} derniere={{ texte: r.bande.derniere, href: '/pour-qui', nomAccessible: r.bande.derniereNom }} precedent={r.bande.precedent} suivant={r.bande.suivant} versFr={sr} />
</section>

<section class="section fond-blanc" id="offres" aria-labelledby="t-offres">
  <div class="enveloppe">
    <div class="langue-tete">
      <h2 class="h2-idee" id="t-offres">{r.offres.h2}</h2>
      <p class="intro">{r.offres.intro}</p>
    </div>
    <div class="langue-offres"><Offres mode="accueil" t={offres} /></div>
    <a class="lien-fleche" href="/tarifs" hreflang="fr">{r.offres.detail}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
  </div>
</section>

<div class="section fond-blanc">
  <div class="enveloppe">
    <Faq items={l.faq} titre={r.faq.titre} disposition="deux-colonnes">
      {ressources.length > 0 && (
        <p class="langue-guides">
          <span>{fine(r.faq.guides)}</span>
          {ressources.map(({ e, c }) => <a href={url(c, e.id)} hreflang="fr" lang="fr">{e.data.nom}<VersFr sr={sr} /></a>)}
          <a class="lien-fleche" href="/ressources" hreflang="fr">{r.faq.toutes}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
        </p>
      )}
    </Faq>
  </div>
</div>

<section class="appel-langue" aria-labelledby="appel-titre" data-sans-bouton-fixe>
  <div class="enveloppe">
    <div class="al-panneau sur-encre">
      <h2 id="appel-titre" class="al-titre">{r.appel.titre}</h2>
      <p class="al-phrase">{r.appel.phrase}</p>
      <a class="btn btn-menthe" href="/demo" hreflang="fr">{r.appel.bouton}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
      <details class="transmettre" id="transmettre">
        <summary>{fine(r.appel.membre)}</summary>
        <div class="transmettre-corps">
          <p><b>{l.transmettre.titre}</b> {l.transmettre.texte}</p>
          <div class="transmettre-actions">
          <a class="btn btn-contour" href={partage.whatsapp} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#wa"/></svg>{l.transmettre.whatsapp}</a>
          <a class="btn btn-contour" href={partage.email}><svg aria-hidden="true"><use href="#courriel"/></svg>{l.transmettre.email}</a>
          <a class="lien-fleche" href="/recommander" hreflang="fr">{l.transmettre.outil}<VersFr sr={sr} /> <svg aria-hidden="true"><use href="#fleche"/></svg></a>
        </div>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
.langue-offres{margin-top:40px}
.langue-offres + .lien-fleche{margin-top:12px}
@media (min-width:1000px){.langue-tete{display:grid;grid-template-columns:5fr 7fr;gap:var(--e-7,48px);align-items:end}.langue-tete .intro{margin:0}}
.langue-tete h2{max-width:16ch}
.langue-guides{display:flex;flex-wrap:wrap;align-items:center;gap:4px 20px;margin-top:24px;font-size:.9375rem;color:var(--gris)}
.langue-guides span{font-weight:600;color:var(--encre)}
.langue-guides a:not(.lien-fleche){display:inline-flex;align-items:center;min-height:44px;font-weight:600;color:var(--encre);text-underline-offset:3px}
.langue-guides .lien-fleche{color:var(--sapin)}
.appel-langue{padding-block:var(--section)}
.al-panneau{background:var(--scene);background-image:var(--lueur);color:var(--blanc);border-radius:var(--r-panneau);padding:var(--e-7) 20px;display:flex;flex-direction:column;align-items:center;text-align:center}
@media (min-width:760px){.al-panneau{padding:var(--e-8)}}
.al-titre{font-size:clamp(2.125rem,1.4rem + 3vw,4.5rem);line-height:1.04;letter-spacing:-.02em;max-width:16ch}
.al-phrase{margin-top:var(--e-5);max-width:var(--lecture);color:var(--texte-scene);font-size:var(--t-chapo)}
.al-panneau > .btn{margin-top:var(--e-6)}
@media (max-width:759px){.al-panneau > .btn{width:100%;padding-inline:16px}}
.transmettre{margin-top:var(--e-3);width:100%;max-width:720px;scroll-margin-top:24px}
.transmettre summary{display:inline-flex;align-items:center;gap:8px;min-height:44px;cursor:pointer;color:var(--blanc);font-weight:600;text-decoration:underline;text-underline-offset:3px}
.transmettre-corps{margin-top:12px;padding:20px;border:1px solid var(--trait-scene);border-radius:var(--r-l);display:grid;gap:16px;text-align:left}
.transmettre-corps p{max-width:var(--lecture);color:var(--texte-scene)}
.transmettre-corps b{color:var(--blanc)}
.transmettre-actions{display:grid;gap:12px}
.transmettre-actions .btn{width:100%;color:var(--blanc)}
.transmettre-actions .lien-fleche{color:var(--menthe)}
</style>
