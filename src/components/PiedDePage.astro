---
/*
  LE PIED DE PAGE (maquettes §B.1 et §F). Fond encre. La marque et ACCROCHE, puis
  cinq colonnes : Fonctionnalités · Sports · Activités · Ressources · OnClub.
  Sports et activités : les 10 premiers (ordre, puis nom), puis « Tous… (N) » vers
  /pour-qui, qui lie TOUTES les pages : le pied ne grandit plus avec le catalogue.
  Chaque colonne est un <details open> : sans JavaScript, tout est ouvert ; sous
  760 px, un script les referme (accordéons du téléphone).
*/
import { FAMILLES, EMAIL, lienWhatsApp, ACCROCHE, MESSAGE_DEMO } from '../data/site'
import { catalogue } from '../lib/collections'
import { i18n, SR_FR } from '../i18n/ui'
import { jumelles } from '../i18n/liens'
import VersFr from './langue/VersFr.astro'
const { langue, t, lien, versFr } = i18n(Astro.url)
const LIMITE = 10
const fonctions = await catalogue('fonctionnalites', langue)
const sports = await catalogue('sports', langue)
const activites = await catalogue('activites', langue)
const profils = await catalogue('profils', langue)
/* Le sélecteur de langue : la page jumelle (même chemin), sinon l'accueil de l'autre langue. */
interface Props { chemin?: string }
const paire = jumelles(Astro.props.chemin ?? (langue === 'es' ? '/es' : '/'))
const fr = (x: { fr: boolean }) => (x.fr ? 'fr' : undefined)
/** Un lien fixe du pied : l'adresse dans la langue, et l'étiquette « FR » s'il reste en français. */
const L = (chemin: string) => ({ href: lien(chemin), hreflang: versFr(chemin) ? 'fr' : undefined, fr: versFr(chemin) })
const lignes = {
  ressources: L('/ressources'), comparatifs: L('/ressources#comparatifs'), temps: L('/temps-gagne'), presentation: L('/presentation'),
  tarifs: L('/tarifs'), demo: L('/demo'), recommander: L('/recommander'),
  mentions: L('/mentions-legales'), confidentialite: L('/confidentialite'), conditions: L('/conditions'), credits: L('/credits-photos'),
}
const annee = new Date().getFullYear()
---
<footer class="pied sur-encre" data-sans-bouton-fixe>
  <div class="enveloppe">
    <div class="pied-haut">
      <div class="pied-marque">
        <a class="marque" href={lien('/')} aria-label={t('OnClub, accueil')}><svg aria-hidden="true"><use href="#boucle"/></svg>OnClub</a>
        <p class="pied-accroche">{t(ACCROCHE)}</p>
        <a class="btn btn-menthe btn-petit pied-demo" href={lignes.demo.href}>{t('Demander une démo')}</a>
      </div>
      <nav class="pied-grille" aria-label={t('Plan du site')}>
        <details open class="pied-col">
          <summary><h2>{t('Fonctionnalités')}</h2></summary>
          <ul>
            {FAMILLES.map((f) => <li><a href={lien(`/fonctionnalites#${f.ancre}`)}>{t(f.cle)}</a></li>)}
            <li><a class="tous" href={lien('/fonctionnalites')}>{t('Toutes ({n})', { n: fonctions.length })}</a></li>
          </ul>
        </details>
        <details open class="pied-col">
          <summary><h2>{t('Sports')}</h2></summary>
          <ul>
            {sports.slice(0, LIMITE).map((e) => <li><a href={e.url} hreflang={fr(e)}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a></li>)}
            {sports.length > 1
              ? <li><a class="tous" href={lien('/pour-qui#sports')}>{t('Tous les sports ({n})', { n: sports.length })}</a></li>
              : <li><a class="tous" href={lien('/pour-qui')}>{t('Toutes les associations')}</a></li>}
          </ul>
        </details>
        <details open class="pied-col">
          <summary><h2>{t('Activités')}</h2></summary>
          <ul>
            {activites.slice(0, LIMITE).map((e) => <li><a href={e.url} hreflang={fr(e)}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a></li>)}
            <li><a class="tous" href={lien('/pour-qui#activites')}>{t('Toutes les activités ({n})', { n: activites.length })}</a></li>
          </ul>
        </details>
        <details open class="pied-col">
          <summary><h2>{t('Ressources')}</h2></summary>
          <ul>
            <li><a href={lignes.ressources.href} hreflang={lignes.ressources.hreflang}>{t('Guides et articles')}{lignes.ressources.fr && <VersFr sr={SR_FR} />}</a></li>
            <li><a href={lignes.comparatifs.href} hreflang={lignes.comparatifs.hreflang}>{t('Comparatifs')}{lignes.comparatifs.fr && <VersFr sr={SR_FR} />}</a></li>
            <li><a href={lignes.temps.href} hreflang={lignes.temps.hreflang}>{t('Le temps gagné')}{lignes.temps.fr && <VersFr sr={SR_FR} />}</a></li>
            {langue !== 'es' && <li><a href={lignes.presentation.href} hreflang={lignes.presentation.hreflang}>{t('La présentation')}{lignes.presentation.fr && <VersFr sr={SR_FR} />}</a></li>}
          </ul>
          {profils.length > 0 && <>
            <h3 class="pied-sous">{t('Votre rôle')}</h3>
            <ul>{profils.map((e) => <li><a href={e.url} hreflang={fr(e)}>{e.nom}{e.fr && <VersFr sr={SR_FR} />}</a></li>)}</ul>
          </>}
        </details>
        <details open class="pied-col">
          <summary><h2>OnClub</h2></summary>
          <ul>
            <li><a href={lignes.tarifs.href} hreflang={lignes.tarifs.hreflang}>{t('Tarifs')}{lignes.tarifs.fr && <VersFr sr={SR_FR} />}</a></li>
            <li><a href={lignes.demo.href} hreflang={lignes.demo.hreflang}>{t('Demander une démo')}{lignes.demo.fr && <VersFr sr={SR_FR} />}</a></li>
            <li><a href={lignes.recommander.href} hreflang={lignes.recommander.hreflang}>{t('Transmettre à mon club')}{lignes.recommander.fr && <VersFr sr={SR_FR} />}</a></li>
            <li><a href={lienWhatsApp(t(MESSAGE_DEMO))} rel="noopener" target="_blank">WhatsApp</a></li>
            <li><a href={`mailto:${EMAIL}`}>{t('Écrire un e-mail')}</a></li>
          </ul>
        </details>
      </nav>
    </div>
    <div class="pied-bas">
      <span>© {annee} OnClub</span>
      <a href={lignes.mentions.href} hreflang={lignes.mentions.hreflang}>{t('Mentions légales')}{lignes.mentions.fr && <VersFr sr={SR_FR} />}</a>
      <a href={lignes.confidentialite.href} hreflang={lignes.confidentialite.hreflang}>{t('Confidentialité')}{lignes.confidentialite.fr && <VersFr sr={SR_FR} />}</a>
      <a href={lignes.conditions.href} hreflang={lignes.conditions.hreflang}>{t('Conditions')}{lignes.conditions.fr && <VersFr sr={SR_FR} />}</a>
      <a href={lignes.credits.href} hreflang={lignes.credits.hreflang}>{t('Crédits photos')}{lignes.credits.fr && <VersFr sr={SR_FR} />}</a>
      <button type="button" class="pied-cookies" data-consentement-ouvrir>{t('Cookies et localisation')}</button>
      <span class="pied-langues" role="group" aria-label={t('Langue')}>
        {langue === 'fr'
          ? <><span class="pied-langue-active" lang="fr" aria-current="true">Français</span><a href={paire.es ?? '/es'} hreflang="es" lang="es">Español</a></>
          : <><a href={paire.fr} hreflang="fr" lang="fr">Français</a><span class="pied-langue-active" lang="es" aria-current="true">Español</span></>}
        <a href="/en" hreflang="en" lang="en">English</a>
      </span>
    </div>
  </div>
</footer>

<script>
  /* Sous 760 px, les colonnes deviennent des accordéons fermés ; au-dessus, elles restent ouvertes. */
  const etroit = matchMedia('(max-width:759px)')
  const cols = document.querySelectorAll<HTMLDetailsElement>('.pied-col')
  const regle = () => cols.forEach((d) => { d.open = !etroit.matches; const s = d.querySelector('summary'); if (s) s.tabIndex = etroit.matches ? 0 : -1 })
  regle()
  etroit.addEventListener('change', regle)
  cols.forEach((d) => d.querySelector('summary')?.addEventListener('click', (e) => { if (!etroit.matches) e.preventDefault() }))
</script>

<style>
.pied{background:var(--encre);color:var(--texte-scene);padding-block:40px 84px;font-size:.9375rem}
@media (min-width:760px){.pied{padding-block:48px 20px}}
.pied-haut{display:grid;gap:24px}
@media (min-width:1000px){.pied-haut{grid-template-columns:repeat(12,minmax(0,1fr));gap:0 var(--col-gap)}.pied-marque{grid-column:1 / span 3}.pied-grille{grid-column:4 / span 9}}
.pied-marque{display:flex;flex-direction:column;align-items:flex-start;gap:12px}
@media (min-width:760px){.pied-marque{gap:16px}}
.pied .marque{display:inline-flex;align-items:center;gap:10px;min-height:44px;color:var(--blanc);text-decoration:none;font:700 1.375rem/1 var(--f-titre)}
.pied .marque svg{width:56px;height:28px;color:var(--menthe)}
.pied-accroche{font:700 1.375rem/1.15 var(--f-titre);color:var(--blanc)}
@media (min-width:1000px){.pied-accroche{font-size:1.75rem;max-width:11ch}}
.pied-grille{display:grid;grid-template-columns:1fr}
@media (min-width:760px){.pied-grille{grid-template-columns:repeat(5,minmax(0,1fr));gap:0 var(--col-gap)}}
.pied-col summary{list-style:none;display:flex;align-items:center;justify-content:space-between;min-height:48px;border-top:1px solid var(--trait-scene);cursor:pointer}
.pied-col summary::-webkit-details-marker{display:none}
.pied-col summary::after{content:"";width:8px;height:8px;margin-right:6px;border:solid var(--texte-scene-doux);border-width:0 2px 2px 0;transform:translateY(-3px) rotate(45deg);transition:transform var(--d-1) var(--courbe-sortie)}
.pied-col[open] summary::after{transform:translateY(2px) rotate(-135deg)}
.pied h2{font:700 var(--t-micro)/1.3 var(--f-texte);letter-spacing:.08em;text-transform:uppercase;color:var(--texte-scene-doux)}
.pied-sous{font:700 var(--t-micro)/1.3 var(--f-texte);letter-spacing:.08em;text-transform:uppercase;color:var(--texte-scene-doux);margin:8px 0 4px}
.pied ul{list-style:none;padding:0 0 12px;margin:0}
.pied ul a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;overflow-wrap:anywhere;color:var(--texte-scene)}
.pied ul a:hover{color:var(--menthe);text-decoration:underline}
.pied ul a.tous{font-weight:700;color:var(--blanc)}
@media (min-width:760px){
  .pied-col summary{min-height:0;border-top:0;cursor:default;padding-bottom:8px}
  .pied-col summary::after{display:none}
  .pied ul{padding:0}
  .pied ul a{min-height:26px;line-height:1.3;padding-block:2px}
}
.pied-bas{margin-top:24px;padding-top:12px;border-top:1px solid var(--trait-scene);display:flex;flex-wrap:wrap;align-items:center;gap:0 20px;color:var(--texte-scene-doux)}
.pied-bas a,.pied-bas span,.pied-cookies{display:inline-flex;align-items:center;min-height:44px}
.pied-bas a{color:var(--texte-scene);text-decoration:none}
.pied-bas a:hover{color:var(--menthe);text-decoration:underline}
.pied-langues{gap:20px}
.pied-langue-active{color:var(--blanc);font-weight:700}
@media (min-width:1000px){.pied-langues{margin-left:auto}}
/* Sur téléphone (tour 2, défaut 2) : le bouton du pied double la case vide juste au-dessus
   et la colonne OnClub (« Demander une démo ») : il n'est dessiné qu'à partir de 760 px.
   Les liens légaux, plus serrés, tiennent sur moins de lignes. */
@media (max-width:759px){
  .pied-demo{display:none}
  .pied-marque{flex-direction:row;flex-wrap:wrap;align-items:center;column-gap:16px}
  .pied-accroche{font-size:1.125rem}
  .pied-bas{gap:0 14px;font-size:.875rem}
}
@media (min-width:760px){.pied-bas{margin-top:24px}.pied-bas a,.pied-bas span,.pied-cookies{min-height:36px}}
.pied-cookies{background:none;border:0;color:var(--texte-scene);font:inherit;padding:0;text-decoration:underline;cursor:pointer}
</style>
