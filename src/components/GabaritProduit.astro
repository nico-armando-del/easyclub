---
/*
  LE GABARIT DES PAGES PRODUIT (maquettes §B.3) : fonctionnalités, sports,
  activités, profils, comparatifs. Ordre imposé :
    1. le héros [data-heros] : fil, surtitre, h1, chapô, UN bouton (+ « Dès
       {offre} » et « Voir les offres » sur une fonctionnalité) ;
         - fonctionnalité, profil : l'écran de TÉLÉPHONE en grand dans un panneau
           menthe ; un écran de BUREAU (fenêtre) sort du héros et se pose en
           pleine largeur sous la ligne du temps, à une échelle lisible (tour 2) ;
         - sport : la photo pleine largeur, texte sur un voile ≥ 70 % ;
         - activité : héros scindé, la photo à droite ;
         - comparatif, et les pages de PAGES_VITRINE : texte seul ;
    2. la ligne du temps (LigneTemps : une ligne forte ou des pastilles, le
       calcul replié) ;
    3. le visuel, s'il n'est pas dans le héros (l'écran dans un Cadre, ou la
       vitrine des sites de club sur les pages de PAGES_VITRINE) ;
    4. le texte MDX, en sections d'une idée (.prose-produit) ;
    5. les sources, 6. la FAQ, 7. « Pour aller plus loin » (rangée),
    8. la case vide compacte.
  Aucune étiquette « Exemple » : une ligne « Noms et montants fictifs. »
  RÈGLE « PAS DE PAGE DE TEXTE SEUL » : voir plus bas.
*/
import { render } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import FilAriane from './FilAriane.astro'
import BlocTemps from './BlocTemps.astro'
import EcranAnime from './EcranAnime.astro'
import EcranFonction from './EcranFonction.astro'
import Faq from './Faq.astro'
import VoirAussi from './VoirAussi.astro'
import CaseVide from './CaseVide.astro'
import Encadre from './Encadre.astro'
import TuileFonction from './TuileFonction.astro'
import Calculateur from './Calculateur.astro'
import MiniEcran from './MiniEcran.astro'
import Photo from './Photo.astro'
import Repli from './Repli.astro'
import Idee from './Idee.astro'
import Cadre from './Cadre.astro'
import LigneTemps from './LigneTemps.astro'
import VitrineClubs from './VitrineClubs.astro'
import FriseSaison from './FriseSaison.astro'
import { photoDe } from '../data/photos'
import { PAGES_VITRINE } from '../data/clubs'
import { HUB, ETIQUETTE, url, type NomCollection } from '../lib/collections'
import { NOM_OFFRE } from '../data/site'
import { lireEcranFonction } from '../lib/ecransFonction'

interface Props { collection: Exclude<NomCollection, 'guides' | 'articles'>; entree: any }
const { collection, entree } = Astro.props
const d = entree.data
const { Content, headings } = await render(entree)
const chemin = url(collection, entree.id)
const fil = [HUB[collection], { nom: d.nom, url: chemin }]

/*
  RÈGLE « PAS DE PAGE DE TEXTE SEUL » : une fonctionnalité, un sport, une
  activité ou un profil montre au moins un écran. Sans champ `ecran`, une
  fonctionnalité prend l'écran de sa famille ; les autres doivent déclarer
  `ecran` ou poser <EcranAnime> ou <MiniEcran> dans le texte, sinon le build s'arrête.

  L'ÉCRAN DE LA FONCTIONNALITÉ (champ `ecranFonction`) passe avant tout le reste :
  l'écran fixe de src/ecrans/fonctions/<nom>.html, au même endroit et au même format
  qu'un écran animé (téléphone dans le héros, fenêtre de bureau sous la ligne du temps).
  L'écran de famille n'est qu'un repli, en attendant l'écran propre à la page.
*/
const ECRAN_FAMILLE: Record<string, string> = { Inscrire: 'inscription', Encaisser: 'relance', Organiser: 'terrain', Communiquer: 'site', Vendre: 'boutique', Piloter: 'relance' }
const nomFonction: string | undefined = d.ecranFonction === true ? entree.id : d.ecranFonction
const ecranFonction = nomFonction ? lireEcranFonction(nomFonction) : undefined
const ecran: string | undefined = ecranFonction ? undefined : d.ecran ?? (collection === 'fonctionnalites' ? ECRAN_FAMILLE[d.famille] : undefined)
if (['fonctionnalites', 'sports', 'activites', 'profils'].includes(collection) && !ecranFonction && !ecran && !/<(EcranAnime|EcranFonction|MiniEcran)\b/.test(entree.body ?? '')) {
  throw new Error(`${collection}/${entree.id} : ajoutez un écran (champ « ecranFonction » ou « ecran », <EcranFonction>, <EcranAnime> ou <MiniEcran> dans le texte). Voir REDIGER.md.`)
}

const vitrine = collection === 'fonctionnalites' && PAGES_VITRINE.includes(entree.id)
const TELEPHONES = ['inscription', 'terrain', 'boutique']
const formeEcran = (nom?: string) => (nom && TELEPHONES.includes(nom) ? 'telephone' : 'fenetre')
/* La forme du visuel principal : celle que déclare l'écran de la fonctionnalité, sinon celle de l'écran animé. */
const forme = ecranFonction ? ecranFonction.forme : formeEcran(ecran)
const photo = (collection === 'sports' || collection === 'activites') && photoDe(entree.id) ? entree.id : undefined
type Heros = 'panneau' | 'sport' | 'activite' | 'vitrine' | 'seul'
const heros: Heros = vitrine ? 'vitrine'
  : collection === 'comparatifs'
  ? 'seul'
  : collection === 'sports' && photo ? 'sport'
  : collection === 'activites' && photo ? 'activite'
  : ecranFonction || (ecran && forme === 'telephone') ? 'panneau' : 'seul'
/* L'écran propre à la fonctionnalité va TOUJOURS dans le héros (test des 5 secondes), qu'il soit
   téléphone ou fenêtre : téléphone en grand, fenêtre de bureau recadrée à droite (dès 1000 px) ;
   sous 1000 px, juste sous le chapô. Un écran animé de bureau reste après la ligne du temps. */
const auCorps = !vitrine && heros !== 'panneau' && Boolean(ecranFonction || ecran)
const ecranCorps = auCorps ? ecran : undefined
const fonctionCorps = auCorps ? ecranFonction : undefined
/* Un écran de bureau se montre en pleine largeur, jamais réduit à 6 px dans une colonne. */
const ecranLarge = auCorps && forme === 'fenetre'

const surtitre = collection === 'fonctionnalites' ? `${d.famille} · ${ETIQUETTE[collection]}` : ETIQUETTE[collection]
const offre = collection === 'fonctionnalites' ? NOM_OFFRE[d.offre as 'mini' | 'pro' | 'max'] : undefined
/* L'écran « terrain » (src/ecrans/, gelé) montre une compo de VOLLEY : le décor et le libellé
   « du samedi » sont réservés à la page du même sport, jamais au football ni au handball. */
const SPORT_DE_L_ECRAN: Record<string, string> = { terrain: 'volley' }
const ecranDuSport = collection === 'sports' && !!ecranCorps && SPORT_DE_L_ECRAN[ecranCorps] === entree.id
const lienEcran = auCorps ? { texte: ecranDuSport ? 'Voir l’écran du samedi' : 'Voir l’écran', href: '#ecran' } : undefined

/* La fin de page : la phrase du récit pour quelques pages, sinon le titre par défaut de la case vide. */
const FIN_DE_PAGE: Record<string, string> = {
  'sports/football': 'Le samedi au bord du terrain, sans le classeur',
  'activites/theatre': 'La répétition du jeudi, sans les papiers',
}
/* P2, page sport : la frise de la saison, tirée des h2 du texte (rien si moins de 4 étapes trouvées). */
const ETAPES: [string, RegExp][] = [['Mai', /\bmai\b/i], ['Septembre', /inscription/i], ['Octobre', /cotisation/i], ['Licences', /licence/i], ['Samedi', /convocation|match/i], ['Vacances', /vacances|maillot/i]]
const prises = new Set<string>()
const etapesFrise = collection === 'sports'
  ? ETAPES.flatMap(([nom, motif]) => {
      const h = headings.find((t) => t.depth === 2 && !prises.has(t.slug) && motif.test(t.text))
      if (!h) return []
      prises.add(h.slug)
      return [{ ancre: h.slug, nom }]
    })
  : []
const frise = etapesFrise.length >= 4 ? etapesFrise : []
/* P2 : sur une page sport, l'écran du samedi se joue sur fond encre, devant la photo du terrain. */
const samedi = ecranDuSport && ecranCorps === 'terrain' && photoDe('terrain')
const titreFin = FIN_DE_PAGE[`${collection}/${entree.id}`]
/* Dès 1000 px, l'écran du corps se tient à droite du texte (collant) au lieu d'un bloc pleine
   largeur au-dessus : sauf si le texte porte déjà ses propres écrans (Idee). */
const duo = auCorps && !ecranLarge && !/<Idee\b/.test(entree.body ?? '')
const date = (x: Date) => x.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const composants = { BlocTemps, EcranAnime, EcranFonction, Encadre, TuileFonction, Calculateur, MiniEcran, Photo, Repli, Idee, Cadre }
const btnClasse = heros === 'sport' ? 'btn btn-menthe' : 'btn btn-encre'
---
<Layout titre={d.titreSeo} description={d.description} chemin={chemin} fil={fil} faq={d.faq}>
  <section class:list={['gp-heros', `gp-heros-${heros}`, heros === 'panneau' && `gp-heros-${forme}`, heros === 'sport' && 'sur-encre']} data-heros>
    {heros === 'sport' && <div class="gp-photo-pleine"><Photo nom={photo!} tete priorite tailles="100vw" /></div>}
    {heros === 'activite' && <div class="gp-photo-scindee"><Photo nom={photo!} tete priorite tailles="(min-width: 1000px) 50vw, 100vw" /></div>}
    <div class="enveloppe gp-heros-grille">
      <div class="gp-heros-texte">
        <FilAriane fil={fil} />
        <p class="surtitre">{surtitre}</p>
        <h1>{d.titre}</h1>
        <p class="chapo">{d.chapo}</p>
        {offre && <p class="gp-offre"><span class="pastille-offre">Dès {offre}</span> <a href="/tarifs">Voir les offres</a></p>}
        <div class="gp-actions">
          <a class={btnClasse} href="/demo">Demander une démo</a>
          {lienEcran && <a class="lien-fleche" href={lienEcran.href}>{lienEcran.texte} <svg aria-hidden="true"><use href="#fleche" /></svg></a>}
        </div>
      </div>
      {heros === 'vitrine' && <div class="gp-vitrine"><VitrineClubs variante="page" /></div>}
      {heros === 'panneau' && (
        <figure class:list={['gp-panneau', `gp-ecran-${forme}`]}>
          {ecranFonction ? <EcranFonction nom={ecranFonction.nom} nu /> : <EcranAnime nom={ecran!} />}
          <figcaption>Noms et montants fictifs.</figcaption>
        </figure>
      )}
    </div>
  </section>

  <div class="enveloppe gp-temps">
    {'cles' in d.temps ? <LigneTemps cles={d.temps.cles} titre={d.temps.titre} /> : <LigneTemps geste={d.temps.geste} />}
  </div>

  <div class="enveloppe gp-corps">
    {frise.length > 0 && <FriseSaison etapes={frise} />}
    <div class:list={['gp-bloc', duo && 'gp-duo']}>
      {fonctionCorps && (
        <section class:list={['gp-visuel', `gp-ecran-${forme}`, ecranLarge && 'gp-large']} id="ecran" aria-label="L’écran d’OnClub">
          <Cadre type="panneau" fond="menthe" legende="Noms et montants fictifs."><EcranFonction nom={fonctionCorps.nom} nu /></Cadre>
        </section>
      )}
      {ecranCorps && (samedi ? (
        <section class="gp-visuel gp-samedi sur-encre" id="ecran" aria-label="L’écran du samedi">
          <div class="gp-samedi-photo"><Photo nom="terrain" tailles="(min-width: 1000px) 980px, 100vw" /></div>
          <figure class="gp-samedi-ecran"><EcranAnime nom={ecranCorps} sombre /><figcaption>Noms et montants fictifs.</figcaption></figure>
        </section>
      ) : (
        <section class:list={['gp-visuel', `gp-ecran-${forme}`, ecranLarge && 'gp-large']} id="ecran" aria-label="L’écran d’OnClub">
          <Cadre type="panneau" fond="menthe" legende="Noms et montants fictifs."><EcranAnime nom={ecranCorps} /></Cadre>
        </section>
      ))}
      <article class:list={['prose', 'prose-produit', !duo && 'prose-grille']} data-contenu>
        <Content components={composants} />
      </article>
    </div>
    {d.sources?.length > 0 && (
      <aside class="gp-sources" aria-labelledby="sources-titre">
        <h2 id="sources-titre">Sources</h2>
        <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.titre}</a>, consulté le {date(new Date(s.consulte))}</li>)}</ul>
      </aside>
    )}
    {d.faq?.length > 0 && <Faq items={d.faq} disposition="deux-colonnes" />}
    <VoirAussi collection={collection} id={entree.id} variante="rangee" />
  </div>
  <CaseVide compact titre={titreFin} />
</Layout>

<style>
/* ===== 1. Le héros ===== */
.gp-heros{position:relative;padding-block:8px var(--e-7,48px)}
.gp-heros-texte{min-width:0}
.gp-heros .surtitre{margin-top:16px}
.gp-heros h1{font-size:var(--t-h1-produit,clamp(2.25rem,1.6rem + 2.2vw,3.25rem));line-height:1.08;max-width:22ch;text-wrap:balance}
.gp-heros .chapo{margin-top:20px}
.gp-offre{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;margin-top:20px;font-size:var(--t-petit,.9375rem)}
.gp-offre a{display:inline-flex;align-items:center;min-height:44px;font-weight:700}
.gp-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin-top:24px}
@media (max-width:759px){.gp-actions .btn{width:100%}}

/* Le panneau menthe : l'écran de téléphone en grand, posé directement sur l'aplat.
   Un seul cadre (l'appareil) : la carte claire de l'écran est neutralisée (tour 2, défaut 3). */
.gp-heros-grille{display:grid;gap:var(--e-6,32px)}
.gp-panneau{position:relative;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;border-radius:var(--r-panneau,24px);background:var(--menthe);overflow:hidden}
.gp-panneau :global(.ecran-anime){width:100%}
.gp-panneau :global(.ecran-fonction){width:100%}
/* L'écran fixe d'un téléphone (300 px) : réduit pour tenir dans le panneau d'un petit téléphone. */
@media (max-width:419px){.gp-panneau :global(.ef-tel){zoom:.88}}
/* Sous 1000 px, l'écran monte juste sous le chapô : le bouton et l'offre passent dessous
   (le bouton « Demander une démo » reste fixe en bas de l'écran du téléphone). */
@media (max-width:999px){
  .gp-heros-panneau .gp-heros-texte{display:contents}
  .gp-heros-panneau .gp-heros-grille{row-gap:0}
  .gp-heros-panneau .gp-panneau{order:2;margin-top:24px}
  .gp-heros-panneau .gp-offre,.gp-heros-panneau .gp-actions{order:3}
  .gp-ecran-fenetre.gp-panneau{padding:16px 12px}
}
.gp-panneau :global(.eci-scene){background:none;border:0;--s:1.08}
.gp-panneau figcaption{margin-top:12px;font-size:var(--t-micro,.8125rem);text-align:center;color:var(--encre)}
.gp-ecran-telephone :global(.ecran-anime){zoom:.68}
@media (min-width:760px){.gp-ecran-telephone :global(.ecran-anime){zoom:.74}}
@media (min-width:1000px){
  .gp-heros{padding-block:8px var(--e-7,48px)}
  .gp-heros-panneau .gp-heros-grille{grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:var(--col-gap,24px);align-items:center}
  .gp-panneau{border-radius:var(--r-xl,40px)}
  .gp-ecran-telephone :global(.ecran-anime){zoom:.78}
  /* La fenêtre de bureau dans le héros : texte à gauche (5/12), la fenêtre à droite, à l'échelle .8,
     le panneau va jusqu'au bord de l'écran et la recadre à droite (comme la photo d'une activité). */
  .gp-heros-fenetre{overflow-x:clip}
  .gp-heros-fenetre .gp-heros-grille{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
  .gp-heros-fenetre h1{font-size:clamp(2.125rem,1.2rem + 1.6vw,2.75rem)}
  .gp-heros-fenetre .gp-panneau{align-items:flex-start;justify-content:flex-start;margin-right:calc(-1 * (var(--g) + max(0px,(100vw - var(--max)) / 2)));padding:32px 0 20px 32px;border-radius:var(--r-xl,40px) 0 0 var(--r-xl,40px)}
  .gp-heros-fenetre .gp-panneau :global(.ecran-fonction){flex:none;width:860px;zoom:.68}
  .gp-heros-fenetre .gp-panneau figcaption{align-self:stretch;padding-right:32px}
}
@media (min-width:1200px){.gp-heros-fenetre .gp-panneau :global(.ecran-fonction){zoom:.8}}


/* Le sport : la photo pleine largeur, le texte sur le voile (≥ 70 % encre sous tout le texte). */
.gp-heros-sport{background:var(--encre);color:var(--blanc);padding:0}
.gp-heros-sport .gp-heros-grille{position:relative;z-index:1;padding-block:8px var(--e-7,48px)}
.gp-photo-pleine{position:relative;aspect-ratio:16/11;overflow:hidden}
.gp-photo-pleine::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(11,15,20,1) 0,rgba(11,15,20,.6) 40%,rgba(11,15,20,.1) 100%)}
.gp-photo-pleine :global(.photo){width:100%;height:100%;aspect-ratio:auto;object-fit:cover;object-position:50% 40%;border-radius:0}
.gp-heros-sport .chapo{color:var(--texte-scene,#D7DBE1)}
.gp-heros-sport .surtitre{color:var(--menthe)}
.gp-heros-sport .gp-heros-texte{max-width:760px}
@media (min-width:760px){
  .gp-heros-sport{display:flex;align-items:flex-end;min-height:min(520px,66svh)}
  .gp-heros-sport .gp-heros-grille{width:100%;padding-block:72px var(--e-7,48px)}
  .gp-photo-pleine{position:absolute;inset:0;aspect-ratio:auto}
  /* Le voile descend du texte (bas, dense) vers la photo (haut, claire) : la photo de sport se voit (tour 2, défaut 48). */
  .gp-photo-pleine::after{background:linear-gradient(to top,rgba(11,15,20,.92) 0,rgba(11,15,20,.8) 45%,rgba(11,15,20,.58) 70%,rgba(11,15,20,.2) 100%)}
}

/* L'activité : héros scindé, la photo à droite jusqu'au bord de l'écran. */
.gp-photo-scindee{aspect-ratio:16/10;overflow:hidden}
.gp-photo-scindee :global(.photo){width:100%;height:100%;aspect-ratio:auto;object-fit:cover;border-radius:0}
@media (max-width:999px){.gp-heros-activite{padding-top:0}.gp-heros-activite .gp-heros-grille{padding-top:8px}}
@media (min-width:1000px){
  .gp-heros-activite{min-height:500px;display:flex;align-items:center;padding-block:var(--e-5,24px) var(--e-7,48px)}
  .gp-heros-activite .gp-heros-grille{width:100%}
  .gp-heros-activite .gp-heros-texte{max-width:calc(50% - 32px)}
  .gp-photo-scindee{position:absolute;top:var(--e-5,24px);bottom:var(--e-7,48px);left:calc(50% + 12px);right:0;aspect-ratio:auto;border-radius:var(--r-xl,40px) 0 0 var(--r-xl,40px)}
}

/* Site de l'association : la vitrine des clubs de démonstration monte dans le héros,
   à droite dès 1000 px (« montrer nos exemples » sans défiler), juste sous le bouton sur téléphone. */
.gp-vitrine{min-width:0}
@media (min-width:1000px){
  .gp-heros-vitrine .gp-heros-grille{grid-template-columns:minmax(0,6fr) minmax(0,6fr);column-gap:var(--e-7,48px);align-items:start}
  /* Le haut des onglets se cale sur le surtitre (le fil d'Ariane fait ≈ 44 px), jamais au ras de l'en-tête. */
  .gp-vitrine{margin-top:56px}
}
/* Comparatif : texte seul, col 1 à 9. */
.gp-heros-seul .gp-heros-texte{max-width:860px}

/* ===== 2. La ligne du temps ===== */
.gp-temps{margin-top:0}

/* ===== 3 à 7. Le corps ===== */
.gp-corps{display:grid;gap:var(--e-7,48px);padding-block:var(--e-7,48px) var(--section)}
/* :global : les racines de composants (frise, « Pour aller plus loin ») n'ont pas l'attribut de portée ;
   sans min-width:0, leur rangée défilante élargit la grille au-delà de l'écran. */
.gp-corps>:global(*){min-width:0}
.gp-visuel{max-width:980px;width:100%;scroll-margin-top:calc(var(--entete-h,60px) + 16px)}
.gp-visuel :global(.ecran-anime){width:100%}
.gp-visuel :global(.eci-scene),.gp-samedi :global(.eci-scene){background:none;border:0}
.gp-visuel :global(.r-fond){background:none;padding:0}
/* L'écran de bureau en grand : toute la largeur, à l'échelle 1 dès 1000 px (texte ≥ 11 px). */
.gp-large{max-width:none}
.gp-visuel.gp-ecran-telephone :global(.ecran-anime){zoom:.7}
.gp-visuel.gp-ecran-fenetre :global(.ecran-anime){zoom:.6}
@media (min-width:760px){.gp-visuel.gp-ecran-telephone :global(.ecran-anime){zoom:.85}.gp-visuel.gp-ecran-fenetre :global(.ecran-anime){zoom:.85}}
@media (min-width:1000px){.gp-visuel.gp-large :global(.ecran-anime){zoom:1}}
.gp-sources h2{font-size:1.5rem}
.gp-sources ul{margin-top:12px;padding-left:1.2em;font-size:.9375rem;color:var(--gris)}
.gp-sources li+li{margin-top:6px}
.gp-sources a{font-weight:600;color:var(--encre)}

/* P2 : l'écran du samedi, sur fond encre devant la photo du terrain (le seul moment sombre de la page). */
.gp-samedi{position:relative;display:grid;place-items:center;padding:var(--e-7,48px) 16px;border-radius:var(--r-panneau,24px);background:var(--encre);overflow:hidden;isolation:isolate}
.gp-samedi-photo{position:absolute;inset:0;z-index:-1}
.gp-samedi-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(11,15,20,.55),rgba(11,15,20,.85))}
.gp-samedi-photo :global(.photo){width:100%;height:100%;aspect-ratio:auto;object-fit:cover;border-radius:0}
.gp-samedi-ecran{margin:0;width:100%;max-width:300px}
.gp-samedi-ecran :global(.ecran-anime){zoom:.9}
.gp-samedi-ecran figcaption{margin-top:12px;font-size:var(--t-micro,.8125rem);text-align:center;color:var(--texte-scene-doux,#AEB4BE)}
@media (min-width:760px){.gp-samedi{padding-block:var(--e-8,64px)}.gp-samedi-ecran :global(.ecran-anime){zoom:1}}

/* ===== 4. La prose « une idée par section » ===== */
.prose-produit{max-width:980px}
.prose-produit>:global(h2){margin-top:var(--e-7,48px);padding-top:var(--e-5,24px);border-top:1px solid var(--trait);font-size:clamp(1.75rem,1.3rem + 1.6vw,2.5rem);line-height:1.1;letter-spacing:-.015em}
