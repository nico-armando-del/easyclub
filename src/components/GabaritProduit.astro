@media (min-width:1000px){.prose-produit>:global(h2){margin-top:var(--e-9,96px)}}
/* Dès 1000 px, chaque section se lit sur deux colonnes : l'intertitre à gauche (col 1-5),
   le texte, les replis et les listes à droite (col 6-12) ; les visuels prennent toute la
   largeur. La première ligne du texte s'aligne sur l'intertitre, et le filet de section
   court sur les deux colonnes. Plus de demi-page vide à droite d'une colonne étroite. */
@media (min-width:1000px){
  .prose-grille{max-width:none;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:0;align-items:start}
  .prose-grille>:global(*){grid-column:6/-1;min-width:0}
  .prose-grille>:global(h2){grid-column:1/6;padding-right:var(--e-7,48px);max-width:none;margin-top:var(--e-7,48px);font-size:clamp(1.625rem,1rem + 1.2vw,2.125rem)}
  .prose-grille>:global(h2+:is(p,ul,ol,h3,blockquote,.repli,.encadre,.bloc-temps)){margin-top:var(--e-7,48px);padding-top:var(--e-6,32px);border-top:1px solid var(--trait)}
  /* Le filet court jusqu'au bout de la colonne 6-12 ; le texte garde sa mesure (tour 2, défauts 4 et 45). */
  .prose-grille>:global(h2+*){max-width:none;padding-right:max(0px,calc(100% - var(--lecture)))}
  .prose-grille>:global(h2+.repli){padding-right:0}
  .prose-grille>:global(.repli){max-width:none}
  .prose-grille>:global(h2:first-child+*){margin-top:0;padding-top:0;border-top:0}
  .prose-grille>:global(:is(.ecran-anime,.cadre,.idee,.photo,figure:not(.mini-ecran),table)){grid-column:1/-1;max-width:none}
  /* Un second écran de téléphone se tient dans la colonne du texte (6-12), pas au milieu de la page. */
  .prose-grille>:global(figure.ecran-fonction.ef-telephone){grid-column:6/-1}
  /* Un intertitre suivi d'une section à visuel (Idee) prend toute la largeur : jamais d'intertitre seul à gauche d'un vide. */
  .prose-grille>:global(h2:has(+ .idee)){grid-column:1/-1}
  .prose-grille>:global(div.idee){margin-block:var(--e-5,24px)}
  .prose-grille>:global(table){display:table;max-width:980px;margin-inline:auto}
}
