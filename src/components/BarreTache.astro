---
/*
  LA BARRE D'UNE TÂCHE, sous un h3 d'article (« Recopier les fiches : 25 heures ») — maquettes §B.5.
  Une seule ligne : deux pistes de 6 px (aujourd'hui en --trait ; avec OnClub en menthe sur --papier-2)
  et les libellés « Aujourd'hui 25 h · Avec OnClub 0 h ». Chiffres de src/data/temps.ts seulement.
  Usage MDX : <BarreTache cle="fiches" />
*/
import { TACHES, duree, type CleTemps } from '../data/temps'
import { i18n } from '../i18n/ui'

interface Props { cle: CleTemps }
const { cle } = Astro.props
const { t: tr, langue } = i18n(Astro.url)
const t = TACHES[cle]
if (!t) throw new Error(`BarreTache : clé de temps inconnue « ${cle} » (voir src/data/temps.ts).`)
const avant = t.avantMin
const apres = t.apresMin
const pct = (m: number, max: number) => `${Math.max(1.5, (m / max) * 100).toFixed(1)}%`
---
<div class="barre-tache">
  {avant !== null && apres !== null ? (
    <>
      <span class="bta-pistes" aria-hidden="true">
        <span class="bta-piste bta-avant"><i style="width:100%"></i></span>
        <span class="bta-piste bta-apres"><i style={`width:${pct(apres, avant)}`}></i></span>
      </span>
      <span class="bta-lib">{tr('Aujourd’hui')} <b>{duree(avant, langue)}</b> · {tr('Avec OnClub')} <b>{duree(apres, langue)}</b></span>
    </>
  ) : (
    <>
      <span class="bta-pistes" aria-hidden="true"><span class="bta-piste bta-apres"><i style="width:100%"></i></span></span>
      <span class="bta-lib">{tr('Rendues')} <b>{duree(t.gainMin, langue)}</b> {tr('par saison')}</span>
    </>
  )}
</div>
<style>
.barre-tache{display:grid;gap:6px;max-width:var(--lecture-article,33em)}
/* Les pistes ont toutes la même longueur (toute la colonne) : les barres se comparent d'une tâche à l'autre (tour 2, défaut 15). */
.bta-pistes{display:grid;gap:4px;width:100%}
.bta-piste{display:block;height:6px;border-radius:999px;overflow:hidden}
.bta-piste i{display:block;height:100%;border-radius:inherit}
.bta-avant i{background:var(--trait)}
.bta-apres{background:var(--papier-2,#EDE8DC)}
.bta-apres i{background:var(--menthe)}
.bta-lib{flex:none;font-size:var(--t-micro,.8125rem);line-height:1.4;color:var(--gris)}
.bta-lib b{color:var(--encre);font-weight:700}
</style>
