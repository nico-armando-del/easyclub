---
/* Une photo du site (src/data/photos.ts) : deux tailles, 3:2, chargée tard sauf en tête de page. */
import { photoDe, srcset } from '../data/photos'
interface Props { nom: string; tailles?: string; tete?: boolean; class?: string }
const { nom, tailles = '(min-width: 900px) 560px, 100vw', tete = false, class: classe } = Astro.props
const p = photoDe(nom)
---
{p && (
  <img
    class:list={['photo', classe]}
    src={`/img/photos/${p.fichier}-640.webp`}
    srcset={srcset(p)}
    sizes={tailles}
    width="1280"
    height="853"
    alt={p.alt}
    loading={tete ? 'eager' : 'lazy'}
    fetchpriority={tete ? 'high' : undefined}
    decoding="async"
  />
)}
<style>
.photo{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:var(--r-m);background:var(--menthe-pale)}
</style>
