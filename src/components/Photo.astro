---
/*
  Une photo du site (src/data/photos.ts) : deux tailles, 3:2 par défaut, chargée tard sauf en tête de page.
  `ratio` recadre (ex. "4/5" pour une carte portrait, "16/9" pour un bandeau) ; `priorite`
  (ou l'ancien `tete`) la charge tout de suite avec fetchpriority=high : la photo du héros.
*/
import { photoDe, srcset } from '../data/photos'
interface Props { nom: string; tailles?: string; tete?: boolean; priorite?: boolean; ratio?: string; class?: string }
const { nom, tailles = '(min-width: 900px) 560px, 100vw', tete = false, priorite = false, ratio, class: classe } = Astro.props
const p = photoDe(nom)
const vite = tete || priorite
---
{p && (
  <img
    class:list={['photo', classe]}
    src={`/img/photos/${p.fichier}-640.webp`}
    srcset={srcset(p)}
    sizes={tailles}
    width="1280"
    height="853"
    alt={p.alt}
    loading={vite ? 'eager' : 'lazy'}
    fetchpriority={vite ? 'high' : undefined}
    decoding={vite ? 'sync' : 'async'}
    style={ratio ? `aspect-ratio:${ratio}` : undefined}
  />
)}
<style>
.photo{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:var(--r-m);background:var(--menthe-pale)}
</style>
