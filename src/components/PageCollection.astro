---
/*
  L'AIGUILLAGE DES PAGES DE COLLECTION (maquettes §C.2) :
    guides, articles            → GabaritEditorial (lot D) ;
    fonctionnalités, sports,
    activités, profils,
    comparatifs                 → GabaritProduit.
  Les routes peuvent importer directement le gabarit qui leur revient ; cet
  aiguillage reste pour la compatibilité (même props : collection, entree).
*/
import GabaritProduit from './GabaritProduit.astro'
import GabaritEditorial from './GabaritEditorial.astro'
import type { NomCollection } from '../lib/collections'

interface Props { collection: NomCollection; entree: any }
const { collection, entree } = Astro.props
---
{collection === 'guides' || collection === 'articles'
  ? <GabaritEditorial collection={collection} entree={entree} />
  : <GabaritProduit collection={collection} entree={entree} />}
